          "query": "mutation CreateAndroidBuild($appId: ID!, $job: AndroidJobInput!, $metadata: BuildMetadataInput, $buildParams: BuildParamsInput) { build { createAndroidBuild(appId: $appId, job: $job, metadata: $metadata, buildParams: $buildParams) { build { id status platform createdAt completedAt buildProfile appIdentifier appVersion appBuildVersion gitCommitHash message error { errorCode message docsUrl } artifacts { buildUrl applicationArchiveUrl buildArtifactsUrl xcodeBuildLogsUrl } logFiles } deprecationInfo { type message } } } }"
