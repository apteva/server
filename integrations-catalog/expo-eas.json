{
  "slug": "expo-eas",
  "name": "Expo EAS",
  "description": "Manage Expo EAS projects, Android/iOS build jobs, artifacts, and Git-backed EAS Workflows through the GraphQL API used by the official EAS CLI. Direct native-build jobs require an already prepared project archive and signing inputs; this integration does not run local prebuild, resolve eas.json, or package source files. Use a configured EAS Workflow for repository-based builds.",
  "logo": "https://www.google.com/s2/favicons?domain=expo.dev&sz=128",
  "categories": [
    "development",
    "ci",
    "cd",
    "mobile",
    "ios",
    "builds"
  ],
  "base_url": "https://api.expo.dev",
  "auth": {
    "types": [
      "bearer"
    ],
    "headers": {
      "Authorization": "Bearer {{token}}",
      "Content-Type": "application/json",
      "Accept": "application/json"
    },
    "credential_fields": [
      {
        "name": "token",
        "label": "API Token",
        "type": "password",
        "required": true,
        "description": "Create an Expo personal access token at expo.dev/accounts/<account>/settings/access-tokens, or use an organization robot token. Use the same token as EXPO_TOKEN in EAS CLI."
      }
    ]
  },
  "tools": [
    {
      "name": "get_current_user",
      "description": "Verify the token and identify the current user or robot actor.",
      "method": "POST",
      "path": "/graphql",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "request_transform": {
        "type": "json_wrap",
        "fields": [],
        "constants": {
          "query": "query CurrentActor { meActor { __typename id } }"
        }
      },
      "response_error": {
        "type": "graphql",
        "paths": [
          "errors"
        ]
      },
      "response_path": "data.meActor"
    },
    {
      "name": "get_project",
      "description": "Get an existing Expo project by its EAS project UUID.",
      "method": "POST",
      "path": "/graphql",
      "input_schema": {
        "type": "object",
        "properties": {
          "appId": {
            "type": "string",
            "description": "extra.eas.projectId in Expo app config."
          }
        },
        "required": [
          "appId"
        ],
        "additionalProperties": false
      },
      "request_transform": {
        "type": "json_wrap",
        "fields": [],
        "constants": {
          "query": "query ProjectById($appId: String!) { app { byId(appId: $appId) { id name slug ownerAccount { id name } } } }"
        },
        "include_fields": {
          "appId": "variables.appId"
        }
      },
      "response_error": {
        "type": "graphql",
        "paths": [
          "errors"
        ]
      },
      "response_path": "data.app.byId"
    },
    {
      "name": "get_project_by_name",
      "description": "Resolve an Expo project UUID from its full @owner/slug name.",
      "method": "POST",
      "path": "/graphql",
      "input_schema": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "description": "For example @acme/my-app."
          }
        },
        "required": [
          "fullName"
        ],
        "additionalProperties": false
      },
      "request_transform": {
        "type": "json_wrap",
        "fields": [],
        "constants": {
          "query": "query ProjectByName($fullName: String!) { app { byFullName(fullName: $fullName) { id name slug ownerAccount { id name } } } }"
        },
        "include_fields": {
          "fullName": "variables.fullName"
        }
      },
      "response_error": {
        "type": "graphql",
        "paths": [
          "errors"
        ]
      },
      "response_path": "data.app.byFullName"
    },
    {
      "name": "list_builds",
      "description": "List project builds. Supply limit and offset explicitly; filter by platform, status, or build profile.",
      "method": "POST",
      "path": "/graphql",
      "input_schema": {
        "type": "object",
        "properties": {
          "appId": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "filter": {
            "type": "object",
            "properties": {
              "appBuildVersion": {
                "type": "string"
              },
              "appIdentifier": {
                "type": "string"
              },
              "appVersion": {
                "type": "string"
              },
              "buildProfile": {
                "type": "string"
              },
              "channel": {
                "type": "string"
              },
              "developmentClient": {
                "type": "boolean"
              },
              "distribution": {
                "type": "string",
                "enum": [
                  "INTERNAL",
                  "SIMULATOR",
                  "STORE"
                ]
              },
              "fingerprintHash": {
                "type": "string"
              },
              "gitCommitHash": {
                "type": "string"
              },
              "hasFingerprint": {
                "type": "boolean"
              },
              "platform": {
                "type": "string",
                "enum": [
                  "ANDROID",
                  "IOS"
                ]
              },
              "runtimeVersion": {
                "type": "string"
              },
              "sdkVersion": {
                "type": "string"
              },
              "simulator": {
                "type": "boolean"
              },
              "status": {
                "type": "string",
                "enum": [
                  "CANCELED",
                  "ERRORED",
                  "FINISHED",
                  "IN_PROGRESS",
                  "IN_QUEUE",
                  "NEW",
                  "PENDING_CANCEL"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "appId",
          "limit",
          "offset"
        ],
        "additionalProperties": false
      },
      "request_transform": {
        "type": "json_wrap",
        "fields": [],
        "constants": {
          "query": "query ProjectBuilds($appId: String!, $limit: Int!, $offset: Int!, $filter: BuildFilter) { app { byId(appId: $appId) { builds(limit: $limit, offset: $offset, filter: $filter) { id status platform createdAt completedAt buildProfile appIdentifier appVersion appBuildVersion gitCommitHash message error { errorCode message docsUrl } artifacts { buildUrl applicationArchiveUrl buildArtifactsUrl xcodeBuildLogsUrl } logFiles } } } }"
        },
        "include_fields": {
          "appId": "variables.appId",
          "limit": "variables.limit",
          "offset": "variables.offset",
          "filter": "variables.filter"
        }
      },
      "response_error": {
        "type": "graphql",
        "paths": [
          "errors"
        ]
      },
      "response_path": "data.app.byId.builds"
    },
    {
      "name": "get_build",
      "description": "Poll a build and retrieve artifact URLs, log-file URLs, and errors. FINISHED, ERRORED, and CANCELED are terminal states.",
      "method": "POST",
      "path": "/graphql",
      "input_schema": {
        "type": "object",
        "properties": {
          "buildId": {
            "type": "string"
          }
        },
        "required": [
          "buildId"
        ],
        "additionalProperties": false
      },
      "request_transform": {
        "type": "json_wrap",
        "fields": [],
        "constants": {
          "query": "query BuildById($buildId: ID!) { builds { byId(buildId: $buildId) { id status platform createdAt completedAt buildProfile appIdentifier appVersion appBuildVersion gitCommitHash message error { errorCode message docsUrl } artifacts { buildUrl applicationArchiveUrl buildArtifactsUrl xcodeBuildLogsUrl } logFiles } } }"
        },
        "include_fields": {
          "buildId": "variables.buildId"
        }
      },
      "response_error": {
        "type": "graphql",
        "paths": [
          "errors"
        ]
      },
      "response_path": "data.builds.byId"
    },
    {
