{
  "slug": "jolpica-f1",
  "name": "Jolpica F1",
  "description": "Ergast-compatible Formula 1 schedules, results, drivers, constructors and championship standings. Public API: no key, 4 requests/second burst and 500/hour sustained across all tools. Data is CC BY-NC-SA 4.0; contact admin@jolpi.ca for commercial use. Historical coverage varies by statistic. Docs: https://github.com/jolpica/jolpica-f1",
  "logo": "https://www.google.com/s2/favicons?domain=jolpi.ca&sz=128",
  "categories": [
    "sports",
    "formula1",
    "motorsport",
    "results",
    "standings",
    "open-data"
  ],
  "base_url": "https://api.jolpi.ca/ergast/f1",
  "auth": {
    "types": [
      "none"
    ],
    "headers": {
      "Accept": "application/json"
    },
    "credential_fields": []
  },
  "tools": [
    {
      "name": "list_seasons",
      "description": "List available seasons with pagination.",
      "method": "GET",
      "path": "/seasons.json",
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Maximum results to return."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "Pagination offset."
          }
        },
        "additionalProperties": false
      },
      "rate_limit": {
        "min_interval_ms": 7200,
        "max_retries": 1,
        "retry_statuses": [
          429
        ]
      }
    },
    {
      "name": "list_races",
      "description": "Get a season calendar including session times where available.",
      "method": "GET",
      "path": "/{season}/races.json",
      "input_schema": {
        "type": "object",
        "properties": {
          "season": {
            "type": "string",
            "description": "Season year, e.g. 2025, or current."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Maximum results to return."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "Pagination offset."
          }
        },
        "required": [
          "season"
        ],
        "additionalProperties": false
      },
      "rate_limit": {
        "min_interval_ms": 7200,
        "max_retries": 1,
        "retry_statuses": [
          429
        ]
      }
    },
