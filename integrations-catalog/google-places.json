{
  "slug": "google-places",
  "name": "Google Places",
  "description": "Google Places API (New v1): search local businesses, get place details and photo metadata, and autocomplete place names. Supply a comma-separated fields mask to select returned data and control billing.",
  "logo": "https://www.google.com/s2/favicons?domain=maps.google.com&sz=128",
  "categories": [
    "places",
    "local",
    "leads",
    "prospecting",
    "maps",
    "businesses"
  ],
  "base_url": "https://places.googleapis.com/v1",
  "auth": {
    "types": [
      "api_key"
    ],
    "headers": {
      "X-Goog-Api-Key": "{{api_key}}",
      "Content-Type": "application/json"
    },
    "credential_fields": [
      {
        "name": "api_key",
        "label": "API key",
        "description": "Google Cloud API key with the Places API (New) enabled. Create at console.cloud.google.com \u2192 APIs & Services \u2192 Credentials."
      }
    ]
  },
  "tools": [
    {
      "name": "search_text",
      "description": "Search businesses by text query, e.g. restaurants in Lyon France or swimming pool contractors in Chicago IL. Up to 20 results per page and currently up to 60 per query; use pageToken and include nextPageToken in fields for pagination. Results are ranked and are not an exhaustive directory.",
      "method": "POST",
      "path": "/places:searchText",
      "input_schema": {
        "type": "object",
        "properties": {
          "textQuery": {
            "type": "string",
            "description": "Free-form query, e.g. 'marketing agency in Lyon France' or 'dental clinics 75011 Paris'"
          },
          "includedType": {
            "type": "string",
            "description": "Place type filter, e.g. restaurant or dentist. Set strictTypeFiltering=true to require the type."
          },
          "minRating": {
            "type": "number",
            "description": "Minimum average rating (0.0\u20135.0)",
            "minimum": 0,
            "maximum": 5
          },
          "openNow": {
            "type": "boolean",
            "description": "Only places currently open"
          },
          "pageSize": {
            "type": "integer",
            "default": 20,
            "minimum": 1,
            "maximum": 20
          },
          "pageToken": {
            "type": "string",
            "description": "Pagination token from a previous response"
          },
          "languageCode": {
            "type": "string",
            "description": "BCP-47 language code, e.g. 'en', 'fr'"
          },
          "regionCode": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2 region, e.g. 'FR'"
          },
          "locationBias": {
            "type": "object",
            "properties": {
              "circle": {
                "type": "object",
                "properties": {
                  "center": {
                    "type": "object",
                    "properties": {
                      "latitude": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "longitude": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      }
                    },
                    "required": [
                      "latitude",
                      "longitude"
                    ]
                  },
                  "radius": {
                    "type": "number",
                    "maximum": 50000,
                    "minimum": 0
                  }
                },
                "required": [
                  "center",
                  "radius"
                ]
              },
              "rectangle": {
                "type": "object",
                "properties": {
                  "low": {
                    "type": "object",
                    "properties": {
                      "latitude": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "longitude": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      }
                    },
                    "required": [
                      "latitude",
                      "longitude"
                    ]
                  },
                  "high": {
                    "type": "object",
                    "properties": {
                      "latitude": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "longitude": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      }
                    },
                    "required": [
                      "latitude",
                      "longitude"
                    ]
                  }
                },
                "required": [
                  "low",
                  "high"
                ]
              }
            },
            "required": [],
            "description": "Bias results to a circle or rectangle. Do not combine with locationRestriction.",
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "circle"
                ]
              },
              {
                "required": [
                  "rectangle"
                ]
              }
            ]
          },
          "locationRestriction": {
            "type": "object",
            "properties": {
              "rectangle": {
                "type": "object",
                "properties": {
                  "low": {
                    "type": "object",
                    "properties": {
                      "latitude": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "longitude": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      }
                    },
                    "required": [
                      "latitude",
                      "longitude"
                    ]
                  },
                  "high": {
                    "type": "object",
                    "properties": {
                      "latitude": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "longitude": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      }
                    },
                    "required": [
                      "latitude",
                      "longitude"
                    ]
                  }
                },
                "required": [
                  "low",
                  "high"
                ]
              }
            },
            "required": [],
            "description": "Restrict results to a rectangle with low and high latitude/longitude corners. Do not combine with locationBias.",
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "rectangle"
                ]
              }
            ]
          },
          "priceLevels": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "PRICE_LEVEL_FREE",
                "PRICE_LEVEL_INEXPENSIVE",
                "PRICE_LEVEL_MODERATE",
                "PRICE_LEVEL_EXPENSIVE",
                "PRICE_LEVEL_VERY_EXPENSIVE"
              ]
            }
          },
          "fields": {
            "type": "string",
            "description": "Required comma-separated response field mask; example: places.id,places.displayName,places.formattedAddress,places.websiteUri,places.nationalPhoneNumber,nextPageToken. Request only needed fields to control billing. Use * only intentionally.",
            "minLength": 1
          },
          "strictTypeFiltering": {
            "type": "boolean",
            "description": "Require includedType rather than allowing other relevant types"
          },
          "includePureServiceAreaBusinesses": {
            "type": "boolean",
            "description": "Include businesses that visit customers and have no public business location, such as pool maintenance contractors"
          }
        },
        "required": [
          "textQuery",
          "fields"
        ],
        "not": {
          "required": [
            "locationBias",
            "locationRestriction"
          ]
        }
      },
      "query_params": [
        "fields"
      ]
    },
    {
      "name": "search_nearby",
      "description": "Find places within a circular radius of a point. Up to 20 ranked results per call; this does not return every matching business.",
      "method": "POST",
      "path": "/places:searchNearby",
      "input_schema": {
        "type": "object",
        "properties": {
          "locationRestriction": {
            "type": "object",
            "properties": {
              "circle": {
                "type": "object",
                "properties": {
                  "center": {
                    "type": "object",
                    "properties": {
                      "latitude": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "longitude": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      }
                    },
                    "required": [
                      "latitude",
                      "longitude"
                    ]
                  },
                  "radius": {
                    "type": "number",
                    "maximum": 50000,
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "center",
                  "radius"
                ]
              }
            },
            "required": [],
            "description": "Required circular search area; radius must be greater than 0 and at most 50000 meters.",
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "circle"
                ]
              }
            ]
          },
          "includedTypes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Place types to include, e.g. ['restaurant', 'cafe']"
          },
          "excludedTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "maxResultCount": {
            "type": "integer",
            "default": 20,
            "minimum": 1,
            "maximum": 20
          },
          "rankPreference": {
            "type": "string",
            "enum": [
              "POPULARITY",
              "DISTANCE"
            ],
            "default": "POPULARITY"
          },
          "languageCode": {
            "type": "string"
          },
          "regionCode": {
            "type": "string"
          },
          "fields": {
            "type": "string",
            "description": "Required comma-separated response field mask; example: places.id,places.displayName,places.formattedAddress,places.websiteUri,places.nationalPhoneNumber. Request only needed fields to control billing. Use * only intentionally.",
            "minLength": 1
          }
        },
        "required": [
          "locationRestriction",
          "fields"
        ]
      },
      "query_params": [
        "fields"
      ]
    },
    {
      "name": "get_place",
      "description": "Get place details using a bare Place ID, e.g. ChIJ... (without the places/ prefix). Supply fields to select name, address, phone, website, hours, ratings, reviews or photo metadata.",
      "method": "GET",
      "path": "/places/{placeId}",
      "input_schema": {
        "type": "object",
        "properties": {
          "placeId": {
            "type": "string",
            "description": "Google Place ID (the bare id, no 'places/' prefix)",
            "minLength": 1,
            "pattern": "^[^/]+$"
          },
          "languageCode": {
            "type": "string"
          },
          "regionCode": {
            "type": "string"
          },
          "fields": {
            "type": "string",
            "description": "Required comma-separated response field mask; example: id,displayName,formattedAddress,websiteUri,nationalPhoneNumber. Request only needed fields to control billing. Use * only intentionally.",
            "minLength": 1
          },
          "sessionToken": {
            "type": "string",
            "description": "Token from the autocomplete request when completing an autocomplete session"
          }
        },
        "required": [
          "placeId",
          "fields"
        ]
      },
      "query_params": [
        "fields"
      ]
    },
    {
      "name": "autocomplete",
      "description": "Predict places from partial input. Set includeQueryPredictions=true to also return query predictions. Use the predicted placeId with get_place.",
      "method": "POST",
      "path": "/places:autocomplete",
      "input_schema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string"
          },
          "languageCode": {
            "type": "string"
          },
          "regionCode": {
            "type": "string"
          },
          "includedPrimaryTypes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 5
          },
          "locationBias": {
            "type": "object",
            "properties": {
              "circle": {
                "type": "object",
                "properties": {
                  "center": {
                    "type": "object",
                    "properties": {
                      "latitude": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "longitude": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      }
                    },
                    "required": [
                      "latitude",
                      "longitude"
                    ]
                  },
                  "radius": {
                    "type": "number",
                    "maximum": 50000,
                    "minimum": 0
                  }
                },
                "required": [
                  "center",
                  "radius"
                ]
              },
              "rectangle": {
                "type": "object",
                "properties": {
                  "low": {
                    "type": "object",
                    "properties": {
                      "latitude": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "longitude": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      }
                    },
                    "required": [
                      "latitude",
                      "longitude"
                    ]
                  },
                  "high": {
                    "type": "object",
                    "properties": {
                      "latitude": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "longitude": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      }
                    },
                    "required": [
                      "latitude",
                      "longitude"
                    ]
                  }
                },
                "required": [
                  "low",
                  "high"
                ]
              }
            },
            "required": [],
            "description": "Bias predictions to a circle or rectangle. Do not combine with locationRestriction.",
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "circle"
                ]
              },
              {
                "required": [
                  "rectangle"
                ]
              }
            ]
          },
          "locationRestriction": {
            "type": "object",
            "properties": {
              "circle": {
                "type": "object",
                "properties": {
                  "center": {
                    "type": "object",
                    "properties": {
                      "latitude": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "longitude": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      }
                    },
                    "required": [
                      "latitude",
                      "longitude"
                    ]
                  },
                  "radius": {
                    "type": "number",
                    "maximum": 50000,
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "center",
                  "radius"
                ]
              },
              "rectangle": {
                "type": "object",
                "properties": {
                  "low": {
                    "type": "object",
                    "properties": {
                      "latitude": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "longitude": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      }
                    },
                    "required": [
                      "latitude",
                      "longitude"
                    ]
                  },
                  "high": {
                    "type": "object",
                    "properties": {
                      "latitude": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "longitude": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      }
                    },
                    "required": [
                      "latitude",
                      "longitude"
                    ]
                  }
                },
                "required": [
                  "low",
                  "high"
                ]
              }
            },
            "required": [],
            "description": "Restrict predictions to a circle or rectangle. Do not combine with locationBias.",
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "circle"
                ]
              },
              {
                "required": [
                  "rectangle"
                ]
              }
            ]
          },
          "includeQueryPredictions": {
            "type": "boolean"
          },
          "sessionToken": {
            "type": "string",
            "description": "Unique token shared with the subsequent get_place call for one autocomplete session; start a new token for each session"
          },
          "includePureServiceAreaBusinesses": {
            "type": "boolean",
            "description": "Include businesses with no public business location"
          }
        },
        "required": [
          "input"
        ],
        "not": {
          "required": [
            "locationBias",
            "locationRestriction"
          ]
        }
      }
    }
  ]
}
