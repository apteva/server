{
  "slug": "uplead",
  "name": "UpLead",
  "description": "Official UpLead B2B API for verified-email prospecting, person and company lookup, advanced list building, credit checks, and saved-list management.",
  "logo": "https://www.google.com/s2/favicons?domain=uplead.com&sz=128",
  "categories": ["sales", "leads", "enrichment", "prospecting", "b2b", "email-verification"],
  "base_url": "https://api.uplead.com/v2",
  "auth": {
    "types": ["api_key"],
    "headers": {
      "Authorization": "{{api_key}}",
      "Accept": "application/json",
      "Content-Type": "application/json"
    },
    "credential_fields": [
      {
        "name": "api_key",
        "label": "UpLead API key",
        "description": "API key from app.uplead.com > Settings > API.",
        "required": true,
        "type": "password"
      }
    ]
  },
  "health_check": { "tool": "get_credits" },
  "tools": [
    {
      "name": "get_credits",
      "description": "Return the authenticated account and remaining credits. Use this before a credit-consuming lookup.",
      "method": "GET",
      "path": "/credits",
      "input_schema": { "type": "object", "properties": {} }
    },
    {
      "name": "lookup_company",
      "description": "Look up one company by domain, name, or UpLead ID. A domain gives the most precise match.",
      "method": "POST",
      "path": "/company-search",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "UpLead company ID." },
          "domain": { "type": "string" },
          "company": { "type": "string", "description": "Company name." }
        },
        "minProperties": 1
      }
    },
    {
      "name": "lookup_person",
      "description": "Look up one person by UpLead ID, email, or first and last name plus domain. Emails include UpLead's email_status verification result; phone data is returned when available.",
      "method": "POST",
      "path": "/person-search",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "email": { "type": "string" },
          "first_name": { "type": "string" },
          "last_name": { "type": "string" },
          "domain": { "type": "string" }
        },
        "minProperties": 1
      }
    },
    {
      "name": "lookup_person_and_company",
      "description": "Look up a person and their company together by email.",
      "method": "POST",
      "path": "/combined-search",
      "input_schema": {
        "type": "object",
        "properties": { "email": { "type": "string" } },
        "required": ["email"]
      }
    },
    {
      "name": "prospect_company_contacts",
      "description": "Find contacts and verified emails at one company. Filter by function, sub-function, management level, title, and location; use count_only to estimate before spending credits.",
      "method": "POST",
      "path": "/prospector-search",
      "input_schema": {
        "type": "object",
        "properties": {
          "domain": { "type": "string" },
          "job_function": { "type": "string" },
          "job_sub_function": { "type": "string" },
          "management_level": { "type": "string", "enum": ["M", "D", "VP", "C"] },
          "title": { "type": "string" },
          "city": { "type": "string" },
          "state": { "type": "string" },
          "country": { "type": "string" },
          "page": { "type": "integer", "minimum": 1, "default": 1 },
          "per_page": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 },
          "count_only": { "type": "boolean", "default": false }
        },
        "required": ["domain"]
      }
    },
    {
      "name": "prospect_contacts",
      "description": "Build an advanced people list across companies with Prospector Pro. Supports role, location, firmographic, technology, exclusion, count-only, and pagination filters. Professional, Elite, or Enterprise plan required.",
      "method": "POST",
      "path": "/prospector-pro-search",
      "input_schema": {
        "type": "object",
        "properties": {
          "domain": { "type": "string" },
          "domains": { "type": "array", "items": { "type": "string" } },
          "name": { "type": "string" },
          "job_functions": { "type": "array", "items": { "type": "string" } },
          "job_sub_functions": { "type": "array", "items": { "type": "string" } },
          "management_levels": { "type": "array", "items": { "type": "string", "enum": ["M", "D", "VP", "C", "CX"] } },
          "titles": { "type": "array", "items": { "type": "string" } },
          "title_search_mode": { "type": "string", "enum": ["include", "exact"] },
          "cities": { "type": "array", "items": { "type": "string" } },
          "states": { "type": "array", "items": { "type": "string" } },
          "countries": { "type": "array", "items": { "type": "string" } },
          "regions": { "type": "array", "items": { "type": "string", "enum": ["AMER", "APAC", "EMEA", "LATAM"] } },
          "location_target": { "type": "string", "enum": ["contact", "company"] },
          "industries": { "type": "array", "items": { "type": "string" } },
          "employees": { "type": "array", "items": { "type": "string" } },
          "revenues": { "type": "array", "items": { "type": "string" } },
          "technologies": { "type": "array", "items": { "type": "string" } },
          "exclude_eu": { "type": "boolean" },
          "exclusion_list_names": { "type": "array", "items": { "type": "string" } },
          "ids": { "type": "array", "items": { "type": "string" } },
          "count_only": { "type": "boolean", "default": false },
          "page": { "type": "integer", "minimum": 1, "default": 1 },
          "per_page": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 }
        }
      }
    },
    {
      "name": "quick_search",
      "description": "Search contacts or companies by free text and structured filters. Professional, Elite, or Enterprise plan required; use count_only to estimate results.",
      "method": "POST",
      "path": "/quick-search",
      "input_schema": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["contact", "company"] },
          "text": { "type": "string" },
          "domain": { "type": "string" },
          "domains": { "type": "array", "items": { "type": "string" } },
          "name": { "type": "string" },
          "job_functions": { "type": "array", "items": { "type": "string" } },
          "management_levels": { "type": "array", "items": { "type": "string" } },
          "titles": { "type": "array", "items": { "type": "string" } },
          "countries": { "type": "array", "items": { "type": "string" } },
          "industries": { "type": "array", "items": { "type": "string" } },
          "count_only": { "type": "boolean" },
          "num_results": { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 }
        },
        "required": ["type"]
      }
    },
    {
      "name": "company_name_to_domain",
      "description": "Resolve a company name to its domain and logo.",
      "method": "POST",
      "path": "/company-name-to-domain",
      "input_schema": {
        "type": "object",
        "properties": { "company_name": { "type": "string" } },
        "required": ["company_name"]
      }
    },
    {
      "name": "list_industries",
      "description": "List UpLead industries, optionally filtered by name.",
      "method": "GET",
      "path": "/industries",
      "query_params": ["text"],
      "input_schema": { "type": "object", "properties": { "text": { "type": "string" } } }
    },
    {
      "name": "list_saved_lists",
      "description": "List saved contact lists. Professional, Elite, or Enterprise plan required.",
      "method": "GET",
      "path": "/lists",
      "query_params": ["text", "page", "per_page"],
      "input_schema": {
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "page": { "type": "integer", "minimum": 1, "default": 1 },
          "per_page": { "type": "integer", "minimum": 1, "maximum": 100, "default": 15 }
        }
      }
    },
    {
      "name": "get_saved_list",
      "description": "Get one saved contact list.",
      "method": "GET",
      "path": "/lists/{list_id}",
      "input_schema": { "type": "object", "properties": { "list_id": { "type": "string" } }, "required": ["list_id"] }
    },
    {
      "name": "create_saved_list",
      "description": "Create an empty UpLead contact list.",
      "method": "POST",
      "path": "/lists",
      "input_schema": { "type": "object", "properties": { "name": { "type": "string" } }, "required": ["name"] }
    },
    {
      "name": "delete_saved_list",
      "description": "Permanently delete a saved UpLead list.",
      "method": "DELETE",
      "path": "/lists/{list_id}",
      "input_schema": { "type": "object", "properties": { "list_id": { "type": "string" } }, "required": ["list_id"] }
    },
    {
      "name": "list_saved_list_contacts",
      "description": "List contacts in a saved list, optionally filtering by contact, company, or domain text.",
      "method": "GET",
      "path": "/lists/{list_id}/contacts",
      "query_params": ["text", "page", "per_page"],
      "input_schema": {
        "type": "object",
        "properties": {
          "list_id": { "type": "string" },
          "text": { "type": "string" },
          "page": { "type": "integer", "minimum": 1, "default": 1 },
          "per_page": { "type": "integer", "minimum": 1, "maximum": 100, "default": 15 }
        },
        "required": ["list_id"]
      }
    },
    {
      "name": "add_contacts_to_list",
      "description": "Add UpLead contact IDs to a saved list.",
      "method": "POST",
      "path": "/lists/{list_id}/contacts/add",
      "input_schema": {
        "type": "object",
        "properties": {
          "list_id": { "type": "string" },
          "contact_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        },
        "required": ["list_id", "contact_ids"]
      }
    },
    {
      "name": "remove_contacts_from_list",
      "description": "Remove UpLead contact IDs from a saved list.",
      "method": "DELETE",
      "path": "/lists/{list_id}/contacts/delete",
      "input_schema": {
        "type": "object",
        "properties": {
          "list_id": { "type": "string" },
          "contact_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        },
        "required": ["list_id", "contact_ids"]
      }
    }
  ]
}
