{
  "slug": "spaceship",
  "name": "Spaceship",
  "logo": "https://www.spaceship.com/favicon.ico",
  "categories": [
    "domains"
  ],
  "description": "Spaceship public API for domain registration, portfolio management, DNS records, contacts, personal nameservers, transfer metadata, async operation status, and SellerHub.",
  "base_url": "https://spaceship.dev/api",
  "auth": {
    "types": [
      "api_key"
    ],
    "headers": {
      "X-API-Key": "{{api_key}}",
      "X-API-Secret": "{{api_secret}}",
      "Content-Type": "application/json"
    },
    "credential_fields": [
      {
        "name": "api_key",
        "label": "API Key",
        "description": "Spaceship API key from API Manager. Grant only the scopes needed by the tools you plan to expose.",
        "type": "password",
        "required": true
      },
      {
        "name": "api_secret",
        "label": "API Secret",
        "description": "Spaceship API secret paired with the API key.",
        "type": "password",
        "required": true
      }
    ]
  },
  "tools": [
    {
      "name": "list_domains",
      "display_name": "List Domains",
      "description": "List domains in the Spaceship account. Requires domains:read.",
      "method": "GET",
      "path": "/v1/domains",
      "input_schema": {
        "type": "object",
        "properties": {
          "take": {
            "type": "integer",
            "description": "Number of domains to return, 1-100."
          },
          "skip": {
            "type": "integer",
            "description": "Number of domains to skip."
          },
          "orderBy": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "name",
                "-name",
                "unicodeName",
                "-unicodeName",
                "registrationDate",
                "-registrationDate",
                "expirationDate",
                "-expirationDate"
              ]
            },
            "description": "Optional sort, max one item."
          }
        },
        "required": [
          "take",
          "skip"
        ]
      }
    },
    {
      "name": "get_domain_info",
      "display_name": "Get Domain Info",
      "description": "Get details for a specific domain. Requires domains:read.",
      "method": "GET",
      "path": "/v1/domains/{domain}",
      "input_schema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "description": "Fully-qualified domain name, e.g. example.com."
          }
        },
        "required": [
          "domain"
        ]
      }
    },
    {
      "name": "register_domain",
      "description": "Register an available domain. SPENDS MONEY at Spaceship account rates; no API dry run, price cap, or documented idempotency. Obtain explicit confirmation including term, privacy and contacts. Requires domains:billing and asyncoperations:read. HTTP 202 only means accepted; use returned operation_id with get_async_operation. Never repeat a timed-out submission automatically.",
      "method": "POST",
      "path": "/v1/domains/{domain}",
      "input_schema": {
        "type": "object",
        "required": [
          "domain",
          "autoRenew",
          "years",
          "privacyProtection",
          "contacts"
        ],
        "properties": {
          "autoRenew": {
            "type": "boolean",
            "example": false,
            "description": "Specifies whether automatic renewal will be enabled for the domain after the registration. After that, if autoRenew is set to true, the domain will be automatically renewed using the account\u2019s default payment method upon each expiration"
          },
          "years": {
            "type": "integer",
            "format": "int32",
            "example": 1,
            "minimum": 1,
            "maximum": 10,
            "description": "Number of years to register the domain"
          },
          "privacyProtection": {
            "type": "object",
            "required": [
              "level",
              "userConsent"
            ],
            "properties": {
              "level": {
                "type": "string",
                "enum": [
                  "public",
                  "high"
                ],
                "example": "high",
                "description": "Indicates the level of privacy protection. Set this property to \"high\" to enable privacy protection and hide your personal details, or to \"public\" to display your real contact information.\nWhen choosing the \"public\" level, the \"userConsent\" property must be set to true to confirm your explicit consent for making your contact information publicly available.\n\nNote: not all TLDs support \"high\" privacy protection level"
              },
              "userConsent": {
                "type": "boolean",
                "example": true,
                "description": "Indicates whether the user consents to the Public privacy settings"
              }
            },
            "description": "Privacy protection options. This parameter controls the visibility of your domain registrant contact information in the public WHOIS database."
          },
          "contacts": {
            "type": "object",
            "required": [
              "registrant"
            ],
            "properties": {
              "registrant": {
                "type": "string",
                "example": "1ZdMXpapqp9sle5dl8BlppTJXAzf5",
                "minLength": 27,
                "maxLength": 32,
                "pattern": "[a-zA-Z0-9]+",
                "description": "ID of the registrant contact person"
              },
              "admin": {
                "type": "string",
                "example": "1ZdMXpapqp9sle5dl8BlppTJXAzf5",
                "minLength": 27,
                "maxLength": 32,
                "pattern": "[a-zA-Z0-9]+",
                "description": "ID of the admin contact person"
              },
              "tech": {
                "type": "string",
                "example": "1ZdMXpapqp9sle5dl8BlppTJXAzf5",
                "minLength": 27,
                "maxLength": 32,
                "pattern": "[a-zA-Z0-9]+",
                "description": "ID of the technical contact person"
              },
              "billing": {
                "type": "string",
                "example": "1ZdMXpapqp9sle5dl8BlppTJXAzf5",
                "minLength": 27,
                "maxLength": 32,
                "pattern": "[a-zA-Z0-9]+",
                "description": "ID of the billing contact person"
              },
              "attributes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "example": "1ZdMXpapqp9sle5dl8BlppTJXAzf5",
                  "minLength": 27,
                  "maxLength": 32,
                  "pattern": "[a-zA-Z0-9]+",
                  "description": "Contact ID"
                },
                "example": [
                  "1ZdMXpapqp9sle5dl8BlppTJXAzf3",
                  "1ZdMXpapqp9sle5dl8BlppTJXAzf2"
                ],
                "maxItems": 5,
                "description": "List of extended attribute contact point IDs"
              }
            },
            "description": "Domain contacts are specified using contact IDs. These contact IDs can be obtained from the \u201cGet domain info\u201d endpoint (/domains) for an existing domain, or by creating new contacts through the \u201cSave contact details\u201d endpoint (/contacts). Each contact ID corresponds to a specific contact person and includes their details (such as name, address, and email). These contacts will be associated with the domain during registration.",
            "example": {
              "registrant": "1ZdMXpapqp9sle5dl8BlppTJXAzf5",
              "admin": "1ZdMXpapqp9sle5dl8BlppTJXAzf6",
              "tech": "1ZdMXpapqp9sle5dl8BlppTJXAzf5",
              "billing": "1ZdMXpapqp9sle5dl8BlppTJXAzf5",
              "attributes": [
                "1ZdMXpapqp9sle5dl8BlppTJXAzf8"
              ]
            }
          },
          "domain": {
            "type": "string",
            "description": "Domain to register (ASCII)."
          }
        },
        "additionalProperties": false
      },
      "response_header_fields": {
        "spaceship-async-operationid": "operation_id"
      },
      "rate_limit": {
        "min_interval_ms": 1000,
        "max_retries": 0
      }
    },
    {
      "name": "check_domains_availability",
      "display_name": "Check Domains Availability",
      "description": "Check availability for up to 20 domains. Requires domains:read.",
      "method": "POST",
      "path": "/v1/domains/available",
      "input_schema": {
        "type": "object",
        "properties": {
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Domain names to check."
          }
        },
        "required": [
          "domains"
        ]
      }
    },
    {
      "name": "check_single_domain_availability",
      "display_name": "Check Single Domain Availability",
      "description": "Check availability for one domain. Requires domains:read.",
      "method": "GET",
      "path": "/v1/domains/{domain}/available",
      "input_schema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          }
        },
        "required": [
          "domain"
        ]
      }
    },
    {
      "name": "update_autorenewal",
      "display_name": "Update Autorenewal",
      "description": "Enable or disable autorenewal for a domain. Requires domains:write.",
      "method": "PUT",
      "path": "/v1/domains/{domain}/autorenew",
      "input_schema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "isEnabled": {
            "type": "boolean",
            "description": "Desired autorenewal state."
          }
        },
        "required": [
          "domain",
          "isEnabled"
        ]
      }
    },
    {
      "name": "update_domain_nameservers",
      "display_name": "Update Domain Nameservers",
      "description": "Replace a domain's nameserver provider and custom hosts. Requires domains:write.",
      "method": "PUT",
      "path": "/v1/domains/{domain}/nameservers",
      "input_schema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "basic",
              "custom"
            ],
            "description": "Use basic for Spaceship nameservers or custom for explicit hosts."
          },
          "hosts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Custom nameserver hostnames. Required for provider=custom; omit for provider=basic."
          }
        },
        "required": [
          "domain",
          "provider"
        ]
      }
    },
    {
      "name": "update_domain_contacts",
      "display_name": "Update Domain Contacts",
      "description": "Set contact IDs on a domain. Requires domains:write.",
      "method": "PUT",
      "path": "/v1/domains/{domain}/contacts",
      "input_schema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "registrant": {
            "type": "string",
            "description": "Registrant contact ID."
          },
          "admin": {
            "type": "string",
            "description": "Admin contact ID."
          },
          "tech": {
            "type": "string",
            "description": "Technical contact ID."
          },
          "billing": {
            "type": "string",
            "description": "Billing contact ID."
          },
          "attributes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Extended attribute contact point IDs."
          }
        },
        "required": [
          "domain",
          "registrant"
        ]
      }
    },
    {
      "name": "update_domain_email_protection_preference",
      "display_name": "Update Email Protection Preference",
      "description": "Control whether WHOIS displays a contact form link. Requires domains:write.",
      "method": "PUT",
      "path": "/v1/domains/{domain}/privacy/email-protection-preference",
      "input_schema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "contactForm": {
            "type": "boolean"
          }
        },
        "required": [
          "domain",
          "contactForm"
        ]
      }
    },
    {
      "name": "update_domain_privacy_preference",
      "display_name": "Update Domain Privacy Preference",
      "description": "Set domain privacy level. Requires domains:write and userConsent=true.",
      "method": "PUT",
      "path": "/v1/domains/{domain}/privacy/preference",
      "input_schema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "privacyLevel": {
            "type": "string",
            "enum": [
              "public",
              "high"
            ]
          },
          "userConsent": {
            "type": "boolean",
            "description": "Must be true for the operation to proceed."
          }
        },
        "required": [
          "domain",
          "privacyLevel",
          "userConsent"
        ]
      }
    },
    {
      "name": "get_personal_nameservers",
      "display_name": "Get Personal Nameservers",
      "description": "Get personal nameservers configured on a domain. Requires domains:read.",
      "method": "GET",
      "path": "/v1/domains/{domain}/personal-nameservers",
      "input_schema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          }
        },
        "required": [
          "domain"
        ]
      }
    },
    {
      "name": "get_personal_nameserver_host",
      "display_name": "Get Personal Nameserver Host",
      "description": "Get host configuration for one personal nameserver. Spaceship currently marks this endpoint as under development in their docs. Requires domains:read.",
      "method": "GET",
      "path": "/v1/domains/{domain}/personal-nameservers/{currentHost}",
      "input_schema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "currentHost": {
            "type": "string",
            "description": "Host part, e.g. ns1."
          }
        },
        "required": [
          "domain",
          "currentHost"
        ]
      }
    },
    {
      "name": "update_personal_nameserver_host",
      "display_name": "Update Personal Nameserver Host",
      "description": "Create, update, or rename personal nameserver host glue configuration. Requires domains:write.",
      "method": "PUT",
      "path": "/v1/domains/{domain}/personal-nameservers/{currentHost}",
      "input_schema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "currentHost": {
            "type": "string",
            "description": "Current host part, e.g. ns1."
          },
          "host": {
            "type": "string",
            "description": "New host part."
          },
          "ips": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "IPv4/IPv6 addresses for the personal nameserver host."
          }
        },
        "required": [
          "domain",
          "currentHost",
          "host",
          "ips"
        ]
      }
    },
    {
      "name": "delete_personal_nameserver_host",
      "display_name": "Delete Personal Nameserver Host",
      "description": "Delete personal nameserver host glue configuration. Requires domains:write.",
      "method": "DELETE",
      "path": "/v1/domains/{domain}/personal-nameservers/{currentHost}",
      "input_schema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "currentHost": {
            "type": "string"
          }
        },
        "required": [
          "domain",
          "currentHost"
        ]
      }
    },
    {
      "name": "get_transfer_info",
      "display_name": "Get Transfer Info",
      "description": "Get transfer details for a domain. Requires domains:transfer.",
      "method": "GET",
      "path": "/v1/domains/{domain}/transfer",
      "input_schema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          }
        },
        "required": [
          "domain"
        ]
      }
    },
    {
      "name": "get_auth_code",
      "display_name": "Get Auth Code",
      "description": "Get the domain transfer auth/EPP code. Sensitive output. Requires domains:transfer.",
      "method": "GET",
      "path": "/v1/domains/{domain}/transfer/auth-code",
      "input_schema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          }
        },
        "required": [
          "domain"
        ]
      }
    },
    {
      "name": "update_transfer_lock",
      "display_name": "Update Transfer Lock",
      "description": "Enable or disable transfer lock for a domain. Requires domains:transfer.",
      "method": "PUT",
      "path": "/v1/domains/{domain}/transfer/lock",
      "input_schema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "isLocked": {
            "type": "boolean",
            "description": "Desired transfer lock state."
          }
        },
        "required": [
          "domain",
          "isLocked"
        ]
      }
    },
    {
      "name": "list_dns_records",
      "display_name": "List DNS Records",
      "description": "List DNS resource records for a domain. Requires dnsrecords:read.",
      "method": "GET",
      "path": "/v1/dns/records/{domain}",
      "input_schema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "take": {
            "type": "integer",
            "description": "Number of records to return, 1-500."
          },
          "skip": {
            "type": "integer",
            "description": "Number of records to skip."
          },
          "orderBy": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "type",
                "-type",
                "name",
                "-name"
              ]
            }
          }
        },
        "required": [
          "domain",
          "take",
          "skip"
        ]
      }
    },
    {
      "name": "save_dns_records",
      "display_name": "Save DNS Records",
      "description": "Create or update DNS resource records in a batch. Requires dnsrecords:write. Use list_dns_records first when changing existing records.",
      "method": "PUT",
      "path": "/v1/dns/records/{domain}",
      "input_schema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "force": {
            "type": "boolean",
            "description": "Disable conflict checks and force zone update."
          },
          "items": {
            "type": "array",
            "description": "DNS records to save. Each item requires type and name plus type-specific fields, e.g. A uses address, TXT uses value, CNAME uses cname.",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "ttl": {
                  "type": "integer"
                }
              },
              "required": [
                "type",
                "name"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "domain",
          "items"
        ]
      }
    },
    {
      "name": "delete_dns_records",
      "display_name": "Delete DNS Records",
      "description": "Delete DNS resource records in a batch. Requires dnsrecords:write. Pass the type/name and type-specific identifiers for records to delete.",
      "method": "DELETE",
      "path": "/v1/dns/records/{domain}",
      "body_root_param": "records",
      "input_schema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "name"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "domain",
          "records"
        ]
      }
    },
    {
      "name": "save_contact",
      "display_name": "Save Contact",
      "description": "Save contact details and receive a generated contact ID. Requires contacts:write.",
      "method": "PUT",
      "path": "/v1/contacts",
      "input_schema": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "organization": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "address1": {
            "type": "string"
          },
          "address2": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2 country code."
          },
          "stateProvince": {
            "type": "string"
          },
          "postalCode": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "description": "Phone in +country.local format, e.g. +1.123456789."
          },
          "phoneExt": {
            "type": "string"
          },
          "fax": {
            "type": "string"
          },
          "faxExt": {
            "type": "string"
          },
          "taxNumber": {
            "type": "string"
          }
        },
        "required": [
          "firstName",
          "lastName",
          "email",
          "address1",
          "city",
          "country",
          "phone"
        ]
      }
    },
    {
      "name": "get_contact",
      "display_name": "Get Contact",
      "description": "Read contact details by contact ID. Requires contacts:read.",
      "method": "GET",
      "path": "/v1/contacts/{contact}",
      "input_schema": {
        "type": "object",
        "properties": {
          "contact": {
            "type": "string",
            "description": "Contact ID."
          }
        },
        "required": [
          "contact"
        ]
      }
    },
    {
      "name": "save_contact_attributes",
      "display_name": "Save Contact Attributes",
      "description": "Save registry-specific contact attributes and receive an attribute contact ID. Requires contacts:write.",
      "method": "PUT",
      "path": "/v1/contacts/attributes",
      "input_schema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Attribute type, e.g. us or ca."
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": true
      }
    },
    {
      "name": "get_contact_attributes",
      "display_name": "Get Contact Attributes",
      "description": "Read registry-specific contact attributes by attribute contact ID. Requires contacts:read.",
      "method": "GET",
      "path": "/v1/contacts/attributes/{contact}",
      "input_schema": {
        "type": "object",
        "properties": {
          "contact": {
            "type": "string",
            "description": "Attribute contact ID."
          }
        },
        "required": [
          "contact"
        ]
      }
    },
    {
      "name": "get_async_operation",
      "display_name": "Get Async Operation",
      "description": "Get status and details for a long-running Spaceship operation. Requires asyncoperations:read.",
      "method": "GET",
      "path": "/v1/async-operations/{operationId}",
      "input_schema": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string"
          }
        },
        "required": [
          "operationId"
        ]
      }
    },
    {
      "name": "list_sellerhub_domains",
      "display_name": "List SellerHub Domains",
      "description": "List domains configured in SellerHub. Requires sellerhub:read.",
      "method": "GET",
      "path": "/v1/sellerhub/domains",
      "input_schema": {
        "type": "object",
        "properties": {
          "take": {
            "type": "integer"
          },
          "skip": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "failed",
              "verifying",
              "onSale",
              "onSaleStopped",
              "saleProcessing",
              "privateSale",
              "leaseActive",
              "sold"
            ],
            "description": "Filter by SellerHub public status."
          }
        }
      }
    },
    {
      "name": "list_sellerhub_sold_domains",
      "display_name": "List Sold SellerHub Domains",
      "description": "Read confirmed SellerHub sales with saleDateTime, salePrice and payout. Requires sellerhub:read. Cursor-paginated; follow cursor until absent. Listing disappearance alone is not proof of a sale. API reference: https://docs.spaceship.dev/",
      "method": "GET",
      "path": "/v1/sellerhub/domains/reports/sold",
      "input_schema": {
        "type": "object",
        "properties": {
