      }
    },
    {
      "name": "get_media_children",
      "description": "List the child media of a CAROUSEL_ALBUM post. Calls GET /{media-id}/children.",
      "method": "GET",
      "path": "/{mediaId}/children",
      "input_schema": {
        "type": "object",
        "properties": {
          "mediaId": {
            "type": "string",
            "description": "Instagram media ID of the carousel parent."
          },
          "fields": {
            "type": "string",
            "description": "Comma-separated fields to retrieve.",
            "default": "id,media_type,media_url,thumbnail_url,permalink,timestamp"
          }
        },
        "required": [
          "mediaId"
        ]
      },
      "mock_response": {
        "data": [
