{
  "slug": "instagram-api",
  "name": "Instagram",
  "description": "Instagram API with Instagram Login. Connects an Instagram Business or Creator account directly — no Facebook Page required and no Page access tokens involved. Publish media (images, Reels, Stories, carousels), read media and insights, manage comments and mentions, and send/read DMs. For IG accounts reached through a linked Facebook Page, use the facebook-api integration instead.",
  "logo": "https://www.google.com/s2/favicons?domain=www.instagram.com&sz=128",
  "categories": [
    "instagram",
    "social-media",
    "photos",
    "videos",
    "analytics"
  ],
  "base_url": "https://graph.instagram.com/v25.0",
  "auth": {
    "types": [
      "bearer",
      "oauth2"
    ],
    "headers": {
      "Authorization": "Bearer {{token}}"
    },
    "credential_fields": [
      {
        "name": "token",
        "label": "access_token"
      },
      {
        "name": "user_id",
        "label": "user_id"
      }
    ],
    "oauth2": {
      "authorize_url": "https://www.instagram.com/oauth/authorize",
      "token_url": "https://api.instagram.com/oauth/access_token",
      "scopes": [
        "instagram_business_basic",
        "instagram_business_content_publish",
        "instagram_business_manage_comments",
        "instagram_business_manage_messages"
      ],
      "scope_separator": ",",
      "client_id_required": true,
      "pkce": false,
      "token_response_path": "data.0",
      "long_lived_exchange": {
        "url": "https://graph.instagram.com/access_token",
        "method": "GET",
        "params": {
          "grant_type": "ig_exchange_token"
        },
        "send_client_secret": true
      },
      "refresh": {
        "url": "https://graph.instagram.com/refresh_access_token",
        "method": "GET",
        "params": {
          "grant_type": "ig_refresh_token"
        },
        "credential": "access_token"
      },
      "setup_url": "https://developers.facebook.com/apps",
      "setup_steps": [
        "Create a Meta app and add the Instagram product to it.",
        "Under Instagram > API setup with Instagram login, configure Business login settings.",
        "Add your Apteva OAuth callback URL as a valid redirect URI.",
        "Copy the Instagram app ID and Instagram app secret into this connection.",
        "The account you authorize must be an Instagram Business or Creator account — personal accounts cannot publish via the API."
      ]
    }
  },
  "tools": [
    {
      "name": "get_account",
      "description": "Get the connected Instagram Business/Creator account's profile: username, name, bio, follower counts, media count. This is the account the connection's token authorizes; there is no account picker in this flow. Calls GET /me.",
      "method": "GET",
      "path": "/me",
      "input_schema": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "string",
            "description": "Comma-separated fields to retrieve.",
            "default": "user_id,username,name,account_type,profile_picture_url,followers_count,follows_count,media_count,biography,website"
          }
        }
      },
      "mock_response": {
        "user_id": "17841400000000001",
        "username": "apteva_ai",
        "name": "Apteva",
        "account_type": "BUSINESS",
        "biography": "Continuous thinking engine",
        "followers_count": 2480,
        "follows_count": 180,
        "media_count": 64,
        "profile_picture_url": "https://scontent.cdninstagram.com/mock-profile.jpg"
      }
    },
    {
      "name": "get_account_media",
      "description": "List media posted by the connected account, newest first. Use the paging cursor in `after` to walk older pages. Calls GET /me/media.",
      "method": "GET",
      "path": "/me/media",
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "description": "Number of media items to retrieve.",
            "default": 25,
            "maximum": 100
          },
          "fields": {
            "type": "string",
            "description": "Comma-separated fields to retrieve.",
            "default": "id,media_type,media_product_type,media_url,thumbnail_url,permalink,caption,timestamp,like_count,comments_count,is_shared_to_feed"
          },
          "since": {
            "type": "string",
            "description": "Unix timestamp or strtotime value for the lower bound."
          },
          "until": {
            "type": "string",
            "description": "Unix timestamp or strtotime value for the upper bound."
          },
          "after": {
            "type": "string",
            "description": "Pagination cursor from paging.cursors.after."
          }
        }
      },
      "mock_response": {
        "data": [
          {
            "id": "17900000000000099",
            "caption": "Launch day!",
            "media_type": "IMAGE",
            "media_url": "https://scontent.cdninstagram.com/mock-media1.jpg",
            "permalink": "https://www.instagram.com/p/CmOckPost1/",
            "timestamp": "2026-05-22T12:00:00+0000",
            "like_count": 210,
            "comments_count": 18
          }
        ],
        "paging": {
          "cursors": {}
        }
      }
    },
    {
