      "input_schema": {
        "type": "object",
        "properties": {
          "mediaId": {
            "type": "string",
            "description": "Instagram media ID."
          },
          "fields": {
            "type": "string",
            "description": "Comma-separated fields to retrieve.",
            "default": "id,media_type,media_product_type,media_url,thumbnail_url,permalink,caption,timestamp,like_count,comments_count,is_comment_enabled,username"
          }
        },
        "required": [
          "mediaId"
        ]
      },
      "mock_response": {
