    {
      "name": "create_media_container",
      "description": "Publishing step 1 of 2: create a media container, then pass its id to publish_media_container. IMAGE takes image_url; REELS and STORIES take video_url. For a CAROUSEL: create each child with is_carousel_item=true, then create a parent with media_type=CAROUSEL and children=<comma-separated child ids>, then publish the parent (max 10 items). Media URLs must be publicly reachable — Instagram fetches them server-side. Video containers process asynchronously; poll get_container_status until status_code=FINISHED before publishing. Calls POST /{ig-user-id}/media.",
      "method": "POST",
      "path": "/{{credential.user_id}}/media",
      "input_schema": {
        "type": "object",
        "properties": {
          "image_url": {
            "type": "string",
            "description": "Publicly reachable image URL (IMAGE and carousel image children)."
          },
          "video_url": {
            "type": "string",
            "description": "Publicly reachable video URL (REELS, STORIES, carousel video children)."
          },
          "caption": {
            "type": "string",
            "description": "Caption text. Not applicable to STORIES."
          },
          "media_type": {
            "type": "string",
            "description": "Container type. Omit for a plain feed image.",
            "enum": [
              "IMAGE",
              "REELS",
              "STORIES",
              "CAROUSEL"
            ],
            "default": "IMAGE"
          },
          "is_carousel_item": {
            "type": "boolean",
            "description": "True when this container is a child of a carousel."
          },
          "children": {
            "type": "string",
            "description": "Comma-separated child container ids. Required when media_type=CAROUSEL."
          },
          "cover_url": {
            "type": "string",
            "description": "Publicly reachable image URL used as the Reel cover."
          },
          "thumb_offset": {
            "type": "string",
            "description": "Milliseconds into the video to use as the thumbnail, when no cover_url is given."
          },
          "location_id": {
            "type": "string",
            "description": "Facebook Page ID of a location to tag."
          },
          "user_tags": {
            "type": "string",
            "description": "JSON array of user tags, e.g. [{\"username\":\"someone\",\"x\":0.5,\"y\":0.5}]."
          },
          "share_to_feed": {
            "type": "boolean",
            "description": "For REELS: also show the Reel on the main feed profile grid."
          },
          "alt_text": {
            "type": "string",
            "description": "Accessibility alt text for the media."
          }
        }
      },
      "mock_response": {
        "id": "17900000000000001"
      }
    },
    {
      "name": "publish_media_container",
      "description": "Publishing step 2 of 2: publish a container created by create_media_container. Returns the published media id. Containers expire 24 hours after creation. Calls POST /{ig-user-id}/media_publish.",
      "method": "POST",
      "path": "/{{credential.user_id}}/media_publish",
      "input_schema": {
        "type": "object",
        "properties": {
          "creation_id": {
            "type": "string",
            "description": "The `id` returned by create_media_container."
          }
        },
        "required": [
          "creation_id"
        ]
      },
      "mock_response": {
        "id": "17900000000000099"
      }
    },
    {
      "name": "get_container_status",
      "description": "Poll a media container's processing status before publishing. status_code values: FINISHED (ready), IN_PROGRESS (still transcoding — Reels especially), ERROR (transcode/validation failed), EXPIRED (older than 24h, recreate it). Calls GET /{container-id}.",
      "method": "GET",
      "path": "/{containerId}",
      "input_schema": {
        "type": "object",
        "properties": {
          "containerId": {
            "type": "string",
            "description": "Container ID returned by create_media_container."
          },
          "fields": {
            "type": "string",
            "description": "Comma-separated fields to retrieve.",
            "default": "id,status_code,status"
          }
        },
        "required": [
          "containerId"
        ]
      },
      "mock_response": {
        "id": "17900000000000001",
        "status_code": "FINISHED"
      }
    },
    {
      "name": "get_publishing_limit",
      "description": "Check how much of the rolling 24-hour publishing quota the account has used. Instagram caps API-published posts per account per day; exceeding it fails publishes until the window rolls. Calls GET /{ig-user-id}/content_publishing_limit.",
      "method": "GET",
      "path": "/{{credential.user_id}}/content_publishing_limit",
      "input_schema": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "string",
            "description": "Comma-separated fields to retrieve.",
            "default": "config,quota_usage"
          }
        }
      },
      "mock_response": {
        "data": [
          {
            "quota_usage": 3,
            "config": {
              "quota_total": 100,
              "quota_duration": 86400
            }
          }
        ]
      }
    },
    {
      "name": "get_account_insights",
      "description": "Account-level analytics for the connected account. Metrics using metric_type=total_value support demographic breakdowns; time_series metrics return per-day points. Calls GET /{ig-user-id}/insights.",
      "method": "GET",
      "path": "/{{credential.user_id}}/insights",
      "input_schema": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "string",
            "description": "Comma-separated metrics, e.g. reach, follower_count, profile_views, accounts_engaged, total_interactions, likes, comments, shares, saves.",
            "default": "reach,follower_count"
          },
          "metric_type": {
            "type": "string",
            "description": "Use total_value for aggregate metrics and breakdowns; omit or use time_series for per-day points.",
            "enum": [
              "time_series",
              "total_value"
            ]
          },
          "breakdown": {
            "type": "string",
            "description": "Demographic breakdown for compatible total_value metrics: country, city, age, gender, media_product_type, follow_type. Availability is metric- and privacy-threshold-dependent."
          },
          "period": {
            "type": "string",
            "description": "Aggregation period.",
            "enum": [
              "day",
              "week",
              "days_28"
            ],
            "default": "day"
          },
          "since": {
            "type": "string",
            "description": "Unix timestamp or YYYY-MM-DD lower bound."
          },
          "until": {
            "type": "string",
            "description": "Unix timestamp or YYYY-MM-DD upper bound."
          }
        },
        "required": [
          "metric"
        ]
      },
      "mock_response": {
        "data": [
          {
            "name": "reach",
            "period": "day",
            "values": [
              {
                "value": 1840,
                "end_time": "2026-05-22T07:00:00+0000"
              }
            ]
          }
        ]
      }
    },
