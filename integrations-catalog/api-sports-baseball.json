      "path": "/countries",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "search": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    {
      "name": "list_leagues",
