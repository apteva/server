          "country": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "season": {
            "type": "integer"
          },
          "search": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    {
      "name": "list_teams",
      "description": "Find teams. Supply at least one filter. Full response includes errors, coverage and provider metadata; check errors before using results.",
