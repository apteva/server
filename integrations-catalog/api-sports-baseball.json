      "path": "/teams",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "country_id": {
            "type": "integer"
          },
          "country": {
            "type": "string"
          },
          "league": {
            "type": "integer"
          },
          "season": {
            "type": "integer"
          },
          "search": {
            "type": "string",
            "minLength": 3
          }
        },
        "anyOf": [
          {
            "required": [
              "id"
            ]
          },
          {
            "required": [
              "name"
            ]
          },
          {
            "required": [
              "country_id"
            ]
          },
          {
            "required": [
              "country"
            ]
          },
          {
            "required": [
