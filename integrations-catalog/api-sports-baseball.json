    {
      "name": "get_team_statistics",
      "description": "Get season statistics for a team and league. season uses YYYY. Full response includes errors, coverage and provider metadata; check errors before using results.",
      "method": "GET",
      "path": "/teams/statistics",
      "input_schema": {
        "type": "object",
        "properties": {
          "league": {
            "type": "integer"
          },
          "season": {
            "type": "string",
            "description": "YYYY."
          },
          "team": {
            "type": "integer"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "YYYY-MM-DD."
          }
        },
        "required": [
          "league",
          "season",
          "team"
        ]
      }
    },
