{
  "slug": "beehiiv",
  "name": "beehiiv",
  "description": "beehiiv API v2 for free and paid newsletters: publications, subscriptions, premium tiers and prices, newsletter lists, posts, automations, segments, custom fields, referrals, and stats.",
  "logo": "https://www.google.com/s2/favicons?domain=beehiiv.com&sz=128",
  "categories": ["newsletter", "email", "publishing", "subscribers", "growth"],
  "base_url": "https://api.beehiiv.com/v2",
  "auth": { "types": ["bearer"], "headers": { "Authorization": "Bearer {{token}}", "Accept": "application/json", "Content-Type": "application/json" }, "credential_fields": [{ "name": "token", "label": "API Key", "description": "beehiiv API key." }] },
  "health_check": { "tool": "list_publications", "input": {} },
  "tools": [
    { "name": "list_publications", "description": "List publications available to the API key.", "method": "GET", "path": "/publications", "query_params": ["limit", "page"], "input_schema": { "type": "object", "properties": { "limit": { "type": "integer" }, "page": { "type": "integer" } } } },
    { "name": "get_publication", "description": "Get one publication.", "method": "GET", "path": "/publications/{publication_id}", "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" } }, "required": ["publication_id"] } },
    { "name": "list_subscriptions", "description": "List publication subscribers, including free/premium status and assigned premium tiers.", "method": "GET", "path": "/publications/{publication_id}/subscriptions", "query_params": ["email", "status", "tier", "premium_tiers", "premium_tier_ids", "limit", "next_cursor", "expand"], "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "email": { "type": "string" }, "status": { "type": "string" }, "tier": { "type": "string", "enum": ["free", "premium", "all"] }, "premium_tiers": { "type": "array", "items": { "type": "string" } }, "premium_tier_ids": { "type": "array", "items": { "type": "string" } }, "limit": { "type": "integer" }, "next_cursor": { "type": "string" }, "expand": { "type": "array", "items": { "type": "string" } } }, "required": ["publication_id"] } },
    { "name": "create_subscription", "description": "Create a free or premium subscription and optionally assign paid tier names/IDs, attach a Stripe customer, apply complimentary access, subscribe to newsletter lists, or enroll in automations.", "method": "POST", "path": "/publications/{publication_id}/subscriptions", "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "email": { "type": "string" }, "reactivate_existing": { "type": "boolean" }, "send_welcome_email": { "type": "boolean" }, "utm_source": { "type": "string" }, "utm_medium": { "type": "string" }, "utm_campaign": { "type": "string" }, "utm_term": { "type": "string" }, "utm_content": { "type": "string" }, "referring_site": { "type": "string" }, "referral_code": { "type": "string" }, "custom_fields": { "type": "array", "items": { "type": "object" } }, "double_opt_override": { "type": "string", "enum": ["on", "off", "not_set"] }, "tier": { "type": "string", "enum": ["free", "premium"] }, "premium_tiers": { "type": "array", "items": { "type": "string" } }, "premium_tier_ids": { "type": "array", "items": { "type": "string" } }, "stripe_customer_id": { "type": "string" }, "automation_ids": { "type": "array", "items": { "type": "string" } }, "newsletter_list_ids": { "type": "array", "items": { "type": "string" } }, "skip_newsletter_list_auto_subscribe": { "type": "boolean" }, "complimentary_gift_id": { "type": "string" } }, "required": ["publication_id", "email"] } },
    { "name": "get_subscription", "description": "Get one subscription.", "method": "GET", "path": "/publications/{publication_id}/subscriptions/{subscription_id}", "query_params": ["expand"], "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "subscription_id": { "type": "string" }, "expand": { "type": "array", "items": { "type": "string" } } }, "required": ["publication_id", "subscription_id"] } },
    { "name": "get_subscription_by_email", "description": "Get one subscription by URL-encoded email address.", "method": "GET", "path": "/publications/{publication_id}/subscriptions/by_email/{email}", "query_params": ["expand"], "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "email": { "type": "string" }, "expand": { "type": "array", "items": { "type": "string" } } }, "required": ["publication_id", "email"] } },
    { "name": "update_subscription", "description": "Update a subscription by ID, including free/premium access, premium tier assignments, Stripe customer, complimentary access, email, and custom fields.", "method": "PUT", "path": "/publications/{publication_id}/subscriptions/{subscription_id}", "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "subscription_id": { "type": "string" }, "email": { "type": "string" }, "custom_fields": { "type": "array", "items": { "type": "object" } }, "tier": { "type": "string", "enum": ["free", "premium"] }, "premium_tiers": { "type": "array", "items": { "type": "string" } }, "premium_tier_ids": { "type": "array", "items": { "type": "string" } }, "stripe_customer_id": { "type": "string" }, "unsubscribe": { "type": "boolean" }, "complimentary_gift_id": { "type": "string" } }, "required": ["publication_id", "subscription_id"] } },
    { "name": "update_subscription_by_email", "description": "Update free/premium access and tier assignments by URL-encoded subscriber email.", "method": "PUT", "path": "/publications/{publication_id}/subscriptions/by_email/{subscriber_email}", "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "subscriber_email": { "type": "string" }, "email": { "type": "string" }, "custom_fields": { "type": "array", "items": { "type": "object" } }, "tier": { "type": "string", "enum": ["free", "premium"] }, "premium_tiers": { "type": "array", "items": { "type": "string" } }, "premium_tier_ids": { "type": "array", "items": { "type": "string" } }, "stripe_customer_id": { "type": "string" }, "unsubscribe": { "type": "boolean" }, "complimentary_gift_id": { "type": "string" } }, "required": ["publication_id", "subscriber_email"] } },
    { "name": "delete_subscription", "description": "Delete/unsubscribe a subscription.", "method": "DELETE", "path": "/publications/{publication_id}/subscriptions/{subscription_id}", "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "subscription_id": { "type": "string" } }, "required": ["publication_id", "subscription_id"] } },
    { "name": "list_tiers", "description": "List paid subscription tiers and optionally expand prices and subscriber statistics.", "method": "GET", "path": "/publications/{publication_id}/tiers", "query_params": ["expand", "limit", "page", "direction"], "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "expand": { "type": "array", "items": { "type": "string" } }, "limit": { "type": "integer" }, "page": { "type": "integer" }, "direction": { "type": "string", "enum": ["asc", "desc"] } }, "required": ["publication_id"] } },
    { "name": "get_tier", "description": "Get one paid subscription tier, optionally expanding its prices and statistics.", "method": "GET", "path": "/publications/{publication_id}/tiers/{tier_id}", "query_params": ["expand"], "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "tier_id": { "type": "string" }, "expand": { "type": "array", "items": { "type": "string" } } }, "required": ["publication_id", "tier_id"] } },
    { "name": "create_tier", "description": "Create a paid subscription tier with one or more recurring or one-time prices and tier benefits.", "method": "POST", "path": "/publications/{publication_id}/tiers", "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "name": { "type": "string" }, "description": { "type": "string" }, "prices_attributes": { "type": "array", "items": { "type": "object", "properties": { "currency": { "type": "string" }, "amount_cents": { "type": "integer" }, "interval": { "type": "string" }, "enabled": { "type": "boolean" }, "interval_display": { "type": "string" }, "cta": { "type": "string" }, "features": { "type": "array", "items": { "type": "string" } } }, "required": ["currency", "amount_cents", "interval"] } } }, "required": ["publication_id", "name"] } },
    { "name": "update_tier", "description": "Update a paid subscription tier and its price records. Include a price id to edit it or delete=true to remove it.", "method": "PUT", "path": "/publications/{publication_id}/tiers/{tier_id}", "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "tier_id": { "type": "string" }, "name": { "type": "string" }, "description": { "type": "string" }, "prices_attributes": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "currency": { "type": "string" }, "amount_cents": { "type": "integer" }, "interval": { "type": "string" }, "enabled": { "type": "boolean" }, "interval_display": { "type": "string" }, "cta": { "type": "string" }, "features": { "type": "array", "items": { "type": "string" } }, "delete": { "type": "boolean" } } } } }, "required": ["publication_id", "tier_id"] } },
    { "name": "list_newsletter_lists", "description": "List the publication's distinct newsletter lists.", "method": "GET", "path": "/publications/{publication_id}/newsletter_lists", "query_params": ["limit", "page", "direction"], "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "limit": { "type": "integer" }, "page": { "type": "integer" }, "direction": { "type": "string", "enum": ["asc", "desc"] } }, "required": ["publication_id"] } },
    { "name": "get_newsletter_list", "description": "Get one newsletter list.", "method": "GET", "path": "/publications/{publication_id}/newsletter_lists/{newsletter_list_id}", "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "newsletter_list_id": { "type": "string" } }, "required": ["publication_id", "newsletter_list_id"] } },
    { "name": "create_newsletter_list", "description": "Create a newsletter list for audience preferences or multiple publication streams.", "method": "POST", "path": "/publications/{publication_id}/newsletter_lists", "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "name": { "type": "string" }, "description": { "type": "string" }, "slug": { "type": "string" }, "auto_subscribe": { "type": "boolean" } }, "required": ["publication_id", "name"] } },
    { "name": "update_newsletter_list", "description": "Update or archive a newsletter list.", "method": "PATCH", "path": "/publications/{publication_id}/newsletter_lists/{newsletter_list_id}", "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "newsletter_list_id": { "type": "string" }, "name": { "type": "string" }, "description": { "type": "string" }, "slug": { "type": "string" }, "auto_subscribe": { "type": "boolean" }, "status": { "type": "string", "enum": ["active", "archived"] } }, "required": ["publication_id", "newsletter_list_id"] } },
    { "name": "delete_newsletter_list", "description": "Delete a newsletter list.", "method": "DELETE", "path": "/publications/{publication_id}/newsletter_lists/{newsletter_list_id}", "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "newsletter_list_id": { "type": "string" } }, "required": ["publication_id", "newsletter_list_id"] } },
    { "name": "list_automations", "description": "List newsletter automations, including flows accepting API enrollment.", "method": "GET", "path": "/publications/{publication_id}/automations", "query_params": ["limit", "page", "direction"], "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "limit": { "type": "integer" }, "page": { "type": "integer" }, "direction": { "type": "string", "enum": ["asc", "desc"] } }, "required": ["publication_id"] } },
    { "name": "get_automation", "description": "Get one newsletter automation.", "method": "GET", "path": "/publications/{publication_id}/automations/{automation_id}", "query_params": ["expand"], "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "automation_id": { "type": "string" }, "expand": { "type": "array", "items": { "type": "string" } } }, "required": ["publication_id", "automation_id"] } },
    { "name": "add_subscription_to_automation", "description": "Enroll an existing subscriber in an automation with an active Add by API trigger.", "method": "POST", "path": "/publications/{publication_id}/automations/{automation_id}/journeys", "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "automation_id": { "type": "string" }, "email": { "type": "string" }, "subscription_id": { "type": "string" }, "double_opt_override": { "type": "string", "enum": ["on", "off", "not_set"] } }, "required": ["publication_id", "automation_id"] } },
    { "name": "list_posts", "description": "List publication posts.", "method": "GET", "path": "/publications/{publication_id}/posts", "query_params": ["status", "audience", "platform", "limit", "page", "expand"], "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "status": { "type": "string" }, "audience": { "type": "string" }, "platform": { "type": "string" }, "limit": { "type": "integer" }, "page": { "type": "integer" }, "expand": { "type": "array", "items": { "type": "string" } } }, "required": ["publication_id"] } },
    { "name": "get_post", "description": "Get one post.", "method": "GET", "path": "/publications/{publication_id}/posts/{post_id}", "query_params": ["expand"], "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "post_id": { "type": "string" }, "expand": { "type": "array", "items": { "type": "string" } } }, "required": ["publication_id", "post_id"] } },
    { "name": "create_post", "description": "Create a beehiiv post. beehiiv marks this endpoint beta and Enterprise-gated in current docs.", "method": "POST", "path": "/publications/{publication_id}/posts", "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "title": { "type": "string" }, "subtitle": { "type": "string" }, "body_content": { "type": "string" }, "status": { "type": "string" }, "scheduled_at": { "type": "string" }, "authors": { "type": "array", "items": { "type": "string" } }, "audience": { "type": "string" }, "platform": { "type": "string" } }, "required": ["publication_id", "title"] } },
    { "name": "list_segments", "description": "List publication segments.", "method": "GET", "path": "/publications/{publication_id}/segments", "query_params": ["limit", "page"], "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "limit": { "type": "integer" }, "page": { "type": "integer" } }, "required": ["publication_id"] } },
    { "name": "get_segment", "description": "Get one segment.", "method": "GET", "path": "/publications/{publication_id}/segments/{segment_id}", "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "segment_id": { "type": "string" } }, "required": ["publication_id", "segment_id"] } },
    { "name": "list_custom_fields", "description": "List publication custom fields.", "method": "GET", "path": "/publications/{publication_id}/custom_fields", "query_params": ["limit", "page"], "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "limit": { "type": "integer" }, "page": { "type": "integer" } }, "required": ["publication_id"] } },
    { "name": "create_custom_field", "description": "Create a custom field.", "method": "POST", "path": "/publications/{publication_id}/custom_fields", "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "kind": { "type": "string" }, "display": { "type": "string" } }, "required": ["publication_id", "kind", "display"] } },
    { "name": "list_referrals", "description": "List referral data for a publication.", "method": "GET", "path": "/publications/{publication_id}/referrals", "query_params": ["limit", "page"], "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "limit": { "type": "integer" }, "page": { "type": "integer" } }, "required": ["publication_id"] } },
    { "name": "get_post_stats", "description": "Get stats for one post.", "method": "GET", "path": "/publications/{publication_id}/posts/{post_id}/stats", "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "post_id": { "type": "string" } }, "required": ["publication_id", "post_id"] } },
    { "name": "list_webhooks", "description": "List webhook endpoints for a publication.", "method": "GET", "path": "/publications/{publication_id}/webhooks", "query_params": ["limit", "page", "direction"], "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "limit": { "type": "integer" }, "page": { "type": "integer" }, "direction": { "type": "string", "enum": ["asc", "desc"] } }, "required": ["publication_id"] } },
    { "name": "get_webhook", "description": "Get one webhook endpoint.", "method": "GET", "path": "/publications/{publication_id}/webhooks/{endpoint_id}", "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "endpoint_id": { "type": "string" } }, "required": ["publication_id", "endpoint_id"] } },
    { "name": "create_webhook", "description": "Create a publication webhook for subscription, post, tier, newsletter-list, or other supported events.", "method": "POST", "path": "/publications/{publication_id}/webhooks", "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "url": { "type": "string" }, "event_types": { "type": "array", "items": { "type": "string" } }, "description": { "type": "string" } }, "required": ["publication_id", "url", "event_types"] } },
    { "name": "update_webhook", "description": "Update a webhook's subscribed event types or description.", "method": "PATCH", "path": "/publications/{publication_id}/webhooks/{endpoint_id}", "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "endpoint_id": { "type": "string" }, "event_types": { "type": "array", "items": { "type": "string" } }, "description": { "type": "string" } }, "required": ["publication_id", "endpoint_id"] } },
    { "name": "delete_webhook", "description": "Delete a publication webhook endpoint.", "method": "DELETE", "path": "/publications/{publication_id}/webhooks/{endpoint_id}", "input_schema": { "type": "object", "properties": { "publication_id": { "type": "string" }, "endpoint_id": { "type": "string" } }, "required": ["publication_id", "endpoint_id"] } }
  ],
  "webhooks": {
    "signature_header": "svix-signature",
    "events": [
      { "name": "subscription.created", "description": "A subscription was created." },
      { "name": "subscription.confirmed", "description": "A subscription was confirmed." },
      { "name": "subscription.upgraded", "description": "A subscriber upgraded to premium." },
      { "name": "subscription.downgraded", "description": "A subscriber downgraded from premium." },
      { "name": "subscription.deleted", "description": "A subscription was deleted." },
      { "name": "post.sent", "description": "A newsletter post was sent." },
      { "name": "post.updated", "description": "A post was updated." },
      { "name": "tier.created", "description": "A paid tier was created." },
      { "name": "tier.updated", "description": "A paid tier changed." },
      { "name": "newsletter_list_subscription.created", "description": "A subscriber joined a newsletter list." },
      { "name": "newsletter_list_subscription.deleted", "description": "A subscriber left a newsletter list." }
    ]
  }
}
