{
  "slug": "api-sports-mma",
  "name": "API-Sports (MMA)",
  "description": "Self-service MMA data API with schedules/results, statistics and documented lookup tools. Free plan advertises 100 requests/day per API; coverage and history depend on subscription. Odds tools, when present, read bookmaker prices and do not place bets. Register: https://dashboard.api-football.com/register . Docs: https://api-sports.io/documentation/mma/v1",
  "logo": "https://www.google.com/s2/favicons?domain=api-sports.io&sz=128",
  "categories": [
    "sports",
    "mma",
    "stats"
  ],
  "base_url": "https://v1.mma.api-sports.io",
  "auth": {
    "types": [
      "api_key"
    ],
    "headers": {
      "x-apisports-key": "{{api_key}}"
    },
    "credential_fields": [
      {
        "name": "api_key",
        "label": "API-Sports Key",
        "type": "password",
        "required": true,
        "description": "Direct API-Sports dashboard key for this sport; RapidAPI subscriptions use different authentication."
      }
    ]
  },
  "tools": [
    {
      "name": "status",
      "description": "Check account, subscription and daily request quota. This endpoint does not consume the daily quota.",
      "method": "GET",
      "path": "/status",
      "input_schema": {
        "type": "object",
        "properties": {}
      },
      "response_error": {
        "type": "json_status",
        "code_path": "response.subscription.active",
        "success_codes": [
          "true"
        ],
        "message_path": "errors"
      }
    },
    {
      "name": "list_seasons",
      "description": "List seasons. Full response includes errors, coverage and provider metadata; check errors before using results.",
      "method": "GET",
      "path": "/seasons",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "list_timezones",
      "description": "List timezones. Full response includes errors, coverage and provider metadata; check errors before using results.",
      "method": "GET",
      "path": "/timezone",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "list_categories",
      "description": "List categories. Full response includes errors, coverage and provider metadata; check errors before using results.",
      "method": "GET",
      "path": "/categories",
      "input_schema": {
        "type": "object",
        "properties": {
          "search": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    {
      "name": "list_teams",
      "description": "List teams. Full response includes errors, coverage and provider metadata; check errors before using results.",
      "method": "GET",
      "path": "/teams",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "search": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    {
      "name": "list_fighters",
      "description": "Find fighters. Supply at least one filter. Full response includes errors, coverage and provider metadata; check errors before using results.",
      "method": "GET",
      "path": "/fighters",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "team": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "search": {
            "type": "string",
            "minLength": 3
          }
        },
        "anyOf": [
          {
            "required": [
              "id"
            ]
          },
          {
            "required": [
              "team"
            ]
          },
          {
            "required": [
              "name"
            ]
          },
          {
            "required": [
              "category"
            ]
          },
          {
            "required": [
              "search"
            ]
          }
        ]
      }
    },
    {
      "name": "get_fighter_record",
      "description": "Get fighter record. Full response includes errors, coverage and provider metadata; check errors before using results.",
      "method": "GET",
      "path": "/fighters/records",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    {
      "name": "list_fights",
      "description": "Find fights. Supply id, date, season or fighter. Full response includes errors, coverage and provider metadata; check errors before using results.",
      "method": "GET",
      "path": "/fights",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "YYYY-MM-DD."
          },
          "season": {
            "type": "integer"
          },
          "fighter": {
            "type": "integer"
          },
          "category": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        },
        "anyOf": [
          {
            "required": [
              "id"
            ]
          },
          {
            "required": [
              "date"
            ]
          },
          {
            "required": [
              "season"
            ]
          },
          {
            "required": [
              "fighter"
            ]
          }
        ]
      }
    },
    {
      "name": "get_fight_results",
      "description": "Get results. Supply id, date or dash-separated ids (maximum 10). Full response includes errors, coverage and provider metadata; check errors before using results.",
      "method": "GET",
      "path": "/fights/results",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "ids": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "YYYY-MM-DD."
          }
        },
        "anyOf": [
          {
            "required": [
              "id"
            ]
          },
          {
            "required": [
              "ids"
            ]
          },
          {
            "required": [
              "date"
            ]
          }
        ]
      }
    },
    {
      "name": "get_fight_statistics",
      "description": "Get fighter statistics. Supply id, date or dash-separated ids (maximum 10). Full response includes errors, coverage and provider metadata; check errors before using results.",
      "method": "GET",
      "path": "/fights/statistics/fighters",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "ids": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "YYYY-MM-DD."
          }
        },
        "anyOf": [
          {
            "required": [
              "id"
            ]
          },
          {
            "required": [
              "ids"
            ]
          },
          {
            "required": [
              "date"
            ]
          }
        ]
      }
    },
    {
      "name": "get_odds",
      "description": "Read odds; supply fight or date. Full response includes errors, coverage and provider metadata; check errors before using results.",
      "method": "GET",
      "path": "/odds",
      "input_schema": {
        "type": "object",
        "properties": {
          "fight": {
            "type": "integer"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "YYYY-MM-DD."
          },
          "bookmaker": {
            "type": "integer"
          },
          "bet": {
            "type": "integer"
          }
        },
        "anyOf": [
          {
            "required": [
              "fight"
            ]
          },
          {
            "required": [
              "date"
            ]
          }
        ]
      }
    },
    {
      "name": "list_bookmakers",
      "description": "List bookmakers. Full response includes errors, coverage and provider metadata; check errors before using results.",
      "method": "GET",
      "path": "/odds/bookmakers",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "search": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    {
      "name": "list_bet_types",
      "description": "List bet types. Full response includes errors, coverage and provider metadata; check errors before using results.",
      "method": "GET",
      "path": "/odds/bets",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "search": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    }
  ],
  "health_check": {
    "tool": "status"
  }
}
