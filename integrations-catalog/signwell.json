{
  "slug": "signwell",
  "name": "SignWell",
  "description": "SignWell's API-first e-signature service for documents, templates, embedded signing, reminders, recipient corrections, completed files, bulk sends, and webhook registrations. Files are supplied as file_url or base64 objects inside typed JSON arrays.",
  "logo": "https://www.google.com/s2/favicons?domain=signwell.com&sz=128",
  "categories": ["e-signature", "documents", "contracts", "legal"],
  "base_url": "https://www.signwell.com/api/v1",
  "auth": {
    "types": ["api_key"],
    "headers": {"X-Api-Key": "{{api_key}}", "Accept": "application/json", "Content-Type": "application/json"},
    "credential_fields": [{"name": "api_key", "label": "SignWell API Key", "type": "password", "required": true}]
  },
  "health_check": {"tool": "get_me"},
  "tools": [
    {"name": "get_me", "description": "Validate the API key and return the current SignWell user and account.", "method": "GET", "path": "/me", "input_schema": {"type": "object", "properties": {}}},
    {
      "name": "create_document", "description": "Create a document from file URL/base64 objects and recipient objects. Set draft=false to send immediately, draft=true to prepare it, or embedded_signing=true to return embedded signing URLs.", "method": "POST", "path": "/documents",
      "input_schema": {"type": "object", "properties": {"files": {"type": "array", "items": {"type": "object"}, "description": "File objects with name and file_url or file_base64."}, "recipients": {"type": "array", "items": {"type": "object"}, "description": "Recipients with id, name, email, and optional send_email, send_sms, and signing_order."}, "name": {"type": "string"}, "subject": {"type": "string"}, "message": {"type": "string"}, "draft": {"type": "boolean"}, "embedded_signing": {"type": "boolean"}, "embedded_signing_notifications": {"type": "boolean"}, "fields": {"type": "array", "items": {"type": "object"}}, "text_tags": {"type": "boolean"}, "apply_signing_order": {"type": "boolean"}, "reminders": {"type": "boolean"}, "expires_in": {"type": "integer"}, "redirect_url": {"type": "string"}, "decline_redirect_url": {"type": "string"}, "allow_decline": {"type": "boolean"}, "allow_reassign": {"type": "boolean"}, "metadata": {"type": "object"}, "labels": {"type": "array", "items": {"type": "object"}}, "attachment_requests": {"type": "array", "items": {"type": "object"}}, "checkbox_groups": {"type": "array", "items": {"type": "object"}}, "conditional_rules": {"type": "array", "items": {"type": "object"}}, "language": {"type": "string"}, "test_mode": {"type": "boolean"}, "api_application_id": {"type": "string"}}, "required": ["files", "recipients"]}
    },
    {
      "name": "create_document_from_template", "description": "Create a document from one or more templates. Map each placeholder recipient and optional template field values; set embedded_signing for in-app signing.", "method": "POST", "path": "/document_templates/documents",
      "input_schema": {"type": "object", "properties": {"template_id": {"type": "string"}, "template_ids": {"type": "array", "items": {"type": "string"}}, "recipients": {"type": "array", "items": {"type": "object"}}, "template_fields": {"type": "array", "items": {"type": "object"}}, "files": {"type": "array", "items": {"type": "object"}}, "name": {"type": "string"}, "subject": {"type": "string"}, "message": {"type": "string"}, "draft": {"type": "boolean"}, "embedded_signing": {"type": "boolean"}, "embedded_signing_notifications": {"type": "boolean"}, "apply_signing_order": {"type": "boolean"}, "expires_in": {"type": "integer"}, "redirect_url": {"type": "string"}, "allow_decline": {"type": "boolean"}, "allow_reassign": {"type": "boolean"}, "metadata": {"type": "object"}, "test_mode": {"type": "boolean"}, "api_application_id": {"type": "string"}}, "required": ["recipients"]}
    },
    {"name": "get_document", "description": "Get document state, recipients, fields, and embedded signing URLs.", "method": "GET", "path": "/documents/{id}", "input_schema": {"type": "object", "properties": {"id": {"type": "string", "description": "Document ID."}}, "required": ["id"]}},
    {"name": "delete_document", "description": "Permanently delete a SignWell document.", "method": "DELETE", "path": "/documents/{id}", "input_schema": {"type": "object", "properties": {"id": {"type": "string", "description": "Document ID."}}, "required": ["id"]}},
    {"name": "send_document", "description": "Send a prepared draft document. Optional fields can update subject, message, requester identity, and notification behavior as it is sent.", "method": "POST", "path": "/documents/{id}/send", "input_schema": {"type": "object", "properties": {"id": {"type": "string", "description": "Document ID."}, "subject": {"type": "string"}, "message": {"type": "string"}, "custom_requester_name": {"type": "string"}, "custom_requester_email": {"type": "string"}, "embedded_signing_notifications": {"type": "boolean"}}, "required": ["id"]}},
    {"name": "send_reminder", "description": "Send a reminder to pending recipients. Supply recipient_email to target one recipient or omit it to remind all pending recipients allowed by SignWell.", "method": "POST", "path": "/documents/{id}/remind", "input_schema": {"type": "object", "properties": {"id": {"type": "string", "description": "Document ID."}, "recipient_email": {"type": "string"}}, "required": ["id"]}},
    {"name": "update_document_authentication", "description": "Update recipient verification settings such as password or SMS authentication on a draft document.", "method": "PATCH", "path": "/documents/{id}/authentication", "input_schema": {"type": "object", "properties": {"id": {"type": "string", "description": "Document ID."}, "recipients": {"type": "array", "items": {"type": "object"}}}, "required": ["id", "recipients"]}},
    {"name": "update_document_recipients", "description": "Correct recipient names, emails, or delivery settings for a document.", "method": "PATCH", "path": "/documents/{id}/recipients", "input_schema": {"type": "object", "properties": {"id": {"type": "string", "description": "Document ID."}, "recipients": {"type": "array", "items": {"type": "object"}}, "notify": {"type": "boolean"}}, "required": ["id", "recipients"]}},
    {"name": "get_completed_pdf", "description": "Get a completed document PDF/ZIP as a URL or encoded response. Use url_only=true for the smallest agent response.", "method": "GET", "path": "/documents/{id}/completed_pdf", "input_schema": {"type": "object", "properties": {"id": {"type": "string", "description": "Document ID."}, "url_only": {"type": "boolean"}, "audit_page": {"type": "boolean"}, "file_format": {"type": "string", "enum": ["PDF", "ZIP", "JSON"]}}, "required": ["id"]}},
    {"name": "get_nom151_certificate", "description": "Get the NOM-151 preservation certificate URL for a completed document when enabled for the account.", "method": "GET", "path": "/documents/{id}/nom151_certificate", "input_schema": {"type": "object", "properties": {"id": {"type": "string", "description": "Document ID."}, "url_only": {"type": "boolean"}}, "required": ["id"]}},
    {
      "name": "create_template", "description": "Create a reusable SignWell template from file URL/base64 objects and placeholder roles.", "method": "POST", "path": "/document_templates",
      "input_schema": {"type": "object", "properties": {"files": {"type": "array", "items": {"type": "object"}}, "placeholders": {"type": "array", "items": {"type": "object"}}, "name": {"type": "string"}, "subject": {"type": "string"}, "message": {"type": "string"}, "fields": {"type": "array", "items": {"type": "object"}}, "text_tags": {"type": "boolean"}, "apply_signing_order": {"type": "boolean"}, "reminders": {"type": "boolean"}, "expires_in": {"type": "integer"}, "redirect_url": {"type": "string"}, "allow_decline": {"type": "boolean"}, "allow_reassign": {"type": "boolean"}, "metadata": {"type": "object"}, "labels": {"type": "array", "items": {"type": "object"}}, "attachment_requests": {"type": "array", "items": {"type": "object"}}, "checkbox_groups": {"type": "array", "items": {"type": "object"}}, "conditional_rules": {"type": "array", "items": {"type": "object"}}, "language": {"type": "string"}, "api_application_id": {"type": "string"}}, "required": ["files", "placeholders"]}
    },
    {"name": "get_template", "description": "Get a template's placeholders, fields, files, and settings.", "method": "GET", "path": "/document_templates/{id}", "input_schema": {"type": "object", "properties": {"id": {"type": "string", "description": "Template ID."}}, "required": ["id"]}},
    {"name": "update_template", "description": "Replace or update template files, placeholders, fields, and delivery settings.", "method": "PUT", "path": "/document_templates/{id}", "input_schema": {"type": "object", "properties": {"id": {"type": "string", "description": "Template ID."}, "files": {"type": "array", "items": {"type": "object"}}, "placeholders": {"type": "array", "items": {"type": "object"}}, "name": {"type": "string"}, "subject": {"type": "string"}, "message": {"type": "string"}, "fields": {"type": "array", "items": {"type": "object"}}, "apply_signing_order": {"type": "boolean"}, "metadata": {"type": "object"}}, "required": ["id"]}},
    {"name": "delete_template", "description": "Permanently delete a SignWell template.", "method": "DELETE", "path": "/document_templates/{id}", "input_schema": {"type": "object", "properties": {"id": {"type": "string", "description": "Template ID."}}, "required": ["id"]}},
    {"name": "list_webhooks", "description": "List webhook registrations.", "method": "GET", "path": "/hooks", "input_schema": {"type": "object", "properties": {}}},
    {"name": "create_webhook", "description": "Register an HTTPS callback for SignWell document events. Optionally scope it to an API application.", "method": "POST", "path": "/hooks", "input_schema": {"type": "object", "properties": {"callback_url": {"type": "string"}, "api_application_id": {"type": "string"}}, "required": ["callback_url"]}},
    {"name": "delete_webhook", "description": "Delete a webhook registration.", "method": "DELETE", "path": "/hooks/{id}", "input_schema": {"type": "object", "properties": {"id": {"type": "string", "description": "Webhook ID."}}, "required": ["id"]}},
    {"name": "list_bulk_sends", "description": "List bulk-send jobs.", "method": "GET", "path": "/bulk_sends", "input_schema": {"type": "object", "properties": {"page": {"type": "integer"}, "limit": {"type": "integer"}}}},
    {"name": "create_bulk_send", "description": "Create a template-based bulk-send job. bulk_send_csv is the base64 CSV content matching SignWell's generated CSV template.", "method": "POST", "path": "/bulk_sends", "input_schema": {"type": "object", "properties": {"template_ids": {"type": "array", "items": {"type": "string"}}, "bulk_send_csv": {"type": "string"}, "name": {"type": "string"}, "subject": {"type": "string"}, "message": {"type": "string"}, "apply_signing_order": {"type": "boolean"}, "skip_row_errors": {"type": "boolean"}, "api_application_id": {"type": "string"}}, "required": ["template_ids", "bulk_send_csv"]}},
    {"name": "get_bulk_send", "description": "Get one bulk-send job and its processing status.", "method": "GET", "path": "/bulk_sends/{id}", "input_schema": {"type": "object", "properties": {"id": {"type": "string", "description": "Bulk-send ID."}}, "required": ["id"]}},
    {"name": "get_bulk_send_documents", "description": "List documents generated by a bulk-send job.", "method": "GET", "path": "/bulk_sends/{id}/documents", "input_schema": {"type": "object", "properties": {"id": {"type": "string", "description": "Bulk-send ID."}, "page": {"type": "integer"}, "limit": {"type": "integer"}}, "required": ["id"]}},
    {"name": "get_bulk_send_csv_template", "description": "Generate the CSV template required for a bulk send from one or more template IDs.", "method": "GET", "path": "/bulk_sends/csv_template", "input_schema": {"type": "object", "properties": {"template_ids": {"type": "array", "items": {"type": "string"}}, "base64": {"type": "boolean"}}, "required": ["template_ids"]}}
  ]
}
