          }
        }
      }
    },
    {
      "name": "list_changes",
      "description": "List changes.",
      "method": "GET",
      "path": "/changes",
      "input_schema": {
        "type": "object",
        "properties": {
          "updated_since": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          }
        }
      }
    },
    {
      "name": "list_releases",
      "description": "List releases.",
      "method": "GET",
      "path": "/releases",
      "input_schema": {
        "type": "object",
        "properties": {
          "updated_since": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          }
        }
      }
    }
  ]
}
