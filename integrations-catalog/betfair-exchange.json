    {
      "name": "get_market_book",
      "description": "Get prices and market status. Keep price ladders and available sizes; respect Betfair market-data request weights.",
      "method": "POST",
      "path": "/listMarketBook/",
      "input_schema": {
        "type": "object",
        "properties": {
          "marketIds": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Market ID."
            }
          },
          "priceProjection": {
            "type": "object",
            "properties": {
              "priceData": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "SP_AVAILABLE",
                    "SP_TRADED",
                    "EX_BEST_OFFERS",
                    "EX_ALL_OFFERS",
                    "EX_TRADED"
                  ]
                }
              },
              "virtualise": {
                "type": "boolean"
              },
              "rolloverStakes": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "required": [
              "priceData"
            ]
          },
          "currencyCode": {
            "type": "string",
            "description": "ISO currency code."
          },
          "locale": {
            "type": "string"
          }
        },
        "required": [
          "marketIds",
          "priceProjection"
        ],
        "additionalProperties": false
      },
      "rate_limit": {
        "min_interval_ms": 1000,
        "max_retries": 1,
        "retry_statuses": [
          429
        ]
      }
    }
