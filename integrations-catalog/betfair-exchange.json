{
  "slug": "betfair-exchange",
  "name": "Betfair Exchange Market Data",
  "description": "Official Betfair Exchange REST API for market discovery and back/lay prices. Requires a Betfair application key and valid session token. Delayed development, live access and commercial data rights differ. Read-only operations use HTTP POST; no orders or wagering tools are included. Docs: https://developer.betfair.com/ and https://betfair-developer-docs.atlassian.net/",
  "logo": "https://www.google.com/s2/favicons?domain=betfair.com&sz=128",
  "categories": [
    "sports",
    "betting",
    "exchange",
    "odds"
  ],
  "base_url": "https://api.betfair.com/exchange/betting/rest/v1.0",
  "auth": {
    "types": [
      "custom"
    ],
    "headers": {
      "X-Application": "{{app_key}}",
      "X-Authentication": "{{session_token}}",
      "Content-Type": "application/json"
    },
    "credential_fields": [
      {
        "name": "app_key",
        "label": "Application key",
        "description": "Betfair delayed or live application key. Live/commercial access requires the appropriate approval.",
        "required": true
      },
      {
        "name": "session_token",
        "label": "Session token",
        "description": "Current Betfair session token obtained through the official login API. Replace when it expires. This integration only reads market data.",
        "required": true
      }
    ]
  },
  "tools": [
    {
      "name": "list_event_types",
      "description": "List sports/event types matching the filter. An empty filter lists all available event types.",
      "method": "POST",
      "path": "/listEventTypes/",
      "input_schema": {
        "type": "object",
        "properties": {
          "filter": {
            "type": "object",
            "properties": {
              "textQuery": {
                "type": "string"
              },
              "eventTypeIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "eventIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "competitionIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "marketIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "marketTypeCodes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "marketCountries": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "venues": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "inPlayOnly": {
                "type": "boolean"
              },
              "marketStartTime": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string",
                    "description": "ISO 8601 UTC start."
                  },
                  "to": {
                    "type": "string",
                    "description": "ISO 8601 UTC end."
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "locale": {
            "type": "string"
          }
        },
        "required": [
          "filter"
        ],
        "additionalProperties": false
      },
      "rate_limit": {
        "min_interval_ms": 1000,
        "max_retries": 1,
        "retry_statuses": [
          429
        ]
      }
    },
