{
  "slug": "cjdropshipping",
  "name": "CJ Dropshipping",
  "description": "CJ Dropshipping supplier catalog and fulfillment API. Search products, inspect variants, check stock, estimate shipping, and create dropshipping orders from CJ's product catalog.",
  "logo": "https://www.google.com/s2/favicons?domain=cjdropshipping.com&sz=128",
  "categories": [
    "dropshipping",
    "ecommerce",
    "products",
    "supplier-catalog",
    "fulfillment",
    "inventory"
  ],
  "base_url": "https://developers.cjdropshipping.com/api2.0/v1",
  "auth": {
    "types": [
      "api_key"
    ],
    "token_exchange": {
      "url": "https://developers.cjdropshipping.com/api2.0/v1/authentication/getAccessToken",
      "method": "POST",
      "content_type": "application/json",
      "body_params": {
        "apiKey": "{{credential.api_key}}"
      },
      "access_token_path": "data.accessToken",
      "expires_at_path": "data.accessTokenExpiryDate",
      "expiry_skew_seconds": 300
    },
    "headers": {
      "CJ-Access-Token": "{{access_token}}",
      "Content-Type": "application/json"
    },
    "credential_fields": [
      {
        "name": "api_key",
        "label": "CJ API Key",
        "description": "API key from CJ Dropshipping's API app. Apteva exchanges it for access tokens automatically.",
        "required": true,
        "type": "password"
      }
    ]
  },
  "tools": [
    {
      "name": "categories_list",
      "description": "List CJ product categories. Use before product search to discover category IDs.",
      "method": "GET",
      "path": "/product/getCategory",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "products_search",
      "description": "Search CJ Dropshipping's Product List V2 catalog. Supports keyword/SKU, category, warehouse country, price, inventory, product attributes, sorting, and pagination. The integration maps its stable agent-facing field names to CJ's V2 query parameter names.",
      "method": "GET",
      "path": "/product/listV2",
      "query_params": [
        "categoryId",
        "lv2categoryList",
        "lv3categoryList",
        "countryCode",
        "startSellPrice",
        "endSellPrice",
        "addMarkStatus",
        "productType",
        "productFlag",
        "verifiedWarehouse",
        "timeStart",
        "timeEnd",
        "zonePlatform",
        "isWarehouse",
        "sort",
        "features",
        "supplierId",
        "hasCertification",
        "isSelfPickup",
        "customization"
      ],
      "query_param_aliases": {
        "pageNum": "page",
        "pageSize": "size",
        "productNameEn": "keyWord",
        "minInventory": "startWarehouseInventory",
        "maxInventory": "endWarehouseInventory",
        "sortBy": "orderBy"
      },
      "rate_limit": {
        "min_interval_ms": 1000,
        "max_retries": 2,
        "retry_statuses": [
          429
        ],
        "retry_error_codes": [
          1600200
        ]
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "pageNum": {
            "type": "integer",
            "default": 1,
            "minimum": 1,
            "maximum": 1000,
            "description": "Page number, starting at 1."
          },
          "pageSize": {
            "type": "integer",
            "default": 10,
            "minimum": 1,
            "maximum": 100,
            "description": "Products per page. CJ Product List V2 accepts 1-100 and defaults to 10."
          },
          "productNameEn": {
            "type": "string",
            "maxLength": 200,
            "description": "Product name or SKU keyword. Sent to CJ as keyWord."
          },
          "categoryId": {
            "type": "string",
            "description": "CJ third-level category ID from categories_list."
          },
          "lv2categoryList": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "CJ second-level category IDs."
          },
          "lv3categoryList": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "CJ third-level category IDs."
          },
          "countryCode": {
            "type": "string",
            "description": "Country code for products with inventory there, for example US, GB, or FR."
          },
          "startSellPrice": {
            "type": "number",
            "minimum": 0,
            "description": "Minimum selling price in USD."
          },
          "endSellPrice": {
            "type": "number",
            "minimum": 0,
            "description": "Maximum selling price in USD."
          },
          "addMarkStatus": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "Free-shipping filter: 0 means not free shipping; 1 means free shipping."
          },
          "productType": {
            "type": "integer",
            "enum": [
              4,
              10,
              11
            ],
            "description": "Product type: 4 supplier product, 10 video product, or 11 non-video product."
          },
          "productFlag": {
            "type": "integer",
            "enum": [
              0,
              1,
              2,
              3
            ],
            "description": "Product flag: 0 trending, 1 new, 2 video, or 3 slow-moving."
          },
          "minInventory": {
            "type": "integer",
            "minimum": 0,
            "description": "Minimum warehouse inventory. Sent to CJ as startWarehouseInventory."
          },
          "maxInventory": {
            "type": "integer",
            "minimum": 0,
            "description": "Maximum warehouse inventory. Sent to CJ as endWarehouseInventory."
          },
          "verifiedWarehouse": {
            "type": "integer",
            "enum": [
              0,
              1,
              2
            ],
            "description": "Inventory verification: 0 all, 1 verified, or 2 unverified."
          },
          "timeStart": {
            "type": "integer",
            "minimum": 0,
            "description": "Earliest product listing timestamp in milliseconds."
          },
          "timeEnd": {
            "type": "integer",
            "minimum": 0,
            "description": "Latest product listing timestamp in milliseconds."
          },
          "zonePlatform": {
            "type": "string",
            "description": "Target platform suggestion such as shopify, ebay, amazon, tiktok, or etsy."
          },
          "isWarehouse": {
            "type": "boolean",
            "description": "Whether to search global-warehouse products."
          },
          "sortBy": {
            "type": "integer",
            "enum": [
              0,
              1,
              2,
              3,
              4
            ],
            "description": "Sort field: 0 best match, 1 listing count, 2 sell price, 3 creation time, or 4 inventory. Sent to CJ as orderBy."
          },
          "sort": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ],
            "description": "Sort direction; defaults to descending at CJ."
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "enable_description",
                "enable_category",
                "enable_combine",
                "enable_video"
              ]
            },
            "description": "Optional response expansions for descriptions, category names, combined-product data, or video IDs."
          },
          "supplierId": {
            "type": "string",
            "description": "CJ supplier ID."
          },
          "hasCertification": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "Certification filter: 0 no, 1 yes."
          },
          "isSelfPickup": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "Self-pickup filter: 0 no, 1 yes."
          },
          "customization": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "Customization-product filter: 0 no, 1 yes."
          }
        }
      }
    },
    {
      "name": "product_get",
      "description": "Fetch detailed product data from CJ by product ID, including images, descriptions, and variant references.",
      "method": "GET",
      "path": "/product/query",
      "input_schema": {
        "type": "object",
        "properties": {
          "pid": {
            "type": "string",
            "description": "CJ product ID."
          }
        },
        "required": [
          "pid"
        ]
      }
    },
    {
      "name": "product_variants_list",
      "description": "List variants for a CJ product. Variants usually carry SKU/VID, option values, weight, and price information used for catalog import.",
      "method": "GET",
      "path": "/product/variant/queryByPid",
      "input_schema": {
        "type": "object",
        "properties": {
          "pid": {
            "type": "string",
            "description": "CJ product ID."
          }
        },
        "required": [
          "pid"
        ]
      }
    },
    {
      "name": "variant_get",
      "description": "Fetch one CJ variant by variant ID. Use when search results already include a VID and you need normalized variant details.",
      "method": "GET",
      "path": "/product/variant/query",
      "input_schema": {
        "type": "object",
        "properties": {
          "vid": {
            "type": "string",
            "description": "CJ variant ID."
          }
        },
        "required": [
          "vid"
        ]
      }
    },
    {
      "name": "inventory_get",
      "description": "Check CJ inventory for one or more product variants. Use before importing or quoting sellable products.",
      "method": "GET",
      "path": "/product/stock/queryByVid",
      "input_schema": {
        "type": "object",
        "properties": {
          "vid": {
            "type": "string",
            "description": "CJ variant ID."
          }
        },
        "required": [
          "vid"
        ]
      }
    },
    {
      "name": "shipping_calculate",
      "description": "Calculate available CJ shipping methods, USD costs, and delivery estimates for one or more variants. Use an inventory country as startCountryCode and the customer destination as endCountryCode.",
      "method": "POST",
      "path": "/logistic/freightCalculate",
      "response_error": {
        "type": "json_status",
        "code_path": "code",
        "success_codes": [
          200
        ],
        "failure_flag_paths": [
          "success",
          "result"
        ],
        "message_path": "message"
      },
      "rate_limit": {
        "min_interval_ms": 1000,
        "max_retries": 2,
        "retry_statuses": [
          429
        ],
        "retry_error_codes": [
          1600200
        ]
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "startCountryCode": {
            "type": "string",
            "minLength": 2,
            "description": "Two-letter origin country code for a warehouse holding the product, for example CN or US. Determine this from inventory_get or the product inventory response."
          },
          "endCountryCode": {
            "type": "string",
            "minLength": 2,
            "description": "Two-letter destination country code, for example US."
          },
          "zip": {
            "type": "string",
            "description": "Destination postal/zip code when required."
          },
          "taxId": {
            "type": "string",
            "description": "Destination tax ID when required."
          },
          "houseNumber": {
            "type": "string",
            "description": "Destination house number when required."
          },
          "iossNumber": {
            "type": "string",
            "description": "IOSS number for applicable EU shipments."
          },
          "storageIdList": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "description": "Optional CJ storage IDs to restrict the quote."
          },
          "shippingMode": {
            "type": "integer",
            "enum": [
              1,
              2
            ],
            "description": "1 for platform logistics or 2 for merchant logistics. When set to 1, platforms is required."
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Platform types used with shippingMode=1, such as tiktok_us or Temu."
          },
          "products": {
            "type": "array",
            "minItems": 1,
            "description": "CJ variants and supplier-unit quantities to include in the shipping quote.",
            "items": {
              "type": "object",
              "properties": {
                "vid": {
                  "type": "string",
                  "description": "CJ variant ID."
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Supplier-unit quantity for this variant."
                }
              },
              "required": [
                "vid",
                "quantity"
              ]
            }
          }
        },
        "required": [
          "startCountryCode",
          "endCountryCode",
          "products"
        ]
      }
    },
    {
      "name": "orders_create",
      "description": "Create a CJ dropshipping order. Use after a local checkout/order flow has selected a CJ variant and collected shipping details.",
      "method": "POST",
      "path": "/shopping/order/createOrder",
      "input_schema": {
        "type": "object",
        "properties": {
          "orderNumber": {
            "type": "string",
            "description": "Your external order reference."
          },
          "shippingAddress": {
            "type": "object",
            "description": "Destination address object accepted by CJ."
          },
          "products": {
            "type": "array",
            "description": "Order line items with CJ variant IDs and quantities.",
            "items": {
              "type": "object",
              "properties": {
                "vid": {
                  "type": "string",
                  "description": "CJ variant ID."
                },
                "quantity": {
                  "type": "integer"
                }
              },
              "required": [
                "vid",
                "quantity"
              ]
            }
          }
        },
        "required": [
          "orderNumber",
          "shippingAddress",
          "products"
        ]
      }
    },
    {
      "name": "order_get",
      "description": "Get a CJ order by order ID or order number to inspect fulfillment state and tracking information.",
      "method": "GET",
      "path": "/shopping/order/getOrderDetail",
      "input_schema": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "description": "CJ order ID."
          },
          "orderNumber": {
            "type": "string",
            "description": "Your external order reference."
          }
        }
      }
    }
  ],
  "health_check": {
    "tool": "categories_list"
  }
}
