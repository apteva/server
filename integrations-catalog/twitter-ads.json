    },
    {
      "name": "list_targeting_criteria", "description": "List targeting criteria attached to line items.", "method": "GET", "path": "/accounts/{account_id}/targeting_criteria",
      "input_schema": {"type": "object", "properties": {"account_id": {"type": "string"}, "line_item_ids": {"type": "string"}, "targeting_criterion_ids": {"type": "string"}, "count": {"type": "integer"}, "cursor": {"type": "string"}, "with_deleted": {"type": "boolean"}}, "required": ["account_id"]}
    },
    {
      "name": "create_targeting_criteria", "description": "Create one or more targeting criteria for a line item.", "method": "POST", "path": "/accounts/{account_id}/targeting_criteria", "headers": {"Content-Type": "application/x-www-form-urlencoded"},
      "input_schema": {"type": "object", "properties": {"account_id": {"type": "string"}, "line_item_id": {"type": "string"}, "targeting_type": {"type": "string"}, "targeting_value": {"type": "string"}, "operator_type": {"type": "string", "enum": ["INCLUDE", "EXCLUDE"]}}, "required": ["account_id", "line_item_id", "targeting_type", "targeting_value"]}
