    {
      "name": "list_targeting_platforms", "description": "List targetable platforms.", "method": "GET", "path": "/targeting_criteria/platforms", "input_schema": {"type": "object", "properties": {}}
    },
    {
      "name": "list_targeting_devices", "description": "List targetable devices.", "method": "GET", "path": "/targeting_criteria/devices", "input_schema": {"type": "object", "properties": {}}
