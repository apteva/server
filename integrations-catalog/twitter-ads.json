    },
    {
      "name": "media_upload_finalize", "description": "Finalize a chunked media upload and begin processing.", "method": "POST", "base_url": "https://upload.x.com/1.1", "path": "/media/upload.json", "headers": {"Content-Type": "application/x-www-form-urlencoded"},
      "input_schema": {"type": "object", "properties": {"command": {"type": "string", "enum": ["FINALIZE"]}, "media_id": {"type": "string"}}, "required": ["command", "media_id"]}
    },
    {
      "name": "media_upload_status", "description": "Poll processing status for chunked uploaded media.", "method": "GET", "base_url": "https://upload.x.com/1.1", "path": "/media/upload.json",
      "input_schema": {"type": "object", "properties": {"command": {"type": "string", "enum": ["STATUS"]}, "media_id": {"type": "string"}}, "required": ["command", "media_id"]}
    },
