      "name": "create_promoted_tweet", "description": "Associate one or more X posts with a line item.", "method": "POST", "path": "/accounts/{account_id}/promoted_tweets", "headers": {"Content-Type": "application/x-www-form-urlencoded"},
      "input_schema": {"type": "object", "properties": {"account_id": {"type": "string"}, "line_item_id": {"type": "string"}, "tweet_ids": {"type": "string"}}, "required": ["account_id", "line_item_id", "tweet_ids"]}
    },
    {
