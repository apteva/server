      "input_schema": {"type": "object", "properties": {"account_id": {"type": "string"}, "tweet_ids": {"type": "string"}, "timeline_type": {"type": "string"}, "count": {"type": "integer"}, "cursor": {"type": "string"}}, "required": ["account_id"]}
    },
    {
      "name": "create_tweet", "description": "Create a promoted-only X post for this account.", "method": "POST", "path": "/accounts/{account_id}/tweet", "headers": {"Content-Type": "application/x-www-form-urlencoded"},
      "input_schema": {"type": "object", "properties": {"account_id": {"type": "string"}, "text": {"type": "string"}, "media_ids": {"type": "string"}, "card_uri": {"type": "string"}, "as_user_id": {"type": "string"}, "nullcast": {"type": "boolean"}}, "required": ["account_id", "text"]}
    },
    {
      "name": "upload_media", "description": "Upload image, GIF, or video bytes for an X creative.", "method": "POST", "base_url": "https://upload.x.com/1.1", "path": "/media/upload.json",
      "multipart_form": {"file_fields": {"media": "media"}, "field_names": ["media_category", "additional_owners"]},
      "input_schema": {"type": "object", "properties": {"media": {"type": "string", "description": "Base64, data URL, or blob reference."}, "media_category": {"type": "string"}, "additional_owners": {"type": "string"}}, "required": ["media"]}
    },
    {
      "name": "media_upload_init", "description": "Initialize a chunked GIF or video upload.", "method": "POST", "base_url": "https://upload.x.com/1.1", "path": "/media/upload.json", "headers": {"Content-Type": "application/x-www-form-urlencoded"},
      "input_schema": {"type": "object", "properties": {"command": {"type": "string", "enum": ["INIT"]}, "total_bytes": {"type": "integer"}, "media_type": {"type": "string"}, "media_category": {"type": "string"}, "additional_owners": {"type": "string"}}, "required": ["command", "total_bytes", "media_type", "media_category"]}
    },
    {
      "name": "media_upload_append", "description": "Append one binary segment to a chunked media upload.", "method": "POST", "base_url": "https://upload.x.com/1.1", "path": "/media/upload.json",
      "multipart_form": {"file_fields": {"media": "media"}, "field_names": ["command", "media_id", "segment_index"]},
