      "input_schema": {"type": "object", "properties": {"account_id": {"type": "string"}, "campaign_id": {"type": "string"}, "name": {"type": "string"}, "product_type": {"type": "string"}, "objective": {"type": "string"}, "placements": {"type": "array", "items": {"type": "string"}}, "entity_status": {"type": "string"}, "bid_amount_local_micro": {"type": "integer"}, "bid_type": {"type": "string"}, "total_budget_amount_local_micro": {"type": "integer"}, "start_time": {"type": "string"}, "end_time": {"type": "string"}, "advertiser_domain": {"type": "string"}}, "required": ["account_id", "campaign_id", "product_type", "objective", "placements"]}
    },
    {
      "name": "update_line_item", "description": "Update a line item or change its status.", "method": "PUT", "path": "/accounts/{account_id}/line_items/{line_item_id}", "headers": {"Content-Type": "application/x-www-form-urlencoded"},
      "input_schema": {"type": "object", "properties": {"account_id": {"type": "string"}, "line_item_id": {"type": "string"}, "name": {"type": "string"}, "entity_status": {"type": "string"}, "bid_amount_local_micro": {"type": "integer"}, "bid_type": {"type": "string"}, "total_budget_amount_local_micro": {"type": "integer"}, "end_time": {"type": "string"}, "advertiser_domain": {"type": "string"}}, "required": ["account_id", "line_item_id"]}
    },
    {
      "name": "delete_line_item", "description": "Delete a line item.", "method": "DELETE", "path": "/accounts/{account_id}/line_items/{line_item_id}",
      "input_schema": {"type": "object", "properties": {"account_id": {"type": "string"}, "line_item_id": {"type": "string"}}, "required": ["account_id", "line_item_id"]}
    },
