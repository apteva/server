      "input_schema": {"type": "object", "properties": {"account_id": {"type": "string"}, "line_item_ids": {"type": "string"}, "promoted_tweet_ids": {"type": "string"}, "count": {"type": "integer"}, "cursor": {"type": "string"}, "with_deleted": {"type": "boolean"}}, "required": ["account_id"]}
