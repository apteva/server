{
  "slug": "twitter-ads",
  "name": "X Ads",
  "description": "X Ads API v12 for accounts, campaigns, line items, promoted posts, targeting, creatives, audiences, and analytics.",
  "logo": "https://www.google.com/s2/favicons?domain=x.com&sz=128",
  "categories": ["advertising", "marketing", "campaigns", "social-ads", "x"],
  "base_url": "https://ads-api.x.com/12",
  "auth": {
    "types": ["oauth1"],
    "credential_fields": [
      {"name": "oauth_token", "label": "OAuth access token", "source": "oauth", "hidden": true},
      {"name": "oauth_token_secret", "label": "OAuth access token secret", "source": "oauth", "hidden": true},
      {"name": "user_id", "label": "X user ID", "source": "oauth", "hidden": true, "exposure": "public"},
      {"name": "screen_name", "label": "X username", "source": "oauth", "hidden": true, "exposure": "public"}
    ],
    "oauth1": {
      "request_token_url": "https://api.x.com/oauth/request_token",
      "authorize_url": "https://api.x.com/oauth/authorize",
      "access_token_url": "https://api.x.com/oauth/access_token",
      "client_id_required": true,
      "signature_method": "HMAC-SHA1",
      "setup_url": "https://developer.x.com/en/portal/dashboard",
      "setup_steps": [
        "Create an X developer project and app with read and write access.",
        "Request Standard Ads API Access for the app.",
        "Add the callback URL shown here to the app authentication settings.",
        "Use the app API key as client ID and API key secret as client secret."
      ]
    },
    "signers": [{"name": "oauth1"}]
  },
  "tools": [
    {
      "name": "list_accounts", "description": "List advertising accounts accessible to the authenticated X user.", "method": "GET", "path": "/accounts",
      "input_schema": {"type": "object", "properties": {"account_ids": {"type": "string"}, "count": {"type": "integer", "minimum": 1, "maximum": 1000}, "cursor": {"type": "string"}}}
    },
    {
      "name": "get_account", "description": "Get an X advertising account.", "method": "GET", "path": "/accounts/{account_id}",
      "input_schema": {"type": "object", "properties": {"account_id": {"type": "string"}}, "required": ["account_id"]}
    },
    {
      "name": "get_authenticated_user_access", "description": "Get the authenticated user's access level for an account.", "method": "GET", "path": "/accounts/{account_id}/authenticated_user_access",
      "input_schema": {"type": "object", "properties": {"account_id": {"type": "string"}}, "required": ["account_id"]}
    },
    {
      "name": "list_promotable_users", "description": "List X users that this account may promote.", "method": "GET", "path": "/accounts/{account_id}/promotable_users",
      "input_schema": {"type": "object", "properties": {"account_id": {"type": "string"}, "count": {"type": "integer"}, "cursor": {"type": "string"}}, "required": ["account_id"]}
    },
    {
      "name": "list_funding_instruments", "description": "List account funding instruments.", "method": "GET", "path": "/accounts/{account_id}/funding_instruments",
      "input_schema": {"type": "object", "properties": {"account_id": {"type": "string"}, "count": {"type": "integer"}, "cursor": {"type": "string"}, "with_deleted": {"type": "boolean"}}, "required": ["account_id"]}
    },
    {
      "name": "list_campaigns", "description": "List campaigns for an X Ads account.", "method": "GET", "path": "/accounts/{account_id}/campaigns",
      "input_schema": {"type": "object", "properties": {"account_id": {"type": "string"}, "campaign_ids": {"type": "string"}, "count": {"type": "integer", "maximum": 1000}, "cursor": {"type": "string"}, "with_deleted": {"type": "boolean"}, "with_total_count": {"type": "boolean"}, "sort_by": {"type": "string"}}, "required": ["account_id"]}
    },
    {
      "name": "get_campaign", "description": "Get a campaign.", "method": "GET", "path": "/accounts/{account_id}/campaigns/{campaign_id}",
      "input_schema": {"type": "object", "properties": {"account_id": {"type": "string"}, "campaign_id": {"type": "string"}, "with_deleted": {"type": "boolean"}}, "required": ["account_id", "campaign_id"]}
    },
    {
      "name": "create_campaign", "description": "Create an X campaign. Monetary values use local currency micros.", "method": "POST", "path": "/accounts/{account_id}/campaigns", "headers": {"Content-Type": "application/x-www-form-urlencoded"},
      "input_schema": {"type": "object", "properties": {"account_id": {"type": "string"}, "funding_instrument_id": {"type": "string"}, "name": {"type": "string"}, "entity_status": {"type": "string", "enum": ["ACTIVE", "PAUSED", "DRAFT"]}, "daily_budget_amount_local_micro": {"type": "integer"}, "total_budget_amount_local_micro": {"type": "integer"}, "start_time": {"type": "string"}, "end_time": {"type": "string"}, "standard_delivery": {"type": "boolean"}, "frequency_cap": {"type": "integer"}}, "required": ["account_id", "funding_instrument_id", "name"]}
    },
    {
      "name": "update_campaign", "description": "Update a campaign or change its status.", "method": "PUT", "path": "/accounts/{account_id}/campaigns/{campaign_id}", "headers": {"Content-Type": "application/x-www-form-urlencoded"},
      "input_schema": {"type": "object", "properties": {"account_id": {"type": "string"}, "campaign_id": {"type": "string"}, "name": {"type": "string"}, "entity_status": {"type": "string", "enum": ["ACTIVE", "PAUSED"]}, "daily_budget_amount_local_micro": {"type": "integer"}, "total_budget_amount_local_micro": {"type": "integer"}, "end_time": {"type": "string"}, "frequency_cap": {"type": "integer"}}, "required": ["account_id", "campaign_id"]}
    },
    {
      "name": "delete_campaign", "description": "Delete an X campaign.", "method": "DELETE", "path": "/accounts/{account_id}/campaigns/{campaign_id}",
      "input_schema": {"type": "object", "properties": {"account_id": {"type": "string"}, "campaign_id": {"type": "string"}}, "required": ["account_id", "campaign_id"]}
    },
    {
      "name": "list_line_items", "description": "List line items (ad groups) for an account.", "method": "GET", "path": "/accounts/{account_id}/line_items",
      "input_schema": {"type": "object", "properties": {"account_id": {"type": "string"}, "campaign_ids": {"type": "string"}, "line_item_ids": {"type": "string"}, "count": {"type": "integer"}, "cursor": {"type": "string"}, "with_deleted": {"type": "boolean"}}, "required": ["account_id"]}
    },
