      "input_schema": {"type": "object", "properties": {"count": {"type": "integer"}, "cursor": {"type": "string"}}}
    },
    {
      "name": "list_targeting_languages", "description": "List targetable languages.", "method": "GET", "path": "/targeting_criteria/languages", "input_schema": {"type": "object", "properties": {}}
