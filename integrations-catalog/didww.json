{
  "slug": "didww",
  "name": "DIDWW",
  "description": "DIDWW API v3 for DID coverage and ordering, owned numbers, inbound and outbound SIP trunks, capacity, regulatory resources, emergency services, and CDR exports.",
  "logo": "https://www.google.com/s2/favicons?domain=didww.com&sz=128",
  "categories": ["telephony", "voice", "sip", "phone", "communications", "carrier"],
  "base_url": "https://api.didww.com/v3",
  "auth": {
    "types": ["api_key"],
    "headers": {
      "Api-Key": "{{api_key}}",
      "Accept": "application/vnd.api+json",
      "Content-Type": "application/vnd.api+json"
    },
    "credential_fields": [
      { "name": "api_key", "label": "API Token", "description": "DIDWW API token from the user panel.", "type": "password", "required": true }
    ]
  },
  "health_check": { "tool": "get_balance" },
  "tools": [
    { "name": "get_balance", "description": "Get prepaid balance and available account credit.", "method": "GET", "path": "/balance", "input_schema": { "type": "object", "properties": {} } },

    { "name": "list_countries", "description": "List countries in DIDWW DID inventory.", "method": "GET", "path": "/countries", "query_params": ["include", "page_number", "page_size"], "query_param_aliases": { "page_number": "page[number]", "page_size": "page[size]" }, "input_schema": { "type": "object", "properties": { "include": { "type": "string" }, "page_number": { "type": "integer" }, "page_size": { "type": "integer" } } } },
    { "name": "get_country", "description": "Get one inventory country.", "method": "GET", "path": "/countries/{id}", "path_params": ["id"], "query_params": ["include"], "input_schema": { "type": "object", "properties": { "id": { "type": "string" }, "include": { "type": "string" } }, "required": ["id"] } },
    { "name": "list_regions", "description": "List inventory regions, optionally filtered by country.", "method": "GET", "path": "/regions", "query_params": ["country_id", "page_number", "page_size"], "query_param_aliases": { "country_id": "filter[country.id]", "page_number": "page[number]", "page_size": "page[size]" }, "input_schema": { "type": "object", "properties": { "country_id": { "type": "string" }, "page_number": { "type": "integer" }, "page_size": { "type": "integer" } } } },
    { "name": "get_region", "description": "Get one inventory region.", "method": "GET", "path": "/regions/{id}", "path_params": ["id"], "input_schema": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"] } },
    { "name": "list_cities", "description": "List inventory cities, optionally filtered by country or region.", "method": "GET", "path": "/cities", "query_params": ["country_id", "region_id", "page_number", "page_size"], "query_param_aliases": { "country_id": "filter[country.id]", "region_id": "filter[region.id]", "page_number": "page[number]", "page_size": "page[size]" }, "input_schema": { "type": "object", "properties": { "country_id": { "type": "string" }, "region_id": { "type": "string" }, "page_number": { "type": "integer" }, "page_size": { "type": "integer" } } } },
    { "name": "get_city", "description": "Get one inventory city.", "method": "GET", "path": "/cities/{id}", "path_params": ["id"], "input_schema": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"] } },
    { "name": "list_did_group_types", "description": "List DID group types such as local, mobile, toll-free, and SMS.", "method": "GET", "path": "/did_group_types", "query_params": ["page_number", "page_size"], "query_param_aliases": { "page_number": "page[number]", "page_size": "page[size]" }, "input_schema": { "type": "object", "properties": { "page_number": { "type": "integer" }, "page_size": { "type": "integer" } } } },
    { "name": "get_did_group_type", "description": "Get one DID group type.", "method": "GET", "path": "/did_group_types/{id}", "path_params": ["id"], "input_schema": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"] } },
    { "name": "list_did_groups", "description": "Search DID coverage groups and include SKUs/pricing needed to order numbers.", "method": "GET", "path": "/did_groups", "query_params": ["country_id", "region_id", "city_id", "did_group_type_id", "features", "include", "page_number", "page_size"], "query_param_aliases": { "country_id": "filter[country.id]", "region_id": "filter[region.id]", "city_id": "filter[city.id]", "did_group_type_id": "filter[did_group_type.id]", "features": "filter[features]", "page_number": "page[number]", "page_size": "page[size]" }, "input_schema": { "type": "object", "properties": { "country_id": { "type": "string" }, "region_id": { "type": "string" }, "city_id": { "type": "string" }, "did_group_type_id": { "type": "string" }, "features": { "type": "string" }, "include": { "type": "string", "description": "Usually stock_keeping_units and related coverage resources." }, "page_number": { "type": "integer" }, "page_size": { "type": "integer" } } } },
    { "name": "get_did_group", "description": "Get one DID coverage group and optional SKUs.", "method": "GET", "path": "/did_groups/{id}", "path_params": ["id"], "query_params": ["include"], "input_schema": { "type": "object", "properties": { "id": { "type": "string" }, "include": { "type": "string" } }, "required": ["id"] } },
    { "name": "list_available_dids", "description": "List currently available phone numbers. This endpoint must be enabled by DIDWW and inventory changes rapidly.", "method": "GET", "path": "/available_dids", "query_params": ["did_group_id", "features", "include"], "query_param_aliases": { "did_group_id": "filter[did_group.id]", "features": "filter[did_group.features]" }, "input_schema": { "type": "object", "properties": { "did_group_id": { "type": "string" }, "features": { "type": "string" }, "include": { "type": "string" } } } },
    { "name": "get_available_did", "description": "Get one currently available DID.", "method": "GET", "path": "/available_dids/{id}", "path_params": ["id"], "query_params": ["include"], "input_schema": { "type": "object", "properties": { "id": { "type": "string" }, "include": { "type": "string" } }, "required": ["id"] } },

    { "name": "list_did_reservations", "description": "List active DID reservations.", "method": "GET", "path": "/did_reservations", "query_params": ["page_number", "page_size", "include"], "query_param_aliases": { "page_number": "page[number]", "page_size": "page[size]" }, "input_schema": { "type": "object", "properties": { "page_number": { "type": "integer" }, "page_size": { "type": "integer" }, "include": { "type": "string" } } } },
    { "name": "get_did_reservation", "description": "Get one DID reservation and its expires_at value.", "method": "GET", "path": "/did_reservations/{id}", "path_params": ["id"], "query_params": ["include"], "input_schema": { "type": "object", "properties": { "id": { "type": "string" }, "include": { "type": "string" } }, "required": ["id"] } },
    { "name": "create_did_reservation", "description": "Reserve one available DID before ordering it.", "method": "POST", "path": "/did_reservations", "request_transform": { "type": "json_api", "resource_type": "did_reservations", "attributes": ["description"], "relationships": { "available_did": { "source": "available_did_id", "resource_type": "available_dids" } } }, "input_schema": { "type": "object", "properties": { "available_did_id": { "type": "string" }, "description": { "type": "string" } }, "required": ["available_did_id"] } },
    { "name": "delete_did_reservation", "description": "Cancel an active DID reservation.", "method": "DELETE", "path": "/did_reservations/{id}", "path_params": ["id"], "input_schema": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"] } },

    { "name": "list_orders", "description": "List DID and capacity orders.", "method": "GET", "path": "/orders", "query_params": ["status", "page_number", "page_size", "include", "sort"], "query_param_aliases": { "status": "filter[status]", "page_number": "page[number]", "page_size": "page[size]" }, "input_schema": { "type": "object", "properties": { "status": { "type": "string", "enum": ["pending", "completed", "canceled"] }, "page_number": { "type": "integer" }, "page_size": { "type": "integer" }, "include": { "type": "string" }, "sort": { "type": "string" } } } },
    { "name": "get_order", "description": "Get one DIDWW order and its purchased DIDs.", "method": "GET", "path": "/orders/{id}", "path_params": ["id"], "query_params": ["include"], "input_schema": { "type": "object", "properties": { "id": { "type": "string" }, "include": { "type": "string" } }, "required": ["id"] } },
    { "name": "create_order", "description": "Create a DID or capacity order. Each item must be a documented did_order_items or capacity_order_items JSON:API item.", "method": "POST", "path": "/orders", "request_transform": { "type": "json_api", "resource_type": "orders", "attributes": ["items", "allow_back_ordering", "callback_url", "callback_method", "external_reference_id"] }, "input_schema": { "type": "object", "properties": { "items": { "type": "array", "items": { "type": "object", "properties": { "type": { "type": "string", "enum": ["did_order_items", "capacity_order_items"] }, "attributes": { "type": "object", "description": "Use available_did_id or did_group_id plus sku_id for DID items; capacity_pool_id and quantity for capacity items." } }, "required": ["type", "attributes"] } }, "allow_back_ordering": { "type": "boolean" }, "callback_url": { "type": "string" }, "callback_method": { "type": "string", "enum": ["get", "post"] }, "external_reference_id": { "type": "string" } }, "required": ["items"] } },
    { "name": "cancel_order", "description": "Cancel a pending DIDWW order.", "method": "DELETE", "path": "/orders/{id}", "path_params": ["id"], "input_schema": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"] } },

    { "name": "list_dids", "description": "List owned DIDs with routing, capacity and regulatory relationships.", "method": "GET", "path": "/dids", "query_params": ["number", "features", "include", "page_number", "page_size", "sort"], "query_param_aliases": { "number": "filter[number]", "features": "filter[features]", "page_number": "page[number]", "page_size": "page[size]" }, "input_schema": { "type": "object", "properties": { "number": { "type": "string" }, "features": { "type": "string" }, "include": { "type": "string" }, "page_number": { "type": "integer" }, "page_size": { "type": "integer" }, "sort": { "type": "string" } } } },
    { "name": "get_did", "description": "Get one owned DID.", "method": "GET", "path": "/dids/{id}", "path_params": ["id"], "query_params": ["include"], "input_schema": { "type": "object", "properties": { "id": { "type": "string" }, "include": { "type": "string" } }, "required": ["id"] } },
    { "name": "update_did", "description": "Update DID settings and route it to an inbound trunk or trunk group.", "method": "PATCH", "path": "/dids/{id}", "path_params": ["id"], "request_transform": { "type": "json_api", "resource_type": "dids", "id_field": "id", "attributes": ["description", "billing_cycles_count", "capacity_limit", "channels_included_count"], "relationships": { "voice_in_trunk": { "source": "voice_in_trunk_id", "resource_type": "voice_in_trunks" }, "voice_in_trunk_group": { "source": "voice_in_trunk_group_id", "resource_type": "voice_in_trunk_groups" } } }, "input_schema": { "type": "object", "properties": { "id": { "type": "string" }, "description": { "type": "string" }, "billing_cycles_count": { "type": "integer" }, "capacity_limit": { "type": "integer" }, "channels_included_count": { "type": "integer" }, "voice_in_trunk_id": { "type": "string" }, "voice_in_trunk_group_id": { "type": "string" } }, "required": ["id"] } },
    { "name": "list_did_history", "description": "List DID assignment, renewal, cancellation and restoration history from the last 90 days.", "method": "GET", "path": "/did_history", "query_params": ["did_number", "action", "method", "created_at_gteq", "created_at_lteq", "page_number", "page_size", "sort"], "query_param_aliases": { "did_number": "filter[did_number]", "action": "filter[action]", "method": "filter[method]", "created_at_gteq": "filter[created_at_gteq]", "created_at_lteq": "filter[created_at_lteq]", "page_number": "page[number]", "page_size": "page[size]" }, "input_schema": { "type": "object", "properties": { "did_number": { "type": "string" }, "action": { "type": "string", "enum": ["assigned", "renewed", "canceled", "removed", "billing_cycles_count_changed", "restored"] }, "method": { "type": "string", "enum": ["system", "api2", "api3", "staff", "user_panel"] }, "created_at_gteq": { "type": "string" }, "created_at_lteq": { "type": "string" }, "page_number": { "type": "integer" }, "page_size": { "type": "integer" }, "sort": { "type": "string" } } } },
    { "name": "get_did_history", "description": "Get one DID history record.", "method": "GET", "path": "/did_history/{id}", "path_params": ["id"], "input_schema": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"] } },

    { "name": "list_inbound_trunks", "description": "List inbound SIP/PSTN trunks.", "method": "GET", "path": "/voice_in_trunks", "query_params": ["include", "page_number", "page_size"], "query_param_aliases": { "page_number": "page[number]", "page_size": "page[size]" }, "input_schema": { "type": "object", "properties": { "include": { "type": "string" }, "page_number": { "type": "integer" }, "page_size": { "type": "integer" } } } },
    { "name": "get_inbound_trunk", "description": "Get one inbound trunk.", "method": "GET", "path": "/voice_in_trunks/{id}", "path_params": ["id"], "query_params": ["include"], "input_schema": { "type": "object", "properties": { "id": { "type": "string" }, "include": { "type": "string" } }, "required": ["id"] } },
    { "name": "create_inbound_trunk", "description": "Create an inbound SIP or PSTN trunk with explicit routing and media configuration.", "method": "POST", "path": "/voice_in_trunks", "request_transform": { "type": "json_api", "resource_type": "voice_in_trunks", "attributes": ["name", "priority", "weight", "capacity_limit", "ringing_timeout", "cli_format", "cli_prefix", "description", "external_reference_id", "configuration"] }, "input_schema": { "type": "object", "properties": { "name": { "type": "string" }, "priority": { "type": "integer" }, "weight": { "type": "integer" }, "capacity_limit": { "type": "integer" }, "ringing_timeout": { "type": "integer" }, "cli_format": { "type": "string" }, "cli_prefix": { "type": "string" }, "description": { "type": "string" }, "external_reference_id": { "type": "string" }, "configuration": { "type": "object", "description": "Typed configuration object: {type:\"sip_configurations\"|\"pstn_configurations\",attributes:{...}}." } }, "required": ["name", "priority", "weight", "configuration"] } },
    { "name": "update_inbound_trunk", "description": "Update an inbound trunk.", "method": "PATCH", "path": "/voice_in_trunks/{id}", "path_params": ["id"], "request_transform": { "type": "json_api", "resource_type": "voice_in_trunks", "id_field": "id", "attributes": ["name", "priority", "weight", "capacity_limit", "ringing_timeout", "cli_format", "cli_prefix", "description", "external_reference_id", "configuration"] }, "input_schema": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "priority": { "type": "integer" }, "weight": { "type": "integer" }, "capacity_limit": { "type": "integer" }, "ringing_timeout": { "type": "integer" }, "cli_format": { "type": "string" }, "cli_prefix": { "type": "string" }, "description": { "type": "string" }, "external_reference_id": { "type": "string" }, "configuration": { "type": "object" } }, "required": ["id"] } },
    { "name": "delete_inbound_trunk", "description": "Delete an inbound trunk.", "method": "DELETE", "path": "/voice_in_trunks/{id}", "path_params": ["id"], "input_schema": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"] } },

    { "name": "list_inbound_trunk_groups", "description": "List inbound trunk groups.", "method": "GET", "path": "/voice_in_trunk_groups", "query_params": ["include", "page_number", "page_size"], "query_param_aliases": { "page_number": "page[number]", "page_size": "page[size]" }, "input_schema": { "type": "object", "properties": { "include": { "type": "string" }, "page_number": { "type": "integer" }, "page_size": { "type": "integer" } } } },
    { "name": "get_inbound_trunk_group", "description": "Get one inbound trunk group.", "method": "GET", "path": "/voice_in_trunk_groups/{id}", "path_params": ["id"], "query_params": ["include"], "input_schema": { "type": "object", "properties": { "id": { "type": "string" }, "include": { "type": "string" } }, "required": ["id"] } },
    { "name": "create_inbound_trunk_group", "description": "Create an inbound trunk group and assign inbound trunks.", "method": "POST", "path": "/voice_in_trunk_groups", "request_transform": { "type": "json_api", "resource_type": "voice_in_trunk_groups", "attributes": ["name", "capacity_limit", "ringing_timeout", "description"], "relationships": { "voice_in_trunks": { "source": "voice_in_trunk_ids", "resource_type": "voice_in_trunks", "many": true } } }, "input_schema": { "type": "object", "properties": { "name": { "type": "string" }, "capacity_limit": { "type": "integer" }, "ringing_timeout": { "type": "integer" }, "description": { "type": "string" }, "voice_in_trunk_ids": { "type": "array", "items": { "type": "string" } } }, "required": ["name", "voice_in_trunk_ids"] } },
    { "name": "update_inbound_trunk_group", "description": "Update an inbound trunk group and its trunk membership.", "method": "PATCH", "path": "/voice_in_trunk_groups/{id}", "path_params": ["id"], "request_transform": { "type": "json_api", "resource_type": "voice_in_trunk_groups", "id_field": "id", "attributes": ["name", "capacity_limit", "ringing_timeout", "description"], "relationships": { "voice_in_trunks": { "source": "voice_in_trunk_ids", "resource_type": "voice_in_trunks", "many": true } } }, "input_schema": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "capacity_limit": { "type": "integer" }, "ringing_timeout": { "type": "integer" }, "description": { "type": "string" }, "voice_in_trunk_ids": { "type": "array", "items": { "type": "string" } } }, "required": ["id"] } },
    { "name": "delete_inbound_trunk_group", "description": "Delete an inbound trunk group.", "method": "DELETE", "path": "/voice_in_trunk_groups/{id}", "path_params": ["id"], "input_schema": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"] } },

    { "name": "list_outbound_trunks", "description": "List outbound SIP trunks.", "method": "GET", "path": "/voice_out_trunks", "query_params": ["include", "page_number", "page_size"], "query_param_aliases": { "page_number": "page[number]", "page_size": "page[size]" }, "input_schema": { "type": "object", "properties": { "include": { "type": "string" }, "page_number": { "type": "integer" }, "page_size": { "type": "integer" } } } },
    { "name": "get_outbound_trunk", "description": "Get one outbound SIP trunk.", "method": "GET", "path": "/voice_out_trunks/{id}", "path_params": ["id"], "query_params": ["include"], "input_schema": { "type": "object", "properties": { "id": { "type": "string" }, "include": { "type": "string" } }, "required": ["id"] } },
    { "name": "create_outbound_trunk", "description": "Create an outbound trunk using credentials_and_ip or Twilio authentication.", "method": "POST", "path": "/voice_out_trunks", "request_transform": { "type": "json_api", "resource_type": "voice_out_trunks", "attributes": ["name", "external_reference_id", "allowed_rtp_ips", "authentication_method", "on_cli_mismatch_action", "capacity_limit", "allow_any_did_as_cli", "status", "threshold_amount", "default_dst_action", "dst_prefixes", "emergency_enable_all", "media_encryption_mode", "callback_url", "force_symmetric_rtp", "rtp_ping", "rtp_timeout"], "relationships": { "dids": { "source": "did_ids", "resource_type": "dids", "many": true }, "emergency_dids": { "source": "emergency_did_ids", "resource_type": "dids", "many": true } } }, "input_schema": { "type": "object", "properties": { "name": { "type": "string" }, "external_reference_id": { "type": "string" }, "allowed_rtp_ips": { "type": "array", "items": { "type": "string" } }, "authentication_method": { "type": "object", "description": "{type:\"credentials_and_ip\",attributes:{allowed_sip_ips:[...],tech_prefix:null}} or {type:\"twilio\",attributes:{twilio_account_sid:\"AC...\"}}." }, "on_cli_mismatch_action": { "type": "string", "enum": ["send_original_cli", "reject_call", "replace_cli"] }, "capacity_limit": { "type": "integer" }, "allow_any_did_as_cli": { "type": "boolean" }, "status": { "type": "string", "enum": ["active", "blocked"] }, "threshold_amount": { "type": "string" }, "default_dst_action": { "type": "string", "enum": ["allow_all", "reject_all"] }, "dst_prefixes": { "type": "array", "items": { "type": "string" } }, "emergency_enable_all": { "type": "boolean" }, "media_encryption_mode": { "type": "string", "enum": ["disabled", "srtp_sdes", "srtp_dtls", "zrtp"] }, "callback_url": { "type": "string" }, "force_symmetric_rtp": { "type": "boolean" }, "rtp_ping": { "type": "boolean" }, "rtp_timeout": { "type": "integer" }, "did_ids": { "type": "array", "items": { "type": "string" } }, "emergency_did_ids": { "type": "array", "items": { "type": "string" } } }, "required": ["name", "authentication_method", "on_cli_mismatch_action"] } },
    { "name": "update_outbound_trunk", "description": "Update an outbound trunk using the current authentication_method object.", "method": "PATCH", "path": "/voice_out_trunks/{id}", "path_params": ["id"], "request_transform": { "type": "json_api", "resource_type": "voice_out_trunks", "id_field": "id", "attributes": ["name", "external_reference_id", "allowed_rtp_ips", "authentication_method", "on_cli_mismatch_action", "capacity_limit", "allow_any_did_as_cli", "status", "threshold_amount", "default_dst_action", "dst_prefixes", "emergency_enable_all", "media_encryption_mode", "callback_url", "force_symmetric_rtp", "rtp_ping", "rtp_timeout"], "relationships": { "dids": { "source": "did_ids", "resource_type": "dids", "many": true }, "emergency_dids": { "source": "emergency_did_ids", "resource_type": "dids", "many": true } } }, "input_schema": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "external_reference_id": { "type": "string" }, "allowed_rtp_ips": { "type": "array", "items": { "type": "string" } }, "authentication_method": { "type": "object" }, "on_cli_mismatch_action": { "type": "string", "enum": ["send_original_cli", "reject_call", "replace_cli"] }, "capacity_limit": { "type": "integer" }, "allow_any_did_as_cli": { "type": "boolean" }, "status": { "type": "string", "enum": ["active", "blocked"] }, "threshold_amount": { "type": "string" }, "default_dst_action": { "type": "string", "enum": ["allow_all", "reject_all"] }, "dst_prefixes": { "type": "array", "items": { "type": "string" } }, "emergency_enable_all": { "type": "boolean" }, "media_encryption_mode": { "type": "string" }, "callback_url": { "type": "string" }, "force_symmetric_rtp": { "type": "boolean" }, "rtp_ping": { "type": "boolean" }, "rtp_timeout": { "type": "integer" }, "did_ids": { "type": "array", "items": { "type": "string" } }, "emergency_did_ids": { "type": "array", "items": { "type": "string" } } }, "required": ["id"] } },
