{
  "slug": "ovhcloud-telecom",
  "name": "OVHcloud Telecom",
  "description": "OVHcloud telephony for numbers, SIP lines, live calls, click-to-call, recordings, IVR hunting queues, agents, monitoring, and call control",
  "logo": "https://www.google.com/s2/favicons?domain=ovhcloud.com&sz=128",
  "categories": ["telephony", "voice", "sip", "pbx", "europe"],
  "base_url": "https://eu.api.ovh.com/1.0",
  "auth": {
    "types": ["bearer"],
    "headers": {
      "Authorization": "Bearer {{access_token}}",
      "Content-Type": "application/json"
    },
    "credential_fields": [
      {
        "name": "access_token",
        "label": "OAuth2 Access Token",
        "secret": true,
        "description": "OVHcloud OAuth2 service-account access token with access to the telephony API"
      }
    ]
  },
  "health_check": {
    "tool": "list_billing_accounts",
    "description": "Verify the OAuth2 token and list accessible telephony billing accounts"
  },
  "tools": [
    {
      "name": "list_billing_accounts",
      "description": "List telephony billing-account identifiers available to this OVHcloud account. Start here before using line, number, or PBX tools.",
      "method": "GET",
      "path": "/telephony",
      "input_schema": { "type": "object", "properties": {} }
    },
    {
      "name": "get_billing_account",
      "description": "Get a telephony billing account and its configuration.",
      "method": "GET",
      "path": "/telephony/{billingAccount}",
      "input_schema": {
        "type": "object",
        "properties": { "billingAccount": { "type": "string" } },
        "required": ["billingAccount"]
      }
    },
    {
      "name": "list_lines",
      "description": "List SIP/VoIP line service names under a billing account.",
      "method": "GET",
      "path": "/telephony/{billingAccount}/line",
      "input_schema": {
        "type": "object",
        "properties": { "billingAccount": { "type": "string" } },
        "required": ["billingAccount"]
      }
    },
    {
      "name": "get_line",
      "description": "Get a SIP/VoIP line configuration.",
      "method": "GET",
      "path": "/telephony/{billingAccount}/line/{serviceName}",
      "input_schema": {
        "type": "object",
        "properties": {
          "billingAccount": { "type": "string" },
          "serviceName": { "type": "string" }
        },
        "required": ["billingAccount", "serviceName"]
      }
    },
    {
      "name": "list_line_calls",
      "description": "List calls currently attached to a line. Returned call IDs can be used with live control tools.",
      "method": "GET",
      "path": "/telephony/{billingAccount}/line/{serviceName}/calls",
      "input_schema": {
        "type": "object",
        "properties": {
          "billingAccount": { "type": "string" },
          "serviceName": { "type": "string" }
        },
        "required": ["billingAccount", "serviceName"]
      }
    },
    {
      "name": "get_line_call",
      "description": "Get the current state and routing details of one live line call.",
      "method": "GET",
      "path": "/telephony/{billingAccount}/line/{serviceName}/calls/{id}",
      "input_schema": {
        "type": "object",
        "properties": {
          "billingAccount": { "type": "string" },
          "serviceName": { "type": "string" },
          "id": { "type": "integer" }
        },
        "required": ["billingAccount", "serviceName", "id"]
      }
    },
    {
      "name": "eavesdrop_line_call",
      "description": "Listen to a live line call from another OVHcloud phone number.",
      "method": "POST",
      "path": "/telephony/{billingAccount}/line/{serviceName}/calls/{id}/eavesdrop",
      "input_schema": {
        "type": "object",
        "properties": {
          "billingAccount": { "type": "string" },
          "serviceName": { "type": "string" },
          "id": { "type": "integer" },
          "number": { "type": "string", "description": "OVHcloud phone number that will receive the monitoring call" }
        },
        "required": ["billingAccount", "serviceName", "id", "number"]
      }
    },
    {
      "name": "hangup_line_call",
      "description": "Hang up a live line call.",
      "method": "POST",
      "path": "/telephony/{billingAccount}/line/{serviceName}/calls/{id}/hangup",
      "input_schema": {
        "type": "object",
        "properties": {
          "billingAccount": { "type": "string" },
          "serviceName": { "type": "string" },
          "id": { "type": "integer" }
        },
        "required": ["billingAccount", "serviceName", "id"]
      }
    },
    {
      "name": "hold_line_call",
      "description": "Put a live line call on hold.",
      "method": "POST",
      "path": "/telephony/{billingAccount}/line/{serviceName}/calls/{id}/hold",
      "input_schema": {
        "type": "object",
        "properties": {
          "billingAccount": { "type": "string" },
          "serviceName": { "type": "string" },
          "id": { "type": "integer" }
        },
        "required": ["billingAccount", "serviceName", "id"]
      }
    },
    {
      "name": "intercept_line_call",
      "description": "Intercept a live line call on another OVHcloud number.",
      "method": "POST",
      "path": "/telephony/{billingAccount}/line/{serviceName}/calls/{id}/intercept",
      "input_schema": {
        "type": "object",
        "properties": {
          "billingAccount": { "type": "string" },
          "serviceName": { "type": "string" },
          "id": { "type": "integer" },
          "number": { "type": "string" }
        },
        "required": ["billingAccount", "serviceName", "id", "number"]
      }
    },
    {
      "name": "transfer_line_call",
      "description": "Transfer a live line call to a phone number.",
      "method": "POST",
      "path": "/telephony/{billingAccount}/line/{serviceName}/calls/{id}/transfer",
      "input_schema": {
        "type": "object",
        "properties": {
          "billingAccount": { "type": "string" },
          "serviceName": { "type": "string" },
          "id": { "type": "integer" },
          "number": { "type": "string" }
        },
        "required": ["billingAccount", "serviceName", "id", "number"]
      }
    },
    {
      "name": "whisper_line_call",
      "description": "Whisper into a live line call from another OVHcloud number.",
      "method": "POST",
      "path": "/telephony/{billingAccount}/line/{serviceName}/calls/{id}/whisper",
      "input_schema": {
        "type": "object",
        "properties": {
          "billingAccount": { "type": "string" },
          "serviceName": { "type": "string" },
          "id": { "type": "integer" },
          "number": { "type": "string" },
          "whisperingMode": { "type": "string", "description": "OVHcloud whisper mode accepted by the line" }
        },
        "required": ["billingAccount", "serviceName", "id", "number", "whisperingMode"]
      }
    },
    {
      "name": "click_to_call",
      "description": "Originate a call from an OVHcloud line to a destination number.",
      "method": "POST",
      "path": "/telephony/{billingAccount}/line/{serviceName}/click2Call",
      "input_schema": {
        "type": "object",
        "properties": {
          "billingAccount": { "type": "string" },
          "serviceName": { "type": "string" },
          "calledNumber": { "type": "string" },
          "callingNumber": { "type": "string" },
          "intercom": { "type": "boolean" }
        },
        "required": ["billingAccount", "serviceName", "calledNumber"]
      }
    },
    {
      "name": "get_line_registrations",
      "description": "Get the most recent SIP registrations for a line.",
      "method": "GET",
      "path": "/telephony/{billingAccount}/line/{serviceName}/lastRegistrations",
      "input_schema": {
        "type": "object",
        "properties": {
          "billingAccount": { "type": "string" },
          "serviceName": { "type": "string" }
        },
        "required": ["billingAccount", "serviceName"]
      }
    },
    {
      "name": "get_line_statistics",
      "description": "Get line call statistics for a timeframe and metric type.",
      "method": "GET",
      "path": "/telephony/{billingAccount}/line/{serviceName}/statistics",
      "input_schema": {
        "type": "object",
        "properties": {
          "billingAccount": { "type": "string" },
          "serviceName": { "type": "string" },
          "timeframe": { "type": "string" },
          "type": { "type": "string" }
        },
        "required": ["billingAccount", "serviceName", "timeframe", "type"]
      }
    },
    {
      "name": "list_line_recordings",
      "description": "List recording IDs for a line.",
      "method": "GET",
      "path": "/telephony/{billingAccount}/line/{serviceName}/records",
      "input_schema": {
        "type": "object",
        "properties": {
          "billingAccount": { "type": "string" },
          "serviceName": { "type": "string" }
        },
        "required": ["billingAccount", "serviceName"]
      }
    },
    {
      "name": "get_line_recording",
      "description": "Get a line recording and its temporary file URL.",
      "method": "GET",
      "path": "/telephony/{billingAccount}/line/{serviceName}/records/{id}",
      "input_schema": {
        "type": "object",
        "properties": {
          "billingAccount": { "type": "string" },
          "serviceName": { "type": "string" },
          "id": { "type": "integer" }
        },
        "required": ["billingAccount", "serviceName", "id"]
      }
    },
    {
      "name": "delete_line_recording",
      "description": "Permanently delete a line recording.",
      "method": "DELETE",
      "path": "/telephony/{billingAccount}/line/{serviceName}/records/{id}",
      "input_schema": {
        "type": "object",
        "properties": {
          "billingAccount": { "type": "string" },
          "serviceName": { "type": "string" },
          "id": { "type": "integer" }
        },
        "required": ["billingAccount", "serviceName", "id"]
      }
    },
    {
      "name": "list_numbers",
      "description": "List phone-number service names under a billing account.",
      "method": "GET",
      "path": "/telephony/{billingAccount}/number",
      "input_schema": {
        "type": "object",
        "properties": { "billingAccount": { "type": "string" } },
        "required": ["billingAccount"]
      }
    },
    {
      "name": "get_number",
      "description": "Get a phone number and its routing configuration.",
      "method": "GET",
      "path": "/telephony/{billingAccount}/number/{serviceName}",
      "input_schema": {
        "type": "object",
        "properties": {
          "billingAccount": { "type": "string" },
