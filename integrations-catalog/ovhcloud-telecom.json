        "type": "object",
        "properties": {
          "billingAccount": { "type": "string" },
          "serviceName": { "type": "string" }
        },
        "required": ["billingAccount", "serviceName"]
      }
    },
    {
      "name": "create_agent",
      "description": "Create an agent on an Easy Hunting service.",
      "method": "POST",
      "path": "/telephony/{billingAccount}/easyHunting/{serviceName}/hunting/agent",
      "input_schema": {
        "type": "object",
        "properties": {
          "billingAccount": { "type": "string" },
          "serviceName": { "type": "string" },
          "number": { "type": "string" },
          "simultaneousLines": { "type": "integer" },
          "status": { "type": "string" },
          "timeout": { "type": "integer" },
          "wrapUpTime": { "type": "integer" },
          "description": { "type": "string" }
        },
        "required": ["billingAccount", "serviceName", "number", "simultaneousLines", "status", "timeout", "wrapUpTime"]
      }
    },
    {
      "name": "get_agent",
      "description": "Get an Easy Hunting agent.",
      "method": "GET",
      "path": "/telephony/{billingAccount}/easyHunting/{serviceName}/hunting/agent/{agentId}",
      "input_schema": {
        "type": "object",
        "properties": {
          "billingAccount": { "type": "string" },
          "serviceName": { "type": "string" },
          "agentId": { "type": "integer" }
        },
        "required": ["billingAccount", "serviceName", "agentId"]
      }
    },
    {
      "name": "update_agent",
      "description": "Update an Easy Hunting agent. Supply only fields that should change.",
      "method": "PUT",
      "path": "/telephony/{billingAccount}/easyHunting/{serviceName}/hunting/agent/{agentId}",
      "input_schema": {
        "type": "object",
        "properties": {
          "billingAccount": { "type": "string" },
          "serviceName": { "type": "string" },
          "agentId": { "type": "integer" },
          "number": { "type": "string" },
          "simultaneousLines": { "type": "integer" },
          "status": { "type": "string" },
          "timeout": { "type": "integer" },
          "wrapUpTime": { "type": "integer" },
          "description": { "type": "string" },
          "breakStatus": { "type": "string" }
        },
        "required": ["billingAccount", "serviceName", "agentId"]
      }
    },
    {
      "name": "delete_agent",
      "description": "Delete an Easy Hunting agent.",
      "method": "DELETE",
      "path": "/telephony/{billingAccount}/easyHunting/{serviceName}/hunting/agent/{agentId}",
      "input_schema": {
        "type": "object",
        "properties": {
          "billingAccount": { "type": "string" },
          "serviceName": { "type": "string" },
          "agentId": { "type": "integer" }
        },
        "required": ["billingAccount", "serviceName", "agentId"]
      }
    },
    {
      "name": "get_agent_live_status",
      "description": "Get an agent's live availability and call status.",
      "method": "GET",
      "path": "/telephony/{billingAccount}/easyHunting/{serviceName}/hunting/agent/{agentId}/liveStatus",
      "input_schema": {
        "type": "object",
        "properties": {
