      }
    },
    {
      "name": "create_queue",
      "description": "Create a hunting queue. Strategy is an OVHcloud queue strategy such as sequentially or simultaneously.",
      "method": "POST",
      "path": "/telephony/{billingAccount}/easyHunting/{serviceName}/hunting/queue",
      "input_schema": {
        "type": "object",
        "properties": {
          "billingAccount": { "type": "string" },
          "serviceName": { "type": "string" },
          "strategy": { "type": "string" },
          "description": { "type": "string" },
          "maxMember": { "type": "integer" },
          "maxWaitTime": { "type": "integer" },
          "record": { "type": "boolean" },
          "soundOnHold": { "type": "integer" },
          "actionOnClosure": { "type": "string" },
          "actionOnClosureParam": { "type": "string" },
          "actionOnOverflow": { "type": "string" },
          "actionOnOverflowParam": { "type": "string" },
          "askForRecordDisabling": { "type": "boolean" },
          "recordDisablingDigit": { "type": "string" },
          "recordDisablingLanguage": { "type": "string" }
        },
        "required": ["billingAccount", "serviceName", "strategy"]
      }
    },
    {
      "name": "get_queue",
      "description": "Get a hunting queue configuration.",
      "method": "GET",
      "path": "/telephony/{billingAccount}/easyHunting/{serviceName}/hunting/queue/{queueId}",
