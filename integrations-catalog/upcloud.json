  "categories": [
    "cloud",
    "servers",
    "vps",
    "infrastructure"
  ],
  "base_url": "https://api.upcloud.com/1.3",
  "auth": {
    "types": [
      "bearer"
    ],
    "headers": {
      "Authorization": "Bearer {{token}}"
    },
    "credential_fields": [
      {
        "name": "token",
        "label": "API Token",
        "description": "Create a dedicated API token in UpCloud Hub with server, storage and zone permissions.",
        "required": true
      }
    ]
  },
