      "input_schema": {
        "type": "object",
        "properties": {
          "collectionId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "offerIds": {
            "type": "array",
            "description": "List of product IDs to set in the collection",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "collectionId"
        ]
      }
    },
    {
      "name": "get_collection_products",
      "description": "Get products in a collection",
      "method": "GET",
      "path": "/open-api/v1.0/collections/{collectionId}/products",
      "input_schema": {
        "type": "object",
        "properties": {
          "collectionId": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "default": 0
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "default": 20,
            "description": "Number of elements per page. The maximum page size is 100 - larger values are capped at 100."
          },
          "status": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "AVAILABLE",
              "SOLD_OUT",
              "HIDDEN",
              "ARCHIVED"
            ],
            "description": "Filter for product status in a collection"
          }
        },
        "required": [
          "collectionId"
        ]
      },
      "query_params": [
        "page",
        "size",
        "status"
      ]
    },
    {
      "name": "update_collection_products",
      "description": "Set collection products",
      "method": "PUT",
      "path": "/open-api/v1.0/collections/{collectionId}/products",
      "input_schema": {
