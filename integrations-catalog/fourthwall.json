    {
      "name": "upload_presigned_file",
      "description": "Upload raw image, design, or digital-product bytes to a Fourthwall presigned uploadUrl. Reuse the exact content type and byte size used when requesting the URL; content_length_range must be 0,<size>.",
      "method": "PUT",
      "path": "{upload_url}",
      "omit_auth_headers": [
        "Authorization"
      ],
      "body_binary_param": "file",
      "header_params": {
        "content_type": "Content-Type",
        "content_length_range": "x-goog-content-length-range"
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "upload_url": {
            "type": "string",
            "description": "Short-lived uploadUrl returned by a Fourthwall upload-url tool."
          },
          "file": {
            "type": "string",
            "description": "File bytes as a blobref:// handle or runtime binary value."
          },
          "content_type": {
            "type": "string",
            "description": "Exact MIME type supplied when requesting the presigned URL."
          },
          "content_length_range": {
            "type": "string",
            "description": "Required signed header in the form 0,<exact byte size>, for example 0,24576."
          }
        },
        "required": [
          "upload_url",
          "file",
          "content_type",
          "content_length_range"
        ]
      }
    },
