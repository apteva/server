      "method": "POST",
      "path": "/open-api/v1.0/products/{productId}/digital-files/upload-url",
      "input_schema": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "fileName": {
            "type": "string",
            "description": "Name of the file"
