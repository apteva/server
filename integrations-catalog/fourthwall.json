{
  "slug": "fourthwall",
  "name": "Fourthwall",
  "description": "Fourthwall Platform API for selling hosted physical and digital products without building a storefront: products, files, inventory, collections, orders, fulfillment, promotions, memberships, donations, and webhooks.",
  "logo": "https://www.google.com/s2/favicons?domain=fourthwall.com&sz=128",
  "categories": [
    "ecommerce",
    "creator-commerce",
    "storefront",
    "digital-products",
    "merchandise",
    "orders",
    "fulfillment"
  ],
  "base_url": "https://api.fourthwall.com",
  "auth": {
    "types": [
      "basic"
    ],
    "headers": {
      "Authorization": "Basic {{basic_auth}}"
    },
    "credential_fields": [
      {
        "name": "username",
        "label": "API Username",
        "description": "Username for the API user created in Fourthwall Settings > For developers.",
        "required": true
      },
      {
        "name": "password",
        "label": "API Password",
        "type": "password",
        "description": "Password shown when the Fourthwall API user is created.",
        "required": true
      }
    ]
  },
  "tools": [
    {
      "name": "get_webhook",
      "description": "Get a webhook",
      "method": "GET",
      "path": "/open-api/v1.0/webhooks/{webhookConfigurationId}",
      "input_schema": {
        "type": "object",
        "properties": {
          "webhookConfigurationId": {
            "type": "string"
          }
        },
        "required": [
          "webhookConfigurationId"
        ]
      }
    },
    {
      "name": "update_webhook",
      "description": "Update a webhook",
      "method": "PUT",
      "path": "/open-api/v1.0/webhooks/{webhookConfigurationId}",
      "input_schema": {
        "type": "object",
        "properties": {
          "webhookConfigurationId": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "allowedTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ORDER_PLACED",
                "ORDER_UPDATED",
                "GIFT_PURCHASE",
                "PRODUCT_CREATED",
                "PRODUCT_UPDATED",
                "DONATION",
                "SUBSCRIPTION_PURCHASED",
                "SUBSCRIPTION_EXPIRED",
                "SUBSCRIPTION_CHANGED",
                "NEWSLETTER_SUBSCRIBED",
                "THANK_YOU_SENT",
                "GIFT_DRAW_STARTED",
                "GIFT_DRAW_ENDED",
                "PROMOTION_CREATED",
                "PROMOTION_UPDATED",
                "PROMOTION_STATUS_CHANGED",
                "PLATFORM_APP_DISCONNECTED",
                "MEMBERSHIP_POST_UPSERTED",
                "MEMBERSHIP_SERIES_UPSERTED",
                "MEMBERSHIP_SERIES_DELETED",
                "MEMBERSHIP_TAG_CREATED",
                "MEMBERSHIP_TAG_UPDATED",
                "MEMBERSHIP_TAG_DELETED",
                "MEMBERSHIP_TIER_UPSERTED",
                "MEMBERSHIP_TIER_DELETED",
                "COLLECTION_UPDATED",
                "CART_ABANDONED_1H",
                "CART_ABANDONED_24H",
                "CART_ABANDONED_72H"
              ]
            }
          }
        },
        "required": [
          "webhookConfigurationId",
          "allowedTypes",
          "url"
        ]
      }
    },
    {
      "name": "delete_webhook",
      "description": "Delete a webhook",
      "method": "DELETE",
      "path": "/open-api/v1.0/webhooks/{webhookConfigurationId}",
      "input_schema": {
        "type": "object",
        "properties": {
          "webhookConfigurationId": {
            "type": "string"
          }
        },
        "required": [
          "webhookConfigurationId"
        ]
      }
    },
    {
      "name": "get_promotion",
      "description": "Get a promotion by id",
      "method": "GET",
      "path": "/open-api/v1.0/promotions/{promotionId}",
      "input_schema": {
        "type": "object",
        "properties": {
          "promotionId": {
            "type": "string"
          }
        },
        "required": [
          "promotionId"
        ]
      }
    },
    {
      "name": "update_promotion",
      "description": "Update a promotion",
      "method": "PUT",
      "path": "/open-api/v1.0/promotions/{promotionId}",
      "input_schema": {
        "type": "object",
        "properties": {
          "promotionId": {
            "type": "string"
          },
          "limits": {
            "type": "object",
            "properties": {
              "maximumUse": {
                "type": "integer",
                "format": "int32"
              },
              "oneUsePerCustomer": {
                "type": "boolean"
              }
            },
            "required": [
              "oneUsePerCustomer"
            ]
          },
          "requirements": {
            "type": "object",
            "properties": {
              "minimumOrderValue": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "currency": {
                    "type": "string"
                  }
                },
                "required": [
                  "currency",
                  "value"
                ]
              }
            }
          },
          "appliesTo": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "productIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "oncePerOrder": {
                "type": "boolean"
              }
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "LIVE",
              "ENDED"
            ]
          }
        },
        "required": [
          "promotionId"
        ]
      }
    },
    {
      "name": "update_product_state",
      "description": "Update product (offer) lifecycle state",
      "method": "PUT",
      "path": "/open-api/v1.0/products/{productId}/state",
      "input_schema": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "HIDDEN"
            ],
            "description": "Target lifecycle state. PUBLIC makes the product visible on the storefront; HIDDEN keeps it unlisted. The sold-out (available) flag is preserved across the transition — use PUT /products/{productId}/availability to flip it."
          }
        },
        "required": [
          "productId",
          "state"
        ]
      }
    },
    {
      "name": "update_product_availability",
      "description": "Update product (offer) availability by id",
      "method": "PUT",
      "path": "/open-api/v1.0/products/{productId}/availability",
      "input_schema": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          }
        },
        "required": [
          "productId",
          "available"
        ]
      }
    },
    {
