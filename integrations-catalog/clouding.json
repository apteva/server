          "subnetCidr": {
            "minLength": 1,
            "type": "string"
          },
          "dnsNameservers": {
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gatewayIp": {
            "type": "string"
          }
        },
        "required": [
