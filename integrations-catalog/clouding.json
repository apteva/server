                  "Backup",
                  "Snapshot",
                  "Server"
                ],
                "type": "string"
              },
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "ssdGb": {
                "minimum": 0,
                "exclusiveMinimum": true,
                "type": "integer"
              }
            },
            "additionalProperties": false
          },
          "backupPreferences": {
            "type": "object",
            "properties": {
              "slots": {
