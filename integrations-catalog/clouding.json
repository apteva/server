{
  "slug": "clouding",
  "name": "Clouding",
  "description": "Cloud servers in Barcelona: server lifecycle, CPU/RAM and disk catalogs, images, SSH keys, firewalls, backups, snapshots and VPCs.",
  "logo": "https://www.google.com/s2/favicons?domain=clouding.io&sz=128",
  "categories": [
    "cloud",
    "servers",
    "vps",
    "infrastructure"
  ],
  "base_url": "https://api.clouding.io/v1",
  "auth": {
    "types": [
      "api_key"
    ],
    "headers": {
      "X-API-KEY": "{{api_key}}"
    },
    "credential_fields": [
      {
        "name": "api_key",
        "label": "API Key",
        "required": true
      },
      {
        "name": "firewall_id",
        "label": "Default public firewall ID",
        "description": "Optional existing firewall that permits SSH. Otherwise Instances discovers an existing SSH-enabled firewall. Never changes shared firewall rules.",
        "required": false,
        "exposure": "public"
      }
    ]
  },
  "tools": [
    {
      "name": "list_vpcs",
      "description": "List all VPCs",
      "method": "GET",
      "path": "/vpcs",
