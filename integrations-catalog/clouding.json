    {
      "name": "create_server",
      "description": "Create server",
      "method": "POST",
      "path": "/servers",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "hostname": {
            "minLength": 1,
            "type": "string"
          },
          "flavorId": {
            "minLength": 1,
            "type": "string"
          },
          "firewallId": {
            "type": "string"
          },
          "accessConfiguration": {
            "type": "object",
            "properties": {
              "sshKeyId": {
                "type": "string"
              },
              "password": {
                "type": "string"
              },
              "savePassword": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "volume": {
            "required": [
              "id",
              "source",
              "ssdGb"
            ],
            "type": "object",
            "properties": {
              "source": {
                "minLength": 1,
                "enum": [
                  "image",
                  "backup",
                  "snapshot",
                  "server"
                ],
                "type": "string"
              },
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "ssdGb": {
                "minimum": 5,
                "type": "integer"
              },
              "shutDownSource": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "enablePrivateNetwork": {
            "type": "boolean"
          },
          "enableStrictAntiDDoSFiltering": {
            "type": "boolean"
          },
          "userData": {
            "type": "string"
          },
          "backupPreferences": {
            "type": "object",
            "properties": {
              "slots": {
                "maximum": 30,
                "minimum": 2,
                "type": "integer"
              },
              "frequency": {
                "enum": [
                  "oneDay",
                  "twoDays",
                  "threeDays",
                  "fourDays",
                  "fiveDays",
                  "sixDays",
                  "oneWeek"
                ],
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "vpcs": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "required": [
                "firewallIds",
                "id"
              ],
              "type": "object",
              "properties": {
                "id": {
                  "minLength": 1,
                  "type": "string"
                },
                "firewallIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "ipAddress": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "publicPortFirewallIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "accessConfiguration",
          "flavorId",
          "hostname",
          "name",
          "volume"
        ]
      }
    },
