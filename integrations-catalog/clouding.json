                  "twoDays",
                  "threeDays",
                  "fourDays",
                  "fiveDays",
                  "sixDays",
                  "oneWeek"
                ],
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "isArchived": {
            "type": "boolean"
          }
        },
        "required": [
          "flavorId",
          "volume"
        ]
      }
