{
  "slug": "api-sports-american-football",
  "name": "API-Sports (NFL & NCAA)",
  "description": "Self-service NFL & NCAA data API with schedules/results, statistics and documented lookup tools. Free plan advertises 100 requests/day per API; coverage and history depend on subscription. Odds tools, when present, read bookmaker prices and do not place bets. Register: https://dashboard.api-football.com/register . Docs: https://api-sports.io/documentation/nfl/v1",
  "logo": "https://www.google.com/s2/favicons?domain=api-sports.io&sz=128",
  "categories": [
    "sports",
    "american-football",
    "stats"
  ],
  "base_url": "https://v1.american-football.api-sports.io",
  "auth": {
    "types": [
      "api_key"
    ],
    "headers": {
      "x-apisports-key": "{{api_key}}"
    },
    "credential_fields": [
      {
        "name": "api_key",
        "label": "API-Sports Key",
        "type": "password",
        "required": true,
        "description": "Direct API-Sports dashboard key for this sport; RapidAPI subscriptions use different authentication."
      }
    ]
  },
  "tools": [
    {
      "name": "status",
      "description": "Check account, subscription and daily request quota. This endpoint does not consume the daily quota.",
      "method": "GET",
      "path": "/status",
      "input_schema": {
        "type": "object",
        "properties": {}
      },
      "response_error": {
        "type": "json_status",
        "code_path": "response.subscription.active",
        "success_codes": [
          "true"
        ],
        "message_path": "errors"
      }
    },
    {
      "name": "list_seasons",
      "description": "List seasons. Full response includes errors, coverage and provider metadata; check errors before using results.",
      "method": "GET",
      "path": "/seasons",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
