            "type": "integer"
          },
          "season": {
            "type": "integer"
          },
          "team": {
            "type": "integer"
          },
          "h2h": {
            "type": "string"
          },
          "live": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        },
        "anyOf": [
          {
            "required": [
              "id"
            ]
          },
          {
            "required": [
              "date"
            ]
          },
          {
            "required": [
