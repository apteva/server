    {
      "name": "upload_media",
      "description": "Upload a file to the WordPress media library",
      "method": "POST",
      "path": "/media",
      "input_schema": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "description": "File contents as a blobref:// handle, base64, data URL, or binary envelope"
          },
          "filename": {
            "type": "string",
            "description": "File name with extension (e.g. photo.jpg); WordPress uses it to detect the media type"
          },
          "title": {
            "type": "string",
            "description": "Media title"
          },
          "alt_text": {
            "type": "string",
            "description": "Alt text for images"
          },
          "caption": {
            "type": "string",
            "description": "Media caption"
          },
          "description": {
            "type": "string",
            "description": "Media description"
          },
          "post": {
            "type": "number",
            "description": "ID of the post to attach the media to"
          }
        },
        "required": [
          "file",
          "filename"
        ]
      },
      "multipart_form": {
        "file_fields": {
          "file": "file"
        },
        "field_names": [
          "title",
          "alt_text",
          "caption",
          "description",
          "post"
        ]
      }
    },
