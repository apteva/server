{
  "slug": "wordpress",
  "name": "WordPress",
  "description": "Complete WordPress integration for content management - posts, pages, media, comments, users, categories, and tags",
  "logo": "https://www.google.com/s2/favicons?domain=wordpress.org&sz=128",
  "categories": [
    "cms",
    "blog",
    "wordpress",
    "posts",
    "pages",
    "media",
    "content"
  ],
  "base_url": "{{site_url}}/wp-json/wp/v2",
  "auth": {
    "types": [
      "basic"
    ],
    "headers": {
      "Authorization": "Basic {{basic_auth}}"
    },
    "credential_fields": [
      {
        "name": "site_url",
        "label": "Site_url",
        "description": "Your WordPress site URL (e.g., https://example.com)"
      },
      {
        "name": "username",
        "label": "Username",
        "description": "WordPress username with API access"
      },
      {
        "name": "application_password",
        "label": "Application_password",
        "description": "Application password generated in WordPress admin under Users > Profile > Application Passwords"
      }
    ]
  },
  "tools": [
    {
      "name": "list_posts",
      "description": "List posts from a WordPress site",
      "method": "GET",
      "path": "/posts",
      "input_schema": {
        "type": "object",
        "properties": {
          "per_page": {
            "type": "number",
            "description": "Posts per page (default: 10)"
          },
          "page": {
            "type": "number",
            "description": "Page number (default: 1)"
          },
          "status": {
            "type": "string",
            "description": "Post status: publish, draft, pending, private"
          },
          "search": {
            "type": "string",
            "description": "Search term"
          },
          "categories": {
            "type": "string",
            "description": "Filter by category IDs (comma-separated)"
          },
          "tags": {
            "type": "string",
            "description": "Filter by tag IDs (comma-separated)"
          }
        }
      }
    },
    {
      "name": "get_post",
      "description": "Get a single post by ID",
      "method": "GET",
      "path": "/posts/{post_id}",
      "input_schema": {
        "type": "object",
        "properties": {
          "post_id": {
            "type": "number",
            "description": "Post ID"
          }
        },
        "required": [
          "post_id"
        ]
      }
    },
    {
      "name": "create_post",
      "description": "Create a new post",
      "method": "POST",
      "path": "/posts",
      "input_schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Post title"
          },
          "content": {
            "type": "string",
            "description": "Post content (HTML)"
          },
          "status": {
            "type": "string",
            "description": "Post status: publish, draft, pending, private (default: draft)"
          },
          "excerpt": {
            "type": "string",
            "description": "Post excerpt"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "Category IDs"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "Tag IDs"
          },
          "featured_media": {
            "type": "number",
            "description": "Featured image media ID"
          },
          "slug": {
            "type": "string",
            "description": "Post slug/permalink"
          }
        },
        "required": [
          "title",
          "content"
        ]
      }
    },
    {
      "name": "update_post",
      "description": "Update an existing post",
      "method": "POST",
      "path": "/posts/{post_id}",
      "input_schema": {
        "type": "object",
        "properties": {
          "post_id": {
            "type": "number",
            "description": "Post ID"
          },
          "title": {
            "type": "string",
            "description": "New title"
          },
          "content": {
            "type": "string",
            "description": "New content"
          },
          "status": {
            "type": "string",
            "description": "New status"
          },
          "excerpt": {
            "type": "string",
            "description": "New excerpt"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "New category IDs"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "New tag IDs"
          },
          "featured_media": {
            "type": "number",
            "description": "New featured image media ID"
          },
          "slug": {
            "type": "string",
            "description": "New slug"
          }
        },
        "required": [
          "post_id"
        ]
      }
    },
    {
      "name": "delete_post",
      "description": "Delete a post",
      "method": "DELETE",
      "path": "/posts/{post_id}",
      "input_schema": {
        "type": "object",
        "properties": {
          "post_id": {
            "type": "number",
            "description": "Post ID to delete"
          },
          "force": {
            "type": "boolean",
            "description": "Bypass trash and permanently delete (default: false)"
          }
        },
        "required": [
          "post_id"
        ]
      }
    },
