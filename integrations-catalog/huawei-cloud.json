{
  "slug": "huawei-cloud",
  "name": "Huawei Cloud (ECS)",
  "description": "MCP server for Huawei Cloud Elastic Cloud Server - cloud servers, flavors, images, key pairs, snapshots, volumes (covers China, AP, EMEA, LATAM regions)",
  "logo": "https://www.google.com/s2/favicons?domain=huaweicloud.com&sz=128",
  "categories": ["cloud", "servers", "vps", "infrastructure", "china", "asia"],
  "base_url": "https://ecs.{{credential.region}}.myhuaweicloud.com",
  "auth": {
    "types": ["api_key"],
    "headers": { "X-Auth-Token": "{{token}}" },
    "credential_fields": [
      { "name": "token", "label": "X-Auth-Token", "description": "Issue via POST https://iam.{region}.myhuaweicloud.com/v3/auth/tokens (returns token in X-Subject-Token header). Tokens last 24h." },
      { "name": "project_id", "label": "Project ID", "description": "Your Huawei Cloud project ID" },
      { "name": "region", "label": "Region", "description": "e.g. ap-southeast-3 (Singapore), cn-east-3, sa-brazil-1" }
    ]
  },
  "tools": [
    {
      "name": "list_servers",
      "description": "List ECS cloud servers (detail)",
      "method": "GET",
      "path": "/v1/{{credential.project_id}}/cloudservers/detail",
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": { "type": "number" },
          "offset": { "type": "number" },
          "name": { "type": "string" },
          "status": { "type": "string" }
        },
        "required": []
      }
    },
    {
      "name": "get_server",
      "description": "Get an ECS server by ID",
      "method": "GET",
      "path": "/v1/{{credential.project_id}}/cloudservers/{server_id}",
      "input_schema": {
        "type": "object",
        "properties": {
          "server_id": { "type": "string" }
        },
        "required": ["server_id"]
      }
    },
    {
      "name": "create_server",
      "description": "Create a pay-per-use ECS server",
      "method": "POST",
      "path": "/v1/{{credential.project_id}}/cloudservers",
      "input_schema": {
        "type": "object",
        "properties": {
          "server": { "type": "object", "description": "Body wraps under 'server': { name, imageRef, flavorRef, vpcid, nics:[{subnet_id}], root_volume:{volumetype}, key_name, count }" }
        },
        "required": ["server"]
      }
    },
    {
      "name": "delete_servers",
      "description": "Delete one or more ECS servers",
      "method": "POST",
      "path": "/v1/{{credential.project_id}}/cloudservers/delete",
      "input_schema": {
        "type": "object",
        "properties": {
          "servers": { "type": "array", "description": "[{ id: 'xxx' }]" },
          "delete_publicip": { "type": "boolean" },
          "delete_volume": { "type": "boolean" }
        },
        "required": ["servers"]
      }
    },
    {
      "name": "batch_start_servers",
      "description": "Batch start ECS servers",
      "method": "POST",
      "path": "/v1/{{credential.project_id}}/cloudservers/action",
      "input_schema": {
        "type": "object",
        "properties": {
          "os-start": { "type": "object", "description": "{ servers: [{ id }] }" }
        },
        "required": ["os-start"]
      }
    },
    {
      "name": "batch_stop_servers",
      "description": "Batch stop ECS servers",
      "method": "POST",
      "path": "/v1/{{credential.project_id}}/cloudservers/action",
      "input_schema": {
        "type": "object",
        "properties": {
          "os-stop": { "type": "object", "description": "{ type: 'SOFT'|'HARD', servers: [{ id }] }" }
        },
        "required": ["os-stop"]
      }
    },
    {
      "name": "batch_reboot_servers",
      "description": "Batch reboot ECS servers",
      "method": "POST",
      "path": "/v1/{{credential.project_id}}/cloudservers/action",
      "input_schema": {
        "type": "object",
        "properties": {
          "reboot": { "type": "object", "description": "{ type: 'SOFT'|'HARD', servers: [{ id }] }" }
        },
        "required": ["reboot"]
      }
    },
    {
      "name": "list_flavors",
      "description": "List available ECS flavors (sizes)",
      "method": "GET",
      "path": "/v1/{{credential.project_id}}/cloudservers/flavors",
      "input_schema": {
        "type": "object",
        "properties": {
          "availability_zone": { "type": "string" }
        },
        "required": []
      }
    },
    {
      "name": "list_images",
      "description": "List images via IMS (Image Management Service)",
      "method": "GET",
      "base_url": "https://ims.{{credential.region}}.myhuaweicloud.com",
      "path": "/v2/cloudimages",
      "input_schema": {
        "type": "object",
        "properties": {
          "imagetype": { "type": "string" },
          "__os_type": { "type": "string" },
          "limit": { "type": "number" }
        }
      }
    },
    {
      "name": "list_key_pairs",
      "description": "List SSH key pairs",
      "method": "GET",
      "path": "/v2.1/{{credential.project_id}}/os-keypairs",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "name": "create_snapshot",
      "description": "Create a volume snapshot via EVS",
      "method": "POST",
      "base_url": "https://evs.{{credential.region}}.myhuaweicloud.com",
      "path": "/v2/{{credential.project_id}}/cloudsnapshots",
      "input_schema": {
        "type": "object",
        "properties": {
          "snapshot": { "type": "object", "description": "{ volume_id, name, description, force }" }
        },
        "required": ["snapshot"]
      }
    },
    {
      "name": "list_volumes",
      "description": "List block storage volumes",
      "method": "GET",
      "base_url": "https://evs.{{credential.region}}.myhuaweicloud.com",
      "path": "/v2/{{credential.project_id}}/cloudvolumes/detail",
      "input_schema": {
        "type": "object",
        "properties": {
          "limit": { "type": "number" }
        },
        "required": []
      }
    },
    {
      "name": "get_volume",
      "description": "Get an EVS volume",
      "method": "GET",
      "base_url": "https://evs.{{credential.region}}.myhuaweicloud.com",
      "path": "/v2/{{credential.project_id}}/cloudvolumes/{volume_id}",
      "input_schema": { "type": "object", "properties": { "volume_id": { "type": "string" } }, "required": ["volume_id"] }
    },
    {
      "name": "create_volume",
      "description": "Create an EVS data volume; body is wrapped in volume",
      "method": "POST",
      "base_url": "https://evs.{{credential.region}}.myhuaweicloud.com",
      "path": "/v2/{{credential.project_id}}/cloudvolumes",
      "input_schema": { "type": "object", "properties": { "volume": { "type": "object", "description": "{availability_zone,size,volume_type,name,description,multiattach,metadata,tags}" } }, "required": ["volume"] }
    },
    {
      "name": "update_volume",
      "description": "Update the name, description, or metadata of an EVS volume",
      "method": "PUT",
      "base_url": "https://evs.{{credential.region}}.myhuaweicloud.com",
      "path": "/v2/{{credential.project_id}}/cloudvolumes/{volume_id}",
      "input_schema": { "type": "object", "properties": { "volume_id": { "type": "string" }, "volume": { "type": "object" } }, "required": ["volume_id", "volume"] }
    },
    {
      "name": "resize_volume",
      "description": "Extend an EVS volume; shrinking is not supported",
      "method": "POST",
      "base_url": "https://evs.{{credential.region}}.myhuaweicloud.com",
      "path": "/v2/{{credential.project_id}}/cloudvolumes/{volume_id}/action",
      "input_schema": { "type": "object", "properties": { "volume_id": { "type": "string" }, "os-extend": { "type": "object", "description": "{new_size: integer GiB}" } }, "required": ["volume_id", "os-extend"] }
    },
    {
      "name": "delete_volume",
      "description": "Delete an unattached EVS volume",
      "method": "DELETE",
      "base_url": "https://evs.{{credential.region}}.myhuaweicloud.com",
      "path": "/v2/{{credential.project_id}}/cloudvolumes/{volume_id}",
      "input_schema": { "type": "object", "properties": { "volume_id": { "type": "string" }, "cascade": { "type": "boolean" } }, "required": ["volume_id"] }
    },
    {
      "name": "attach_volume",
      "description": "Attach an EVS volume to an ECS server",
      "method": "POST",
      "path": "/v2.1/{{credential.project_id}}/servers/{server_id}/os-volume_attachments",
      "input_schema": { "type": "object", "properties": { "server_id": { "type": "string" }, "volumeAttachment": { "type": "object", "description": "{volumeId,device?}" } }, "required": ["server_id", "volumeAttachment"] }
    },
    {
      "name": "detach_volume",
      "description": "Detach an EVS volume from an ECS server without deleting it",
      "method": "DELETE",
      "path": "/v2.1/{{credential.project_id}}/servers/{server_id}/os-volume_attachments/{attachment_id}",
      "input_schema": { "type": "object", "properties": { "server_id": { "type": "string" }, "attachment_id": { "type": "string", "description": "Usually the volume UUID" } }, "required": ["server_id", "attachment_id"] }
    },
    {
      "name": "list_availability_zones",
      "description": "List availability zones for the configured project",
      "method": "GET",
      "path": "/v1/{{credential.project_id}}/availability-zones",
      "input_schema": { "type": "object", "properties": {} }
    },
    {
      "name": "list_vpcs",
      "description": "List VPCs for the configured project",
      "method": "GET",
      "base_url": "https://vpc.{{credential.region}}.myhuaweicloud.com",
      "path": "/v1/{{credential.project_id}}/vpcs",
      "input_schema": {
        "type": "object",
        "properties": { "limit": { "type": "number" } }
      }
    },
    {
      "name": "list_subnets",
      "description": "List subnets for the configured project",
      "method": "GET",
      "base_url": "https://vpc.{{credential.region}}.myhuaweicloud.com",
      "path": "/v1/{{credential.project_id}}/subnets",
      "input_schema": {
        "type": "object",
        "properties": {
          "vpc_id": { "type": "string" },
          "limit": { "type": "number" }
        }
      }
    },
    {
      "name": "get_job",
      "description": "Get an asynchronous ECS job",
      "method": "GET",
      "path": "/v1/{{credential.project_id}}/jobs/{job_id}",
      "input_schema": {
        "type": "object",
        "properties": { "job_id": { "type": "string" } },
        "required": ["job_id"]
      }
    }
  ]
}
