{
  "slug": "dropbox-sign",
  "name": "Dropbox Sign",
  "description": "Dropbox Sign API for signature requests, public file-URL sending, embedded signing, templates, reminders, downloads, and bulk-send status. Uses one API key as the Basic-auth username; webhook callbacks are configured in Dropbox Sign account or API app settings.",
  "logo": "https://www.google.com/s2/favicons?domain=sign.dropbox.com&sz=128",
  "categories": ["e-signature", "documents", "contracts", "legal"],
  "base_url": "https://api.hellosign.com/v3",
  "auth": {
    "types": ["api_key"],
    "headers": {"Authorization": "Basic {{basic_auth}}", "Accept": "application/json", "Content-Type": "application/json"},
    "credential_fields": [{"name": "api_key", "label": "Dropbox Sign API Key", "type": "password", "required": true, "description": "The API key from Dropbox Sign Settings > API. It is used as the Basic-auth username with an empty password."}]
  },
  "health_check": {"tool": "get_account"},
  "tools": [
    {"name": "get_account", "description": "Validate the API key and return the Dropbox Sign account.", "method": "GET", "path": "/account", "input_schema": {"type": "object", "properties": {}}},
    {"name": "list_signature_requests", "description": "List signature requests accessible to the account.", "method": "GET", "path": "/signature_request/list", "input_schema": {"type": "object", "properties": {"page": {"type": "integer"}, "page_size": {"type": "integer"}, "account_id": {"type": "string"}, "query": {"type": "string"}}}},
    {"name": "get_signature_request", "description": "Get a signature request, its signatures, status, metadata, and file references.", "method": "GET", "path": "/signature_request/{signature_request_id}", "input_schema": {"type": "object", "properties": {"signature_request_id": {"type": "string"}}, "required": ["signature_request_id"]}},
    {
      "name": "send_signature_request", "description": "Create and send a signature request from public HTTPS file_urls using Dropbox Sign's documented JSON request contract.", "method": "POST", "path": "/signature_request/send",
      "input_schema": {"type": "object", "properties": {"title": {"type": "string"}, "subject": {"type": "string"}, "message": {"type": "string"}, "file_urls": {"type": "array", "items": {"type": "string"}, "description": "Public HTTPS document URLs."}, "signers": {"type": "array", "items": {"type": "object"}, "description": "Objects with email_address, name, and optional order."}, "cc_email_addresses": {"type": "array", "items": {"type": "string"}}, "custom_fields": {"type": "array", "items": {"type": "object"}}, "form_fields_per_document": {"type": "array", "items": {"type": "object"}}, "metadata": {"type": "object"}, "signing_options": {"type": "object"}, "signing_redirect_url": {"type": "string"}, "allow_decline": {"type": "boolean"}, "allow_reassign": {"type": "boolean"}, "test_mode": {"type": "boolean"}, "expires_at": {"type": "integer"}}, "required": ["title", "file_urls", "signers"]}
    },
    {
      "name": "send_with_template", "description": "Create and send a signature request from one or more Dropbox Sign templates.", "method": "POST", "path": "/signature_request/send_with_template",
      "input_schema": {"type": "object", "properties": {"template_ids": {"type": "array", "items": {"type": "string"}}, "signers": {"type": "array", "items": {"type": "object"}, "description": "Objects with role, email_address, and name."}, "ccs": {"type": "array", "items": {"type": "object"}}, "title": {"type": "string"}, "subject": {"type": "string"}, "message": {"type": "string"}, "custom_fields": {"type": "array", "items": {"type": "object"}}, "file_urls": {"type": "array", "items": {"type": "string"}}, "metadata": {"type": "object"}, "signing_options": {"type": "object"}, "signing_redirect_url": {"type": "string"}, "allow_decline": {"type": "boolean"}, "test_mode": {"type": "boolean"}}, "required": ["template_ids", "signers"]}
    },
    {
      "name": "create_embedded_signature_request", "description": "Create an unclaimed embedded signature request from public file URLs. Include the API app client_id, then call get_embedded_sign_url with a returned signature_id.", "method": "POST", "path": "/signature_request/create_embedded",
      "input_schema": {"type": "object", "properties": {"client_id": {"type": "string"}, "title": {"type": "string"}, "subject": {"type": "string"}, "message": {"type": "string"}, "file_urls": {"type": "array", "items": {"type": "string"}}, "signers": {"type": "array", "items": {"type": "object"}}, "cc_email_addresses": {"type": "array", "items": {"type": "string"}}, "form_fields_per_document": {"type": "array", "items": {"type": "object"}}, "custom_fields": {"type": "array", "items": {"type": "object"}}, "metadata": {"type": "object"}, "test_mode": {"type": "boolean"}}, "required": ["client_id", "title", "file_urls", "signers"]}
    },
    {
      "name": "create_embedded_with_template", "description": "Create an embedded signature request from templates, then obtain each signer URL with get_embedded_sign_url.", "method": "POST", "path": "/signature_request/create_embedded_with_template",
      "input_schema": {"type": "object", "properties": {"client_id": {"type": "string"}, "template_ids": {"type": "array", "items": {"type": "string"}}, "signers": {"type": "array", "items": {"type": "object"}}, "ccs": {"type": "array", "items": {"type": "object"}}, "title": {"type": "string"}, "subject": {"type": "string"}, "message": {"type": "string"}, "custom_fields": {"type": "array", "items": {"type": "object"}}, "metadata": {"type": "object"}, "test_mode": {"type": "boolean"}}, "required": ["client_id", "template_ids", "signers"]}
    },
    {"name": "get_embedded_sign_url", "description": "Get a short-lived embedded signing URL for a signature_id returned inside a signature request.", "method": "GET", "path": "/embedded/sign_url/{signature_id}", "input_schema": {"type": "object", "properties": {"signature_id": {"type": "string"}}, "required": ["signature_id"]}},
    {"name": "remind_signature_request", "description": "Send a reminder to one pending signer.", "method": "POST", "path": "/signature_request/remind/{signature_request_id}", "input_schema": {"type": "object", "properties": {"signature_request_id": {"type": "string"}, "email_address": {"type": "string"}, "name": {"type": "string"}}, "required": ["signature_request_id", "email_address"]}},
    {"name": "update_signature_request", "description": "Correct a pending signer's name, email, or request expiry. signature_id identifies the signer entry to update.", "method": "POST", "path": "/signature_request/update/{signature_request_id}", "input_schema": {"type": "object", "properties": {"signature_request_id": {"type": "string"}, "signature_id": {"type": "string"}, "email_address": {"type": "string"}, "name": {"type": "string"}, "expires_at": {"type": "integer"}}, "required": ["signature_request_id", "signature_id"]}},
    {"name": "cancel_signature_request", "description": "Cancel an incomplete signature request so it can no longer be signed.", "method": "POST", "path": "/signature_request/cancel/{signature_request_id}", "input_schema": {"type": "object", "properties": {"signature_request_id": {"type": "string"}}, "required": ["signature_request_id"]}},
    {"name": "remove_signature_request", "description": "Remove a completed signature request from Dropbox Sign. This is destructive and irreversible.", "method": "POST", "path": "/signature_request/remove/{signature_request_id}", "input_schema": {"type": "object", "properties": {"signature_request_id": {"type": "string"}}, "required": ["signature_request_id"]}},
    {"name": "download_signature_request_files", "description": "Download completed files as PDF or ZIP binary.", "method": "GET", "path": "/signature_request/files/{signature_request_id}", "input_schema": {"type": "object", "properties": {"signature_request_id": {"type": "string"}, "file_type": {"type": "string", "enum": ["pdf", "zip"]}}, "required": ["signature_request_id"]}},
    {"name": "get_signature_request_file_url", "description": "Get a temporary URL for completed signature-request files.", "method": "GET", "path": "/signature_request/files_as_file_url/{signature_request_id}", "input_schema": {"type": "object", "properties": {"signature_request_id": {"type": "string"}, "file_type": {"type": "string", "enum": ["pdf", "zip"]}, "force_download": {"type": "boolean"}}, "required": ["signature_request_id"]}},
    {"name": "list_templates", "description": "List templates available to the account.", "method": "GET", "path": "/template/list", "input_schema": {"type": "object", "properties": {"page": {"type": "integer"}, "page_size": {"type": "integer"}, "account_id": {"type": "string"}, "query": {"type": "string"}}}},
    {"name": "get_template", "description": "Get template roles, fields, and metadata.", "method": "GET", "path": "/template/{template_id}", "input_schema": {"type": "object", "properties": {"template_id": {"type": "string"}}, "required": ["template_id"]}},
    {
      "name": "create_template", "description": "Create a reusable template from public HTTPS file URLs.", "method": "POST", "path": "/template/create",
      "input_schema": {"type": "object", "properties": {"title": {"type": "string"}, "file_urls": {"type": "array", "items": {"type": "string"}}, "signer_roles": {"type": "array", "items": {"type": "object"}}, "cc_roles": {"type": "array", "items": {"type": "string"}}, "form_fields_per_document": {"type": "array", "items": {"type": "object"}}, "message": {"type": "string"}, "metadata": {"type": "object"}, "test_mode": {"type": "boolean"}}, "required": ["title", "file_urls", "signer_roles"]}
    },
    {"name": "delete_template", "description": "Delete a Dropbox Sign template.", "method": "POST", "path": "/template/delete/{template_id}", "input_schema": {"type": "object", "properties": {"template_id": {"type": "string"}}, "required": ["template_id"]}},
    {"name": "download_template_files", "description": "Download template files as PDF or ZIP binary.", "method": "GET", "path": "/template/files/{template_id}", "input_schema": {"type": "object", "properties": {"template_id": {"type": "string"}, "file_type": {"type": "string", "enum": ["pdf", "zip"]}}, "required": ["template_id"]}},
    {"name": "get_template_file_url", "description": "Get a temporary URL for template files.", "method": "GET", "path": "/template/files_as_file_url/{template_id}", "input_schema": {"type": "object", "properties": {"template_id": {"type": "string"}, "file_type": {"type": "string", "enum": ["pdf", "zip"]}, "force_download": {"type": "boolean"}}, "required": ["template_id"]}},
    {"name": "list_bulk_send_jobs", "description": "List bulk-send jobs.", "method": "GET", "path": "/bulk_send_job/list", "input_schema": {"type": "object", "properties": {"page": {"type": "integer"}, "page_size": {"type": "integer"}}}},
    {"name": "get_bulk_send_job", "description": "Get the status and generated requests for one bulk-send job.", "method": "GET", "path": "/bulk_send_job/{bulk_send_job_id}", "input_schema": {"type": "object", "properties": {"bulk_send_job_id": {"type": "string"}}, "required": ["bulk_send_job_id"]}}
  ]
}
