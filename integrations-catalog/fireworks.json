{
  "slug": "fireworks",
  "name": "Fireworks",
  "description": "OpenAI-compatible inference for open models (Kimi, Llama, Qwen, DeepSeek) hosted on Fireworks AI. Bearer-token auth; serves both as an agent runtime backend and as a callable chat/completions integration.",
  "logo": "https://www.google.com/s2/favicons?domain=fireworks.ai&sz=128",
  "categories": [
    "ai",
    "llm",
    "fireworks",
    "chat",
    "inference"
  ],
  "base_url": "https://api.fireworks.ai/inference/v1",
  "auth": {
    "types": [
      "bearer"
    ],
    "headers": {
      "Authorization": "Bearer {{token}}"
    },
    "credential_fields": [
      {
        "name": "token",
        "label": "API Key",
        "description": "Your Fireworks API key — create one at https://fireworks.ai/account/api-keys"
      }
    ]
  },
  "tools": [
    {
      "name": "chat_completion",
      "description": "Create a chat completion via POST /chat/completions. OpenAI-compatible request and response shape.",
      "method": "POST",
      "path": "/chat/completions",
      "timeout_ms": 300000,
      "input_schema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "description": "Model ID, e.g. accounts/fireworks/models/kimi-k3. Call list_models for the live set."
          },
          "messages": {
            "type": "array",
            "description": "Conversation so far, as OpenAI-style {role, content} objects.",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "description": "One of system, user, assistant, tool."
                },
                "content": {
                  "type": "string",
                  "description": "Message text."
                }
              },
              "required": [
                "role",
                "content"
              ]
            }
          },
          "max_tokens": {
            "type": "integer",
            "description": "Maximum tokens to generate."
          },
          "temperature": {
            "type": "number",
            "description": "Sampling temperature, 0–2."
          }
        },
        "required": [
          "model",
          "messages"
        ]
      }
    },
    {
      "name": "list_models",
      "description": "List models available to this account via GET /models.",
      "method": "GET",
      "path": "/models",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    }
  ],
  "health_check": {
    "tool": "list_models"
  },
  "runtime": {
    "role": "llm",
    "provider_key": "fireworks",
    "env": {
      "FIREWORKS_API_KEY": "{{credentials.token}}"
    },
    "model_policy": {
      "purpose": "agent",
      "required_methods": [
        "chat_completion"
      ],
      "allowed_id_patterns": [
        "^accounts/fireworks/models/deepseek-v4(?:p[0-9]+-flash|-flash-[0-9]+|-pro(?:-[0-9]+)?)$",
        "^accounts/fireworks/models/glm-5p[0-9]+(?:-flash)?$",
        "^accounts/fireworks/routers/glm-5p[0-9]+-fast$",
        "^accounts/fireworks/models/gpt-oss-(?:20b|120b)$",
        "^accounts/fireworks/models/kimi-k3$",
        "^accounts/fireworks/routers/kimi-k3-fast$",
        "^accounts/fireworks/models/kimi-k2p[0-9]+(?:-code)?$",
        "^accounts/fireworks/routers/kimi-k2p[0-9]+-turbo$",
        "^accounts/fireworks/models/minimax-m(?:2p[0-9]+|3)$",
        "^accounts/fireworks/models/nemotron-(?:3-ultra-nvfp4|lightning-3p[0-9]+-[0-9]+b-a[0-9]+b)$",
        "^accounts/fireworks/models/qwen3p[0-9]+-(?:plus|max|[0-9]+p[0-9]+t-a[0-9]+b)$"
      ],
      "tier_preferences": {
        "large": [
          "^accounts/fireworks/models/kimi-k3$",
          "^accounts/fireworks/models/glm-5p[0-9]+$",
          "^accounts/fireworks/models/deepseek-v4-pro(?:-[0-9]+)?$",
          "^accounts/fireworks/models/qwen3p[0-9]+-max$",
          "^accounts/fireworks/models/qwen3p[0-9]+-[0-9]+p[0-9]+t-a[0-9]+b$",
          "^accounts/fireworks/models/minimax-m3$",
          "^accounts/fireworks/models/nemotron-3-ultra-nvfp4$",
          "^accounts/fireworks/models/gpt-oss-120b$",
          "^accounts/fireworks/models/kimi-k2p[0-9]+(?:-code)?$",
          "^accounts/fireworks/models/deepseek-v4(?:p[0-9]+-flash|-flash-[0-9]+)$",
          "^accounts/fireworks/models/qwen3p[0-9]+-plus$",
          "^accounts/fireworks/models/glm-5p[0-9]+-flash$",
          "^accounts/fireworks/models/minimax-m2p[0-9]+$",
          "^accounts/fireworks/models/nemotron-lightning-3p[0-9]+-[0-9]+b-a[0-9]+b$",
          "^accounts/fireworks/routers/kimi-k3-fast$",
          "^accounts/fireworks/routers/glm-5p[0-9]+-fast$",
          "^accounts/fireworks/routers/kimi-k2p[0-9]+-turbo$",
          "^accounts/fireworks/models/gpt-oss-20b$"
        ],
        "medium": [
          "^accounts/fireworks/routers/kimi-k3-fast$",
          "^accounts/fireworks/routers/glm-5p[0-9]+-fast$",
          "^accounts/fireworks/models/glm-5p[0-9]+-flash$",
          "^accounts/fireworks/models/deepseek-v4(?:p[0-9]+-flash|-flash-[0-9]+)$",
          "^accounts/fireworks/models/qwen3p[0-9]+-plus$",
          "^accounts/fireworks/models/minimax-m2p[0-9]+$",
          "^accounts/fireworks/models/kimi-k2p[0-9]+(?:-code)?$",
          "^accounts/fireworks/models/gpt-oss-(?:20b|120b)$",
          "^accounts/fireworks/models/nemotron-lightning-3p[0-9]+-[0-9]+b-a[0-9]+b$",
          "^accounts/fireworks/routers/kimi-k2p[0-9]+-turbo$",
          "^accounts/fireworks/models/kimi-k3$",
          "^accounts/fireworks/models/glm-5p[0-9]+$"
        ],
        "small": [
          "^accounts/fireworks/routers/glm-5p[0-9]+-fast$",
          "^accounts/fireworks/models/glm-5p[0-9]+-flash$",
          "^accounts/fireworks/models/deepseek-v4(?:p[0-9]+-flash|-flash-[0-9]+)$",
          "^accounts/fireworks/models/nemotron-lightning-3p[0-9]+-[0-9]+b-a[0-9]+b$",
          "^accounts/fireworks/models/minimax-m2p[0-9]+$",
          "^accounts/fireworks/routers/kimi-k3-fast$",
          "^accounts/fireworks/models/gpt-oss-20b$"
        ]
      }
    }
  }
}
