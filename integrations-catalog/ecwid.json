{
  "slug": "ecwid",
  "name": "Ecwid by Lightspeed",
  "description": "Ecwid REST API for hosted physical and digital commerce: Instant Site products, downloadable files, variants, media, inventory, categories, orders, customers, promotions, and coupons.",
  "logo": "https://www.google.com/s2/favicons?domain=ecwid.com&sz=128",
  "categories": [
    "ecommerce",
    "storefront",
    "instant-site",
    "digital-products",
    "products",
    "orders",
    "retail"
  ],
  "base_url": "https://app.ecwid.com/api/v3/{{credential.store_id}}",
  "auth": {
    "types": [
      "bearer"
    ],
    "headers": {
      "Authorization": "Bearer {{token}}"
    },
    "credential_fields": [
      {
        "name": "store_id",
        "label": "Store ID",
        "description": "Numeric Ecwid store ID.",
        "required": true
      },
      {
        "name": "token",
        "label": "Secret Access Token",
        "type": "password",
        "description": "Ecwid app access token with the catalog/order scopes needed by the tools you use.",
        "required": true
      }
    ]
  },
  "tools": [
    {
      "name": "get_store_profile",
      "description": "Get the store profile, currencies, enabled languages, storefront URLs, and account settings.",
      "method": "GET",
      "path": "/profile",
      "input_schema": {
        "type": "object",
        "properties": {
          "responseFields": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "update_store_profile",
      "description": "Update editable store-profile and Instant Site settings.",
      "method": "PUT",
      "path": "/profile",
      "input_schema": {
        "type": "object",
        "properties": {
          "companyName": {
            "type": "string"
          },
          "companyEmail": {
            "type": "string"
          },
          "storeUrl": {
            "type": "string"
          },
          "orderCommentsEnabled": {
            "type": "boolean"
          },
          "askCompanyName": {
            "type": "boolean"
          },
          "settings": {
            "type": "object"
          }
        }
      }
    },
    {
      "name": "get_latest_stats",
      "description": "Get current store statistics.",
      "method": "GET",
      "path": "/latest-stats",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "search_products",
      "description": "Search products and return their Ecwid or Instant Site product URLs.",
      "method": "GET",
      "path": "/products",
      "input_schema": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum number of results."
          },
          "responseFields": {
            "type": "string",
            "description": "Comma-separated response fields to retain."
          },
          "keyword": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "category": {
            "type": "integer"
          },
          "enabled": {
            "type": "boolean"
          },
          "inStock": {
            "type": "boolean"
          },
          "sortBy": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "get_product",
      "description": "Get one product, including its hosted product URL, media, variants, and digital-file metadata.",
      "method": "GET",
      "path": "/products/{productId}",
      "input_schema": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "integer"
          },
          "responseFields": {
            "type": "string"
          }
        },
        "required": [
          "productId"
        ]
      }
    },
    {
      "name": "create_product",
      "description": "Create a physical or digital product. For digital-only products set isShippingRequired=false, then attach files with upload_product_file.",
      "method": "POST",
      "path": "/products",
      "input_schema": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": "Merchant SKU."
          },
          "quantity": {
            "type": "integer",
            "description": "Stock quantity."
          },
          "unlimited": {
            "type": "boolean",
            "description": "Disable stock limits when true."
          },
          "name": {
            "type": "string",
            "description": "Product name."
          },
          "price": {
            "type": "number",
            "description": "Product price in the store currency."
          },
          "compareToPrice": {
            "type": "number",
            "description": "Original price shown for a sale."
          },
          "costPrice": {
            "type": "number",
            "description": "Internal product cost."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the product is visible for sale."
          },
          "description": {
            "type": "string",
            "description": "HTML product description."
          },
          "categoryIds": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Category IDs assigned to the product."
          },
          "isShippingRequired": {
            "type": "boolean",
            "description": "False for a purely digital product."
          },
          "weight": {
            "type": "number"
          },
          "dimensions": {
            "type": "object"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "attributes": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "relatedProducts": {
            "type": "object"
          },
          "seoTitle": {
            "type": "string"
          },
          "seoDescription": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "price"
        ]
      }
    },
    {
      "name": "update_product",
