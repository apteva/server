            "type": "number",
            "description": "Original price shown for a sale."
          },
          "costPrice": {
            "type": "number",
            "description": "Internal product cost."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the product is visible for sale."
          },
          "description": {
            "type": "string",
            "description": "HTML product description."
          },
          "categoryIds": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Category IDs assigned to the product."
          },
          "isShippingRequired": {
            "type": "boolean",
