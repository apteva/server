{
  "slug": "openmeteo-weather",
  "name": "OpenMeteo",
  "description": "Free weather data service using OpenMeteo API - no authentication required",
  "logo": "https://www.google.com/s2/favicons?domain=open-meteo.com&sz=128",
  "categories": [
    "weather",
    "forecast",
    "free",
    "openmeteo",
    "no-auth"
  ],
  "base_url": "https://api.open-meteo.com/v1",
  "auth": {
    "types": [
      "none"
    ],
    "headers": {},
    "credential_fields": []
  },
  "tools": [
    {
      "name": "get_current_weather",
      "description": "Get current weather data using free OpenMeteo API - no API key required",
      "method": "GET",
      "path": "/forecast?current=temperature_2m,relative_humidity_2m,wind_speed_10m,pressure_msl",
      "input_schema": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "description": "Latitude coordinate",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "description": "Longitude coordinate",
            "minimum": -180,
            "maximum": 180
          },
          "variables": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional current weather variables to retrieve. Temperature, relative humidity, wind speed, and sea-level pressure are always included.",
            "default": [
              "temperature_2m",
              "relative_humidity_2m",
              "wind_speed_10m",
              "pressure_msl"
            ]
          },
          "timezone": {
            "type": "string",
            "description": "Timezone for the forecast",
            "default": "auto"
          }
        },
        "required": [
          "latitude",
          "longitude"
        ]
      },
      "query_param_aliases": {
        "variables": "current"
      }
    }
  ]
}
