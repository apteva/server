    {
      "name": "get_results",
      "description": "Search historical results. Requires Standard or Pro; use dates and pagination.",
      "method": "GET",
      "path": "/v1/results",
      "input_schema": {
        "type": "object",
        "properties": {
          "start_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Query from date with format YYYY-MM-DD, e.g. 2020-01-01Default: 365 days ago. Limited to up to 365 days in the past; pro plan users can purchase the historical results add-on to remove this limitation and query back to 2005-01-01.",
            "title": "Start Date"
          },
          "end_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Query to date with format YYYY-MM-DD, e.g. 2020-01-01Default: Today's date. Maximum range between start and end date is 365 days.",
            "title": "End Date"
          },
          "region": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "Query by region codes. Get the full list here.Note: If the course query parameter is specified, this will be ignored.",
            "title": "Region"
          },
          "course": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "Query by course ids. Get the full list here.",
            "title": "Course"
          },
          "type": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "Query by race typeOptions: chase, flat, hurdle, nh_flat",
            "title": "Type"
          },
          "going": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "Query by goingOptions: fast, firm, good, good_to_firm, good_to_soft, good_to_yielding, hard, heavy, holding, muddy, sloppy, slow, soft, soft_to_heavy, standard, standard_to_fast, standard_to_slow, very_soft, yielding, yielding_to_soft",
            "title": "Going"
          },
          "race_class": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "Query by classOptions: class_1, class_2, class_3, class_4, class_5, class_6, class_7",
            "title": "Race Class"
          },
          "min_distance_y": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Query by minimum race distance (yards)",
            "title": "Min Distance Y"
          },
          "max_distance_y": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Query by maximum race distance (yards)",
            "title": "Max Distance Y"
          },
          "age_band": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "Query by age bandOptions: 10yo+, 2-3yo, 2yo, 2yo+, 3-4yo, 3-5yo, 3-6yo, 3yo, 3yo+, 4-5yo, 4-6yo, 4-7yo, 4-8yo, 4yo, 4yo+, 5-6yo, 5-7yo, 5-8yo, 5yo, 5yo+, 6-7yo, 6yo, 6yo+, 7yo+, 8yo+, 9yo+",
            "title": "Age Band"
          },
          "sex_restriction": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "Query by sex restrictionOptions: c&f, c&g, f, f&m, m, m&g",
            "title": "Sex Restriction"
          },
          "limit": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100,
                "minimum": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Limit",
            "default": 50
          },
          "skip": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 20000
              },
              {
                "type": "null"
              }
            ],
            "title": "Skip",
            "default": 0
          }
        },
        "additionalProperties": false
      },
