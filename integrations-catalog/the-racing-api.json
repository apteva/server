{
  "slug": "the-racing-api",
  "name": "The Racing API",
  "description": "Horse racing courses, racecards, results and horse/jockey/trainer discovery through the documented HTTP API. HTTP Basic credentials required. Free plan supports regions, courses, free racecards and free today results; deeper endpoints require Basic, Standard or Pro. Coverage depends on product/region. Docs: https://api.theracingapi.com/documentation",
  "logo": "https://www.google.com/s2/favicons?domain=theracingapi.com&sz=128",
  "categories": [
    "sports",
    "horse-racing",
    "racecards",
    "results",
    "stats"
  ],
  "base_url": "https://api.theracingapi.com",
  "auth": {
    "types": [
      "basic"
    ],
    "headers": {
      "Authorization": "Basic {{basic_auth}}"
    },
    "credential_fields": [
      {
        "name": "username",
        "label": "API username",
        "description": "API username issued in The Racing API dashboard.",
        "required": true
      },
      {
        "name": "password",
        "label": "API password",
        "description": "API password issued in The Racing API dashboard.",
        "required": true
      }
    ]
  },
  "tools": [
    {
      "name": "list_regions",
      "description": "List supported regions. Free plan.",
      "method": "GET",
      "path": "/v1/courses/regions",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "rate_limit": {
        "min_interval_ms": 1000,
        "max_retries": 1,
        "retry_statuses": [
          429
        ]
      }
    },
    {
      "name": "list_courses",
      "description": "List courses, optionally filtered by region_codes. Free plan.",
      "method": "GET",
      "path": "/v1/courses",
      "input_schema": {
        "type": "object",
        "properties": {
          "region_codes": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ],
            "title": "Regions",
            "description": "Filter courses by region codes. Get the full list here."
          }
        },
        "additionalProperties": false
      },
      "rate_limit": {
        "min_interval_ms": 1000,
        "max_retries": 1,
        "retry_statuses": [
          429
        ]
      }
    },
    {
      "name": "get_free_racecards",
      "description": "Get free-plan racecards; detail is limited by the free plan.",
      "method": "GET",
      "path": "/v1/racecards/free",
      "input_schema": {
        "type": "object",
        "properties": {
          "day": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Day",
            "description": "Query racecards by day: today, tomorrow",
            "default": "today"
          },
          "region_codes": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ],
            "title": "Regions",
            "description": "Query by region codes. Get the full list here.Note: If the course query parameter is specified, this will be ignored."
          },
          "course_ids": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ],
            "title": "Courses",
            "description": "Query by course ids. Get the full list here."
          },
          "limit": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 500,
                "minimum": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Limit",
            "default": 500
          },
          "skip": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Skip",
            "default": 0
          }
        },
        "additionalProperties": false
      },
      "rate_limit": {
        "min_interval_ms": 1000,
        "max_retries": 1,
        "retry_statuses": [
          429
        ]
      }
    },
    {
      "name": "get_free_today_results",
      "description": "Get free-plan results for today.",
      "method": "GET",
      "path": "/v1/results/today/free",
      "input_schema": {
        "type": "object",
        "properties": {
          "region": {
            "anyOf": [
              {
                "type": "array",
