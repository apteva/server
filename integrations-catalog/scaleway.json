        "type": "object",
        "properties": {
          "page": { "type": "integer" },
          "page_size": { "type": "integer" }
        }
      }
    },
    {
      "name": "server_types_list",
      "description": "List server products available in a Scaleway zone",
      "method": "GET",
      "path": "/instance/v1/zones/{zone}/products/servers",
      "input_schema": {
        "type": "object",
        "properties": {
          "zone": { "type": "string", "default": "fr-par-1" },
          "per_page": { "type": "integer" }
        },
        "required": ["zone"]
      }
    },
    {
      "name": "server_set_cloud_init",
      "description": "Set cloud-init user data before starting a Scaleway server",
      "method": "PUT",
      "path": "/instance/v1/zones/{zone}/servers/{server_id}/user_data/cloud-init",
      "headers": { "Content-Type": "text/plain" },
      "body_root_param": "content",
      "input_schema": {
        "type": "object",
        "properties": {
          "zone": { "type": "string" },
          "server_id": { "type": "string" },
          "content": { "type": "string" }
        },
        "required": ["zone", "server_id", "content"]
      }
    },
    {
      "name": "apple_products_list",
      "description": "List live Scaleway Apple silicon products, locations, lifecycle status, hardware, and prices from the public product catalog",
      "method": "GET",
      "path": "/product-catalog/v2alpha1/public-catalog/products",
