{
  "slug": "zoominfo",
  "name": "ZoomInfo",
  "description": "ZoomInfo enterprise Data-as-a-Service API for contact and company search, enrichment, lookup, and intent. Requires a ZoomInfo contract with API access.",
  "logo": "https://www.google.com/s2/favicons?domain=zoominfo.com&sz=128",
  "categories": ["sales", "leads", "enrichment", "prospecting", "b2b", "intent", "enterprise"],
  "base_url": "https://api.zoominfo.com",
  "auth": {
    "types": ["custom"],
    "token_exchange": {
      "url": "https://api.zoominfo.com/authenticate",
      "method": "POST",
      "content_type": "application/json",
      "body_params": {
        "username": "{{credential.username}}",
        "password": "{{credential.password}}"
      },
      "access_token_path": "jwt",
      "expiry_skew_seconds": 120
    },
    "headers": {
      "Authorization": "Bearer {{access_token}}",
      "Accept": "application/json",
      "Content-Type": "application/json"
    },
    "credential_fields": [
      {
        "name": "username",
        "label": "ZoomInfo API username",
        "description": "Username provisioned for your ZoomInfo API subscription.",
        "required": true,
        "type": "text"
      },
      {
        "name": "password",
        "label": "ZoomInfo API password",
        "description": "Password for the provisioned ZoomInfo API user.",
        "required": true,
        "type": "password"
      }
    ]
  },
  "tools": [
    {
      "name": "search_contacts",
      "description": "Search ZoomInfo contacts by person, role, company, location, and data-availability criteria. Available fields depend on your contracted API edition and entitlements.",
      "method": "POST",
      "path": "/search/contact",
      "input_schema": {
        "type": "object",
        "properties": {
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "fullName": { "type": "string" },
          "jobTitle": { "type": "string" },
          "managementLevel": { "type": "string" },
          "department": { "type": "string" },
          "companyName": { "type": "string" },
          "companyId": { "type": "string" },
          "companyWebsite": { "type": "string" },
          "companyPastOrPresent": { "type": "string", "enum": ["present", "past", "both"] },
          "city": { "type": "string" },
          "state": { "type": "string" },
          "country": { "type": "string" },
          "hasEmail": { "type": "boolean" },
          "hasPhone": { "type": "boolean" },
          "rpp": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 },
          "page": { "type": "integer", "minimum": 1, "default": 1 },
          "outputFields": { "type": "array", "items": { "type": "string" }, "description": "Contract-entitled contact fields to return." }
        }
      }
    },
    {
      "name": "enrich_contact",
      "description": "Enrich one or more contact records from strong identifiers such as email, person ID, or name plus company. This endpoint may consume enrichment credits.",
      "method": "POST",
      "path": "/enrich/contact",
      "input_schema": {
        "type": "object",
        "properties": {
          "matchPersonInput": { "type": "array", "items": { "type": "object" }, "description": "Contact match objects containing personId, emailAddress, or name plus company identifiers." },
          "outputFields": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["matchPersonInput"]
      }
    },
    {
      "name": "search_companies",
      "description": "Search ZoomInfo companies by name, domain, location, industry, size, revenue, technologies, and other entitled firmographics.",
      "method": "POST",
      "path": "/search/company",
      "input_schema": {
        "type": "object",
        "properties": {
          "companyName": { "type": "string" },
          "companyWebsite": { "type": "string" },
          "companyId": { "type": "string" },
          "industryCodes": { "type": "array", "items": { "type": "string" } },
          "employeeRangeMin": { "type": "integer" },
          "employeeRangeMax": { "type": "integer" },
          "revenueMin": { "type": "number" },
          "revenueMax": { "type": "number" },
          "city": { "type": "string" },
          "state": { "type": "string" },
          "country": { "type": "string" },
          "techAttributeTagList": { "type": "array", "items": { "type": "string" } },
          "rpp": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 },
          "page": { "type": "integer", "minimum": 1, "default": 1 },
          "outputFields": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    {
      "name": "enrich_company",
      "description": "Enrich one or more companies from ZoomInfo IDs, domains, or names and locations. This endpoint may consume enrichment credits.",
      "method": "POST",
      "path": "/enrich/company",
      "input_schema": {
        "type": "object",
        "properties": {
          "matchCompanyInput": { "type": "array", "items": { "type": "object" }, "description": "Company match objects containing companyId, companyWebsite, or companyName plus location." },
          "outputFields": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["matchCompanyInput"]
      }
    },
    {
      "name": "list_contact_input_fields",
      "description": "List input fields accepted by the contracted ZoomInfo contact API.",
      "method": "GET",
      "path": "/lookup/inputfields/contact/search",
      "input_schema": { "type": "object", "properties": {} }
    },
    {
      "name": "list_contact_output_fields",
      "description": "List contact output fields available under the current ZoomInfo contract and entitlements.",
      "method": "GET",
      "path": "/lookup/outputfields/contact/search",
      "input_schema": { "type": "object", "properties": {} }
    },
    {
      "name": "list_company_input_fields",
      "description": "List input fields accepted by the contracted ZoomInfo company API.",
      "method": "GET",
      "path": "/lookup/inputfields/company/search",
      "input_schema": { "type": "object", "properties": {} }
    },
    {
      "name": "list_company_output_fields",
      "description": "List company output fields available under the current ZoomInfo contract and entitlements.",
      "method": "GET",
      "path": "/lookup/outputfields/company/search",
      "input_schema": { "type": "object", "properties": {} }
    },
    {
      "name": "search_intent",
      "description": "Search ZoomInfo intent signals for companies researching selected topics during a date window. Requires ZoomInfo Intent API entitlement.",
      "method": "POST",
      "path": "/search/intent",
      "input_schema": {
        "type": "object",
        "properties": {
          "topics": { "type": "array", "items": { "type": "string" } },
          "startDate": { "type": "string", "description": "Start date in YYYY-MM-DD format." },
          "endDate": { "type": "string", "description": "End date in YYYY-MM-DD format." },
          "companyIds": { "type": "array", "items": { "type": "string" } },
          "signalScoreMin": { "type": "integer" },
          "rpp": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 },
          "page": { "type": "integer", "minimum": 1, "default": 1 }
        },
        "required": ["topics"]
      }
    }
  ]
}
